---
/**
 * Home: the hero, then the garage map (one door per page) and the partners.
 */
import Base from '@/layouts/Base.astro';
import Loader from '@/components/chrome/Loader.astro';
import Nav from '@/components/chrome/Nav.astro';
import Footer from '@/components/chrome/Footer.astro';
import EasterEggs from '@/components/chrome/EasterEggs.astro';

import Hero from '@/components/sections/Hero.astro';
import Hub from '@/components/sections/Hub.astro';
import Sponsors from '@/components/sections/Sponsors.astro';
import Ticker from '@/components/chrome/Ticker.astro';
---

<Base>
  <Loader />
  <Nav page="home" />
  <main id="main">
    <Hero />
    <Ticker />
    <Hub />
    <Sponsors />
  </main>
  <Footer />
  <EasterEggs />
</Base>
