  @media (min-width: 64rem) {
    .cal[data-view='grid'] .cal__track {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .cal[data-view='grid'] .rc {
    flex: none;
  }

  /* ---------- Race card ---------- */
  .rc[data-accent='gold'] {
    --accent: var(--c-gold);
  }
  .rc[data-accent='saffron'] {
    --accent: var(--c-saffron);
  }
  .rc[data-accent='teal'] {
    --accent: var(--c-teal);
  }
  .rc[data-accent='purple'] {
    --accent: var(--c-purple);
  }
  .rc[data-accent='red'] {
