  }

  .rc.is-done .rc__card {
    filter: saturate(0.35);
  }

  .rc.is-done .rc__status {
    border-color: var(--c-line-strong);
    background: repeating-conic-gradient(rgb(255 255 255 / 0.12) 0 25%, transparent 0 50%) 0 0 / 8px 8px var(--c-asphalt);
  }

  @media (hover: hover) {
    .rc:hover .rc__card {
      translate: 0 -6px;
      border-color: color-mix(in oklab, var(--accent) 70%, transparent);
      box-shadow:
        0 30px 60px -30px color-mix(in oklab, var(--accent) 45%, transparent),
        0 0 0 1px color-mix(in oklab, var(--accent) 30%, transparent);
    }

    .rc:hover .rc__bignum {
