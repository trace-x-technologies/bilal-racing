  .rc__card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    width: 100%;
    padding: var(--space-5);
    border-radius: var(--radius-l);
    border: 1px solid var(--c-line-strong);
    background:
      radial-gradient(120% 70% at 100% 0%, color-mix(in oklab, var(--accent) 17%, transparent), transparent 62%),
      linear-gradient(180deg, var(--c-graphite), var(--c-asphalt) 70%);
    overflow: hidden;
    isolation: isolate;
    /* hover lift uses `translate`; `transform` is reserved for the GSAP entrance */
    transition:
      translate var(--dur-med) var(--ease-out-expo),
      border-color var(--dur-med),
      box-shadow var(--dur-med);
  }

  /* livery stripe */
  .rc__card::before {
    content: '';
    position: absolute;
