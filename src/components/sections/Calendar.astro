  }

  /* ---------- No JS: hide the live clock, keep the static next-race info ---------- */
  :global(html:not(.js)) .cd__clock {
    display: none;
  }

  @keyframes cd-ping {
    from {
      transform: scale(1);
      opacity: 0.9;
    }
    to {
      transform: scale(3.2);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rc__line {
      stroke-dashoffset: 0;
      transition: none;
    }

    .rc__trail,
    .rc__car {
      display: none;
    }

    .cd__live::after {
      display: none;
    }
  }
</style>

<script>
  import { gsap, prefersReducedMotion } from '@/scripts/motion';
  import { sound } from '@/scripts/audio';

  const pad = (n: number) => String(Math.max(0, n)).padStart(2, '0');

  interface RaceRef {
    el: HTMLElement;
    start: number;
    end: number;
    name: string;
    round: number;
    day: string;
    time: string;
  }

  /* ---------------- Split-flap digit ---------------- */
  class FlipDigit {
    private top: HTMLElement;
    private bot: HTMLElement;
    private flapTop: HTMLElement;
    private flapBot: HTMLElement;
    private anims: Animation[] = [];
    value = '0';

    constructor(el: HTMLElement) {
      const q = (s: string) => el.querySelector<HTMLElement>(`${s} > span`)!;
      this.top = q('.fd__top');
      this.bot = q('.fd__bot');
      this.flapTop = q('.fd__flap--top');
      this.flapBot = q('.fd__flap--bot');
    }

    /** Set without animation (reduced motion, scramble, first paint). */
    snap(v: string): void {
      this.anims.forEach((a) => a.cancel());
      this.anims = [];
      this.value = v;
      this.top.textContent = v;
      this.bot.textContent = v;
      this.flapTop.textContent = v;
      this.flapBot.textContent = v;
    }

    flip(v: string): void {
      if (v === this.value) return;
      const old = this.value;
      this.anims.forEach((a) => a.cancel());
      this.value = v;
      this.top.textContent = v;
      this.bot.textContent = old;
      this.flapTop.textContent = old;
      this.flapBot.textContent = v;
      const topFlap = this.flapTop.parentElement!;
      const botFlap = this.flapBot.parentElement!;
      const a = topFlap.animate([{ transform: 'rotateX(0deg)' }, { transform: 'rotateX(-90deg)' }], {
        duration: 240,
        easing: 'cubic-bezier(0.55, 0, 1, 0.45)',
        fill: 'forwards',
      });
      const b = botFlap.animate(
        [{ transform: 'rotateX(90deg)' }, { transform: 'rotateX(-8deg)', offset: 0.8 }, { transform: 'rotateX(0deg)' }],
        { duration: 300, delay: 240, easing: 'ease-out', fill: 'both' },
      );
      this.anims = [a, b];
      b.finished
        .then(() => {
          this.bot.textContent = v;
          this.flapTop.textContent = v;
          a.cancel();
          b.cancel();
        })
        .catch(() => {
          /* cancelled by a newer flip */
        });
    }
  }

  function initCalendar(): void {
    const root = document.querySelector<HTMLElement>('[data-cal]');
    if (!root) return;
    const reduce = prefersReducedMotion();

    const races: RaceRef[] = Array.from(root.querySelectorAll<HTMLElement>('[data-race]')).map((el) => ({
      el,
      start: Number(el.dataset.start),
      end: Number(el.dataset.end),
      name: el.dataset.name ?? '',
      round: Number(el.dataset.round),
      day: el.dataset.day ?? '',
      time: el.dataset.time ?? '',
    }));
    if (!races.length) return;

    /* ---------- Race statuses ---------- */
    type Mode = 'next' | 'live' | 'done';
    function target(now: number): { mode: Mode; race: RaceRef } {
      const live = races.find((r) => now >= r.start && now < r.end);
      if (live) return { mode: 'live', race: live };
      const next = races.find((r) => r.start > now);
      if (next) return { mode: 'next', race: next };
      return { mode: 'done', race: races[races.length - 1] };
    }

    let current = target(Date.now());

    function paintStatuses(now: number): void {
      const t = target(now);
      races.forEach((r) => {
        const chip = r.el.querySelector<HTMLElement>('[data-status]');
        const result = r.el.querySelector<HTMLElement>('[data-result]');
        const done = now >= r.end;
        const live = now >= r.start && now < r.end;
        const isNext = t.mode === 'next' && t.race === r;
        r.el.classList.toggle('is-done', done);
        r.el.classList.toggle('is-live', live);
        r.el.classList.toggle('is-next', isNext);
        if (result) result.hidden = !done;
        if (chip) {
          chip.dataset.tag ??= chip.textContent?.trim() ?? '';
          chip.textContent = done ? 'Chequered' : live ? 'Live now' : isNext ? 'Next up' : chip.dataset.tag;
        }
      });
    }
    paintStatuses(Date.now());

    /* ---------- Countdown ---------- */
    const cd = root.querySelector<HTMLElement>('[data-cd]');
    const digits: Record<string, FlipDigit[]> = {};
    root.querySelectorAll<HTMLElement>('[data-unit]').forEach((unit) => {
      digits[unit.dataset.unit!] = Array.from(unit.querySelectorAll<HTMLElement>('[data-fd]')).map(
        (el) => new FlipDigit(el),
      );
    });
    const nameEl = root.querySelector<HTMLElement>('[data-cd-name]');
    const statusEl = root.querySelector<HTMLElement>('[data-cd-status]');
    const metaEl = root.querySelector<HTMLElement>('[data-cd-meta]');
    const localEl = root.querySelector<HTMLElement>('[data-cd-local]');
    const srEl = root.querySelector<HTMLElement>('[data-cd-sr]');
    const quipEl = root.querySelector<HTMLElement>('[data-cd-quip]');
    const mapSlot = root.querySelector<HTMLElement>('[data-cd-map]');

    const quips: Record<Mode, string> = {
      next: 'Estimated driver arrival: lights out + 9 minutes.',
      live: 'Race in progress. The driver has been located. He is in the garage. Napping.',
      done: 'Season complete. Pre-season testing resumes when he wakes up.',
    };

    function paintTarget(): void {
      const { mode, race } = current;
      if (cd) cd.dataset.mode = mode;
      if (nameEl) nameEl.textContent = race.name;
      if (statusEl) {
        statusEl.textContent =
          mode === 'live'
            ? `Live now · Round ${pad(race.round)}`
            : mode === 'done'
              ? 'Season complete · Final round'
              : `Next session · Round ${pad(race.round)}`;
      }
      if (metaEl) metaEl.textContent = `${race.day} · Lights out ${race.time} SLST`;
      if (quipEl) quipEl.textContent = quips[mode];
      if (localEl) {
        try {
          const tz = Intl.DateTimeFormat().resolvedOptions().timeZone;
          if (tz === 'Asia/Colombo') {
            localEl.textContent = 'Same time zone as the driver. No excuses.';
          } else {
            const local = new Intl.DateTimeFormat(undefined, {
              weekday: 'short',
              day: 'numeric',
              month: 'short',
              hour: '2-digit',
              minute: '2-digit',
            }).format(race.start);
            localEl.textContent = `Your time: ${local}. Set an alarm. He won’t.`;
          }
          localEl.hidden = false;
        } catch {
          localEl.hidden = true;
        }
      }
      // Clone the target circuit into the countdown panel.
      const svg = race.el.querySelector('svg');
      if (mapSlot && svg) {
        const clone = svg.cloneNode(true) as SVGElement;
        clone.removeAttribute('role');
        clone.removeAttribute('aria-label');
        mapSlot.replaceChildren(clone);
        mapSlot.classList.add('rc', 'is-drawn', 'is-next');
        mapSlot.dataset.accent = race.el.dataset.accent;
      }
    }
    paintTarget();

    function parts(ms: number): Record<'d' | 'h' | 'm' | 's', number> {
      const total = Math.max(0, Math.floor(ms / 1000));
      return {
        d: Math.min(99, Math.floor(total / 86400)),
        h: Math.floor((total % 86400) / 3600),
        m: Math.floor((total % 3600) / 60),
        s: total % 60,
      };
    }

    const plural = (n: number, word: string) => `${n} ${word}${n === 1 ? '' : 's'}`;

    let lastSrMinute = -1;
    function render(animate: boolean): void {
      const now = Date.now();
      const next = target(now);
      if (next.race !== current.race || next.mode !== current.mode) {
        current = next;
        paintStatuses(now);
        paintTarget();
      }
      const ms = current.mode === 'next' ? current.race.start - now : 0;
      const p = parts(ms);
      (Object.keys(p) as Array<keyof typeof p>).forEach((k) => {
        const str = pad(p[k]);
        digits[k]?.forEach((d, i) => {
          const ch = str[i] ?? '0';
          if (animate && !reduce) d.flip(ch);
          else d.snap(ch);
        });
      });
      const minute = Math.floor(ms / 60000);
      if (srEl && minute !== lastSrMinute) {
        lastSrMinute = minute;
        srEl.textContent =
          current.mode === 'next'
            ? `${current.race.name}: lights out in ${plural(p.d, 'day')}, ${plural(p.h, 'hour')} and ${plural(p.m, 'minute')}.`
            : current.mode === 'live'
              ? `${current.race.name} is live now.`
              : 'The season is complete.';
      }
    }

    let timer = 0;
    let running = false;
    function loop(): void {
      render(true);
      timer = window.setTimeout(loop, 1000 - (Date.now() % 1000) + 8);
    }
    function start(): void {
      if (running) return;
      running = true;
      render(false);
      timer = window.setTimeout(loop, 1000 - (Date.now() % 1000) + 8);
    }
    function stop(): void {
      running = false;
      window.clearTimeout(timer);
    }

    // Slot-machine scramble the first time the clock is seen.
    let scrambled = false;
    function scramble(): void {
      if (scrambled || reduce) return;
      scrambled = true;
      stop();
      const all = Object.values(digits).flat();
      let n = 0;
      const id = window.setInterval(() => {
        all.forEach((d) => d.snap(String(Math.floor(Math.random() * 10))));
        if (++n > 14) {
          window.clearInterval(id);
          all.forEach((d) => d.snap('0'));
          render(true);
          if (sectionVisible && !document.hidden) start();
        }
      }, 55);
    }

    render(false);

    /* ---------- Visibility: pause everything offscreen / hidden tab ---------- */
    let sectionVisible = false;
    const sectionIO = new IntersectionObserver(
      ([entry]) => {
        sectionVisible = entry.isIntersecting;
        root.classList.toggle('is-live', sectionVisible);
        if (sectionVisible && !document.hidden) start();
        else stop();
      },
      { rootMargin: '150px 0px' },
    );
    sectionIO.observe(root);

    if (cd) {
      const cdIO = new IntersectionObserver(
        ([entry]) => {
          if (entry.isIntersecting) {
            scramble();
            cdIO.disconnect();
          }
        },
        { threshold: 0.5 },
      );
      cdIO.observe(cd);
    }

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) stop();
      else if (sectionVisible) start();
    });

    /* ---------- Carousel ---------- */
    const scroller = root.querySelector<HTMLElement>('[data-cal-scroller]');
    const prev = root.querySelector<HTMLButtonElement>('[data-cal-prev]');
    const next = root.querySelector<HTMLButtonElement>('[data-cal-next]');
    const nowEl = root.querySelector<HTMLElement>('[data-cal-now]');
    const bar = root.querySelector<HTMLElement>('[data-cal-progress]');
    const viewBtn = root.querySelector<HTMLButtonElement>('[data-cal-view]');
    const viewLabel = root.querySelector<HTMLElement>('[data-cal-view-label]');
    const items = races.map((r) => r.el);
    if (!scroller) return;

    const supportsTimeline = CSS.supports('animation-timeline: scroll()');
    const smooth = (): ScrollBehavior => (prefersReducedMotion() ? 'auto' : 'smooth');

    let stepW = 1;
    function measure(): void {
      stepW = items[1] ? items[1].offsetLeft - items[0].offsetLeft : items[0].offsetWidth || 1;
    }
    measure();

    let raf = 0;
    function onScroll(): void {
      if (raf) return;
      raf = requestAnimationFrame(() => {
        raf = 0;
        if (!scroller) return;
        const max = scroller.scrollWidth - scroller.clientWidth;
        const x = scroller.scrollLeft;
        const idx = Math.min(items.length, Math.round(x / stepW) + 1);
        if (nowEl) nowEl.textContent = pad(idx);
        if (prev) prev.disabled = x <= 2;
        if (next) next.disabled = x >= max - 2;
        if (!supportsTimeline && bar) {
          const p = max > 0 ? x / max : 1;
          bar.style.transform = `scaleX(${0.12 + 0.88 * p})`;
        }
      });
    }
    scroller.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener(
      'resize',
      () => {
        measure();
        onScroll();
      },
      { passive: true },
    );
    onScroll();

    // Later in the season, park the carousel on the next race.
    const nextIdx = items.findIndex((el) => el.classList.contains('is-next') || el.classList.contains('is-live'));
    if (nextIdx > 0) scroller.scrollLeft = nextIdx * stepW;

    function go(dir: 1 | -1): void {
      if (!scroller) return;
      const visible = Math.max(1, Math.floor(scroller.clientWidth / stepW) - 1);
      scroller.scrollBy({ left: dir * visible * stepW, behavior: smooth() });
      sound.play('click');
    }
    prev?.addEventListener('click', () => go(-1));
    next?.addEventListener('click', () => go(1));

    // Mouse drag (touch/pen use native scrolling).
    let dragging = false;
    let moved = 0;
    let startX = 0;
    let startLeft = 0;
    scroller.addEventListener('pointerdown', (e) => {
      if (e.pointerType !== 'mouse' || e.button !== 0 || root.dataset.view === 'grid') return;
      dragging = true;
      moved = 0;
      startX = e.clientX;
      startLeft = scroller.scrollLeft;
    });
    scroller.addEventListener('pointermove', (e) => {
      if (!dragging) return;
      const dx = e.clientX - startX;
      if (!scroller.classList.contains('is-dragging') && Math.abs(dx) > 4) {
        scroller.classList.add('is-dragging');
        scroller.setPointerCapture(e.pointerId);
      }
      moved = Math.max(moved, Math.abs(dx));
      if (scroller.classList.contains('is-dragging')) scroller.scrollLeft = startLeft - dx;
    });
    const endDrag = (e: PointerEvent) => {
      if (!dragging) return;
      dragging = false;
      if (!scroller.classList.contains('is-dragging')) return;
      if (scroller.hasPointerCapture(e.pointerId)) scroller.releasePointerCapture(e.pointerId);
      const target = Math.round(scroller.scrollLeft / stepW) * stepW;
      scroller.classList.remove('is-dragging');
      scroller.scrollTo({ left: target, behavior: smooth() });
    };
    scroller.addEventListener('pointerup', endDrag);
    scroller.addEventListener('pointercancel', endDrag);
    scroller.addEventListener(
      'click',
      (e) => {
        if (moved > 6) {
          e.preventDefault();
          e.stopPropagation();
          moved = 0;
        }
      },
      true,
    );

    // Row ↔ grid, morphed with the View Transitions API.
    const setView = (toGrid: boolean, animate: boolean): void => {
      if ((root.dataset.view === 'grid') === toGrid) return;
      const apply = () => {
        root.dataset.view = toGrid ? 'grid' : 'row';
        viewBtn?.setAttribute('aria-pressed', String(toGrid));
        if (viewLabel) viewLabel.textContent = toGrid ? 'Row view' : 'Grid view';
        if (!toGrid) {
          measure();
          scroller.scrollLeft = 0;
        }
        onScroll();
      };
      if (!animate || !document.startViewTransition || prefersReducedMotion()) {
        apply();
        window.dispatchEvent(new Event('resize'));
        return;
      }
      items.forEach((li, i) => (li.style.viewTransitionName = `cal-round-${i + 1}`));
      const vt = document.startViewTransition(apply);
      vt.finished.finally(() => {
        items.forEach((li) => (li.style.viewTransitionName = ''));
        window.dispatchEvent(new Event('resize')); // lets ScrollTrigger & friends re-measure
      });
    };
    viewBtn?.addEventListener('click', () => {
      sound.play('click');
      setView(root.dataset.view !== 'grid', true);
    });
    // The toggle is hidden on phones (CSS); if the viewport shrinks while the grid is open, go back to the row.
    window.matchMedia('(max-width: 47.99rem)').addEventListener('change', (e) => {
      if (e.matches) setView(false, false);
    });

    /* ---------- Circuits draw themselves in view ---------- */
    if (reduce || !('IntersectionObserver' in window)) {
      items.forEach((el) => el.classList.add('is-drawn'));
    } else {
      const drawIO = new IntersectionObserver(
        (entries) => {
          let k = 0;
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            const el = entry.target as HTMLElement;
            el.style.setProperty('--draw-delay', `${150 + k++ * 140}ms`);
            el.classList.add('is-drawn');
            drawIO.unobserve(el);
          });
        },
        { threshold: 0.45 },
      );
      items.forEach((el) => drawIO.observe(el));
    }

    /* ---------- Choreographed entrance: cards peel out of the pit lane ----------
       Animate the inner cards, never the <li> snap targets — moving those makes
       the browser re-snap mid-animation and swallow button presses. */
    const cardEls = items
      .map((li) => li.querySelector<HTMLElement>('.rc__card'))
      .filter((el): el is HTMLElement => el !== null);
    if (!reduce && cardEls.length) {
      gsap.from(cardEls, {
        xPercent: 55,
        rotateY: -24,
        opacity: 0,
        stagger: 0.07,
        ease: 'power3.out',
        scrollTrigger: {
          trigger: scroller,
          start: 'top 95%',
          end: 'top 50%',
          scrub: 0.8,
        },
      });
    }
  }

  initCalendar();
</script>
