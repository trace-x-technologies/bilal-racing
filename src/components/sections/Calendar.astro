  }

  .rc__trail,
  .rc__car {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0;
    transition: opacity var(--dur-med);
    animation: 2.6s linear infinite paused;
  }

  .rc__trail {
    stroke: var(--c-chalk);
    stroke-width: 4;
    stroke-dasharray: 90 910;
    animation-name: rc-trail;
    stroke-opacity: 0.35;
