  .rc__status {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    padding: 0.3em 0.7em;
    border-radius: 999px;
    border: 1px solid color-mix(in oklab, var(--accent) 55%, transparent);
    color: var(--c-chalk);
    /* opaque, so the outlined round numeral behind never cuts through the label */
