  }

  /* ---------- Larger screens ---------- */
  @media (min-width: 64rem) {
    .cd {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.3fr);
      align-items: center;
      gap: var(--space-7);
    }
  }

  /* ---------- View Transition choreography for row ↔ grid ----------
     Names are only applied during the toggle (see script), so these rules are inert otherwise. */
  :global(::view-transition-group(cal-round-1)),
  :global(::view-transition-group(cal-round-2)),
  :global(::view-transition-group(cal-round-3)),
  :global(::view-transition-group(cal-round-4)),
  :global(::view-transition-group(cal-round-5)),
  :global(::view-transition-group(cal-round-6)),
  :global(::view-transition-group(cal-round-7)),
  :global(::view-transition-group(cal-round-8)),
  :global(::view-transition-group(cal-round-9)) {
