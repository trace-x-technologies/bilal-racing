---
/**
 * 06 · Calendar — the 2026/27 season.
 * Live split-flap countdown to the next Grand Prix (computed in the browser),
 * then a drag/scroll-snap carousel of hand-drawn circuits that can morph into a
 * grid with the View Transitions API. Circuit maps draw themselves in view and
 * a comet "car" laps them on hover.
 */
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { races, raceEnd, pathStart, pathEnd, type WeatherIcon } from '@/data/calendar';
import { sinhala } from '@/data/lore';

const pad = (n: number) => String(n).padStart(2, '0');

const slTime = new Intl.DateTimeFormat('en-GB', {
  hour: '2-digit',
  minute: '2-digit',
  hour12: false,
  timeZone: 'Asia/Colombo',
});
const slDay = new Intl.DateTimeFormat('en-GB', {
  weekday: 'short',
  day: 'numeric',
  month: 'short',
  year: 'numeric',
  timeZone: 'Asia/Colombo',
});

// Build-time guess at the next race (the browser recomputes it live).
const buildNow = Date.now();
const buildNext = races.find((r) => raceEnd(r) > buildNow) ?? races[races.length - 1];

const weatherIcons: Record<WeatherIcon, string> = {
  sun: '<circle cx="12" cy="12" r="4.2"/><path d="M12 2.5v2.4M12 19.1v2.4M2.5 12h2.4M19.1 12h2.4M5.3 5.3l1.7 1.7M17 17l1.7 1.7M5.3 18.7 7 17M17 7l1.7-1.7"/>',
  moon: '<path d="M20 14.6A8.2 8.2 0 1 1 9.4 4a6.6 6.6 0 0 0 10.6 10.6Z"/>',
  wind: '<path d="M3 8.5h11a3 3 0 1 0-3-3M3 12.5h15.5a3 3 0 1 1-3 3M3 16.5h7"/>',
  rain: '<path d="M6.8 15.5a4 4 0 0 1-.6-8 5.6 5.6 0 0 1 10.8-1.2 4 4 0 0 1 .6 9.2Z"/><path d="M8.5 18.5 7.6 21M12.5 18.5l-.9 2.5M16.5 18.5l-.9 2.5"/>',
  cold: '<path d="M12 2.5v19M3.8 7.2l16.4 9.6M3.8 16.8l16.4-9.6M9.6 4 12 6.4 14.4 4M9.6 20 12 17.6l2.4 2.4"/>',
  mist: '<path d="M3 7.5h18M5 11.5h14M3 15.5h18M7 19.5h10"/>',
  hot: '<path d="M10 14.4V5a2 2 0 1 1 4 0v9.4a4 4 0 1 1-4 0Z"/><path d="M12 9v7.5"/>',
  wave: '<path d="M2 9c2.5 0 2.5-2 5-2s2.5 2 5 2 2.5-2 5-2 2.5 2 5 2M2 15c2.5 0 2.5-2 5-2s2.5 2 5 2 2.5-2 5-2 2.5 2 5 2"/>',
};

const cards = races.map((r) => {
  const startMs = Date.parse(r.start);
  const [sx, sy] = pathStart(r.path);
  const end = r.open ? pathEnd(r.path) : null;
  return {
    ...r,
    startMs,
    endMs: raceEnd(r),
    sx,
    sy,
    end,
    lightsOut: slTime.format(startMs),
    dayLabel: slDay.format(startMs),
  };
});

const units = [
  { key: 'd', label: 'Days' },
  { key: 'h', label: 'Hrs' },
  { key: 'm', label: 'Min' },
  { key: 's', label: 'Sec' },
] as const;
---

<section class="section cal" id="calendar" aria-labelledby="calendar-title" data-cal data-view="row">
  <div class="cal__bgword" aria-hidden="true">
    <span>Season 26/27</span>
  </div>

  <div class="container">
    <SectionHeading
      index="06"
      kicker="Calendar"
      title="2026/27 <em>Season</em>"
      id="calendar-title"
      si={sinhala.subaGaman.si}
      lead="Nine rounds. One island. Zero rounds he will arrive on time for."
    />

    <!-- ============ Live countdown ============ -->
    <div class="cd" data-cd data-reveal="up" data-mode="next">
      <div class="cd__info">
        <p class="cd__label t-mono">
          <span class="cd__live" aria-hidden="true"></span>
          <span data-cd-status>Next session · Round {pad(buildNext.round)}</span>
        </p>
        <p class="cd__race t-condensed" data-cd-name>{buildNext.name}</p>
        <p class="cd__meta t-mono" data-cd-meta>
          {slDay.format(Date.parse(buildNext.start))} · Lights out {slTime.format(Date.parse(buildNext.start))} SLST
        </p>
        <p class="cd__local" data-cd-local hidden></p>
        <div class="cd__map" data-cd-map aria-hidden="true"></div>
      </div>

      <div class="cd__clock">
        <div class="cd__board" role="timer" aria-live="off">
          <p class="visually-hidden" data-cd-sr>Countdown to {buildNext.name}.</p>
          <div class="cd__units" aria-hidden="true">
            {
              units.map((u, i) => (
                <>
                  {i > 0 && <span class="cd__sep">:</span>}
                  <div class:list={['cd__unit', `cd__unit--${u.key}`]}>
                    <div class="cd__digits" data-unit={u.key}>
                      {[0, 1].map(() => (
                        <span class="fd" data-fd>
                          <span class="fd__half fd__top">
                            <span>0</span>
                          </span>
                          <span class="fd__half fd__bot">
                            <span>0</span>
                          </span>
                          <span class="fd__flap fd__flap--top">
                            <span>0</span>
                          </span>
                          <span class="fd__flap fd__flap--bot">
                            <span>0</span>
                          </span>
                        </span>
                      ))}
                    </div>
                    <span class="cd__unit-label t-mono">{u.label}</span>
                  </div>
                </>
              ))
            }
          </div>
        </div>
        <p class="cd__quip" data-cd-quip>Estimated driver arrival: lights out + 9 minutes.</p>
      </div>
    </div>

    <!-- ============ Carousel controls ============ -->
    <div class="cal__bar" data-reveal="fade">
      <p class="cal__count t-mono" aria-hidden="true">
        <span class="cal__count-now" data-cal-now>01</span><span class="cal__count-sep">/</span>{pad(races.length)}
      </p>
      <div class="cal__progress" aria-hidden="true"><span data-cal-progress></span></div>
      <div class="cal__btns">
        <button type="button" class="cal__view t-mono" data-cal-view aria-pressed="false">
          <svg class="cal__ico-grid" viewBox="0 0 20 20" aria-hidden="true"
            ><rect x="2" y="2" width="7" height="7" rx="1.5"></rect><rect x="11" y="2" width="7" height="7" rx="1.5"
            ></rect><rect x="2" y="11" width="7" height="7" rx="1.5"></rect><rect
              x="11"
              y="11"
              width="7"
              height="7"
              rx="1.5"></rect></svg
          >
          <!-- a row of cards: shown while the grid is active, as the way back -->
          <svg class="cal__ico-rows" viewBox="0 0 20 20" aria-hidden="true"
            ><rect x="1.5" y="4" width="5" height="12" rx="1.3"></rect><rect x="7.5" y="4" width="5" height="12" rx="1.3"
            ></rect><rect x="13.5" y="4" width="5" height="12" rx="1.3"></rect></svg
          >
          <span data-cal-view-label>Grid view</span>
        </button>
        <button type="button" class="cal__nav" data-cal-prev aria-label="Previous rounds">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5 8 12l7 7"></path></svg>
        </button>
        <button type="button" class="cal__nav" data-cal-next aria-label="Next rounds">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 7 7-7 7"></path></svg>
        </button>
      </div>
    </div>
  </div>

  <!-- ============ Rounds ============ -->
  <div
    class="cal__viewport"
    data-cal-scroller
    tabindex="0"
    role="region"
    aria-label="Season rounds — scroll sideways or use the arrow buttons"
    data-lenis-prevent-horizontal
  >
    <ol class="cal__track" data-cal-track>
      {
        cards.map((r) => (
          <li
            class="rc"
            data-race
            data-accent={r.accent}
            data-start={r.startMs}
            data-end={r.endMs}
            data-name={r.name}
            data-round={r.round}
            data-day={r.dayLabel}
            data-time={r.lightsOut}
          >
            <article class="rc__card" aria-labelledby={`rc-${r.id}`}>
              <span class="rc__bignum" aria-hidden="true">
                {pad(r.round)}
              </span>
              <header class="rc__top">
                <span class="rc__round t-mono">Round {pad(r.round)}</span>
                <span class="rc__status t-mono" data-status>
                  {r.tag}
                </span>
              </header>

              <figure class="rc__map">
                <svg viewBox="0 0 200 120" role="img" aria-label={`Circuit map: ${r.circuit}`}>
                  {r.decor && <path class="rc__decor" d={r.decor} />}
                  <path class="rc__asphalt" d={r.path} />
                  <path class="rc__line" d={r.path} pathLength="1000" />
                  <path class="rc__trail" d={r.path} pathLength="1000" />
                  <path class="rc__car" d={r.path} pathLength="1000" />
                  <g class="rc__flag" transform={`translate(${r.sx} ${r.sy})`}>
                    <rect x="-4.5" y="-4.5" width="9" height="9" fill="#f4f1ea" />
                    <rect x="-4.5" y="-4.5" width="4.5" height="4.5" fill="#07070b" />
                    <rect x="0" y="0" width="4.5" height="4.5" fill="#07070b" />
                  </g>
                  {r.end && (
                    <g class="rc__flag" transform={`translate(${r.end[0]} ${r.end[1]})`}>
                      <rect x="-4.5" y="-4.5" width="9" height="9" fill="#f4f1ea" />
                      <rect x="-4.5" y="-4.5" width="4.5" height="4.5" fill="#07070b" />
                      <rect x="0" y="0" width="4.5" height="4.5" fill="#07070b" />
                    </g>
                  )}
                </svg>
                <figcaption class="rc__turn t-mono">{r.turn1}</figcaption>
              </figure>

              <p class="rc__weekend t-condensed">{r.weekend}</p>
              <h3 class="rc__venue t-condensed" id={`rc-${r.id}`}>
                {r.venue}
                <span class="visually-hidden">— {r.name}</span>
              </h3>
              <p class="rc__name" aria-hidden="true">
                {r.name}
              </p>
              <p class="rc__circuit t-mono">{r.circuit}</p>

              <dl class="rc__stats">
                <div>
                  <dt class="t-mono">Laps</dt>
                  <dd class="t-condensed">{r.laps}</dd>
                </div>
                <div>
                  <dt class="t-mono">Length</dt>
                  <dd class="t-condensed">
                    {r.lengthKm.toFixed(1)}
                    <small>km</small>
                  </dd>
                </div>
                <div>
                  <dt class="t-mono">Lights out</dt>
                  <dd class="t-condensed">{r.lightsOut}</dd>
                </div>
              </dl>

              <p class="rc__weather">
                <svg viewBox="0 0 24 24" aria-hidden="true" set:html={weatherIcons[r.weather.icon]} />
                <span>
                  <span class="visually-hidden">Forecast: </span>
                  {r.weather.text}
                </span>
              </p>
              <p class="rc__joke">{r.joke}</p>
              <p class="rc__result t-mono" data-result hidden>
                <span>Result</span> {r.result}
              </p>
            </article>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .cal {
    overflow-x: clip;
    timeline-scope: --cal-x;
  }

  /* ---------- Giant background word (CSS scroll-driven) ---------- */
  .cal__bgword {
    position: absolute;
    inset: calc(var(--section-pad) * 0.35) 0 auto;
    z-index: -1;
    pointer-events: none;
    white-space: nowrap;
    font-family: var(--f-display);
    font-weight: 900;
    font-stretch: var(--stretch-condensed);
    font-variation-settings: 'wdth' 62;
    font-size: clamp(7rem, 22vw, 22rem);
    line-height: 0.8;
    text-transform: uppercase;
    color: transparent;
    -webkit-text-stroke: 1px color-mix(in oklab, var(--c-chalk) 9%, transparent);
    opacity: 0.9;
  }

  .cal__bgword span {
    display: inline-block;
    translate: 4% 0;
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .cal__bgword span {
        animation: cal-drift linear both;
        animation-timeline: view();
        /* drifts sideways while the word itself crosses the viewport */
        animation-range: cover 0% cover 100%;
      }
    }
  }

  @keyframes cal-drift {
    from {
      translate: 6% 0;
    }
    to {
      translate: -38% 0;
    }
  }

  /* ---------- Countdown ---------- */
  .cd {
    position: relative;
    display: grid;
    gap: var(--space-6);
    padding: clamp(1.25rem, 0.8rem + 2.4vw, 2.75rem);
    border: 1px solid var(--c-line-strong);
    border-radius: var(--radius-l);
    background:
      radial-gradient(90% 120% at 100% 0%, rgb(255 197 46 / 0.1), transparent 55%),
      radial-gradient(70% 90% at 0% 100%, rgb(160 21 62 / 0.18), transparent 60%),
      repeating-linear-gradient(90deg, rgb(255 255 255 / 0.018) 0 2px, transparent 2px 6px),
      linear-gradient(180deg, var(--c-graphite), var(--c-asphalt));
    box-shadow:
      0 40px 80px -40px rgb(0 0 0 / 0.8),
      inset 0 1px 0 rgb(255 255 255 / 0.06);
    overflow: hidden;
    isolation: isolate;
  }

  /* corner brackets, pit-wall monitor style */
  .cd::before,
  .cd::after {
    content: '';
    position: absolute;
    width: 1.5rem;
    height: 1.5rem;
    border: 2px solid var(--c-gold);
    pointer-events: none;
  }

  .cd::before {
    top: 0.75rem;
    left: 0.75rem;
    border-right: 0;
    border-bottom: 0;
  }

  .cd::after {
    right: 0.75rem;
    bottom: 0.75rem;
    border-left: 0;
    border-top: 0;
  }

  .cd__info {
    display: grid;
    align-content: start;
    gap: var(--space-3);
    min-width: 0;
  }

  .cd__label {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--c-mute);
  }

  .cd__live {
    position: relative;
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--c-red);
    box-shadow: var(--glow-red);
  }

  /* sonar ping — transform/opacity only, so it stays on the compositor */
  .cd__live::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 1px solid var(--c-red);
    animation: cd-ping 1.6s var(--ease-out-expo) infinite;
  }

  .cd[data-mode='done'] .cd__live {
    background: var(--c-faint);
    box-shadow: none;
  }

  .cd[data-mode='done'] .cd__live::after {
    display: none;
  }

  .cd__race {
    font-family: var(--f-display);
    font-weight: 850;
    font-size: clamp(2.2rem, 1.2rem + 4.2vw, 4.6rem);
    line-height: 0.88;
    text-transform: uppercase;
    text-wrap: balance;
  }

  .cd__meta {
    color: var(--c-gold);
    letter-spacing: 0.12em;
  }

  .cd__local {
    color: var(--c-mute);
    font-size: var(--fs-small);
  }

  .cd__map {
    width: min(62%, 17rem);
    margin-top: var(--space-2);
  }

  .cd__map :global(svg) {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .cd__clock {
    container-type: inline-size;
    display: grid;
    align-content: center;
    gap: var(--space-4);
    min-width: 0;
  }

  .cd__units {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.4cqi;
    font-size: clamp(2rem, 11cqi, 6rem);
  }

  .cd__unit {
    display: grid;
    justify-items: center;
    gap: 0.55rem;
  }

  .cd__digits {
    display: flex;
    gap: 0.06em;
  }

  .cd__unit-label {
    color: var(--c-mute);
    font-size: max(0.62rem, 0.13em);
  }

  .cd__sep {
    align-self: flex-start;
    font-family: var(--f-display);
    font-weight: 800;
    font-size: 0.7em;
    line-height: 1.55;
    color: var(--c-gold);
  }

  .cd__quip {
    color: var(--c-mute);
    font-size: var(--fs-small);
    font-style: italic;
    padding-right: var(--space-5);
  }

  @media (min-width: 64rem) {
    .cd__quip {
      text-align: right;
    }
  }

  /* ---- Split-flap digit ---- */
  .fd {
    --fd-h: 1.18em;
    position: relative;
    display: block;
    width: 0.74em;
    height: var(--fd-h);
    perspective: 5em;
    font-family: var(--f-display);
    font-weight: 800;
    font-stretch: var(--stretch-condensed);
    font-variation-settings: 'wdth' 62;
    color: var(--c-chalk);
    font-variant-numeric: tabular-nums;
  }

  .cd__unit--s .fd {
    color: var(--c-gold);
  }

  .fd__half,
  .fd__flap {
    position: absolute;
    left: 0;
    right: 0;
    height: 50%;
    overflow: hidden;
    background: linear-gradient(180deg, #23232f, #191922);
    backface-visibility: hidden;
  }

  .fd__top,
  .fd__flap--top {
    top: 0;
    border-radius: 0.09em 0.09em 0 0;
    transform-origin: 50% 100%;
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.07);
  }

  .fd__bot,
  .fd__flap--bot {
    bottom: 0;
    border-radius: 0 0 0.09em 0.09em;
    transform-origin: 50% 0%;
    background: linear-gradient(180deg, #16161e, #1e1e28);
  }

  .fd__flap--bot {
    transform: rotateX(90deg);
  }

  .fd__half > span,
  .fd__flap > span {
    display: block;
    height: var(--fd-h);
    line-height: var(--fd-h);
    text-align: center;
  }

  .fd__bot > span,
  .fd__flap--bot > span {
    translate: 0 -50%;
  }

  /* hinge */
  .fd::after {
    content: '';
    position: absolute;
    inset: calc(50% - 1px) 0 auto;
    height: 2px;
    background: var(--c-carbon);
    z-index: 3;
  }

  .fd__flap {
    z-index: 2;
  }

  /* ---------- Carousel bar ---------- */
  .cal__bar {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-areas:
      'count btns'
      'bar bar';
    align-items: center;
    gap: var(--space-4) var(--space-5);
    margin-top: var(--space-8);
    margin-bottom: var(--space-5);
  }

  @media (min-width: 48rem) {
    .cal__bar {
      grid-template-columns: auto 1fr auto;
      grid-template-areas: 'count bar btns';
    }
  }

  .cal__count {
    grid-area: count;
    display: flex;
    align-items: baseline;
    gap: 0.35em;
    color: var(--c-mute);
    font-size: var(--fs-small);
  }

  .cal__count-now {
    color: var(--c-chalk);
    font-size: 1.35rem;
    letter-spacing: 0.04em;
  }

  .cal__count-sep {
    color: var(--c-faint);
  }

  .cal__progress {
    grid-area: bar;
    height: 2px;
    background: var(--c-line-strong);
    border-radius: 2px;
    overflow: hidden;
  }

  .cal__progress span {
    display: block;
    height: 100%;
    background: var(--g-livery);
    transform-origin: 0 50%;
    transform: scaleX(0.12);
  }

  @supports (animation-timeline: scroll()) {
    .cal__progress span {
      animation: cal-progress linear both;
      animation-timeline: --cal-x;
    }
  }

  @keyframes cal-progress {
    from {
      transform: scaleX(0.12);
    }
    to {
      transform: scaleX(1);
    }
  }

  .cal__btns {
    grid-area: btns;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: var(--space-2);
  }

  .cal__view,
  .cal__nav {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    height: 2.75rem;
    border: 1px solid var(--c-line-strong);
    border-radius: 999px;
    color: var(--c-chalk);
    background: rgb(255 255 255 / 0.03);
    transition:
      background-color var(--dur-fast),
      border-color var(--dur-fast),
      color var(--dur-fast),
      transform var(--dur-fast) var(--ease-out-back);
  }

  .cal__view {
    padding-inline: 1rem;
    white-space: nowrap;
  }

  /* One card per row on phones makes the grid a very long list: phones keep the carousel. */
  @media (max-width: 47.99rem) {
    .cal__view {
      display: none;
    }
  }

  .cal__view[aria-pressed='true'] .cal__ico-grid,
  .cal__view:not([aria-pressed='true']) .cal__ico-rows {
    display: none;
  }

  .cal__nav {
    width: 2.75rem;
  }

  .cal__view svg,
  .cal__nav svg {
    width: 1.1rem;
    height: 1.1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .cal__view svg rect {
    fill: currentColor;
    stroke: none;
    opacity: 0.85;
  }

  .cal__view:hover,
  .cal__nav:hover:not(:disabled) {
    border-color: var(--c-gold);
    color: var(--c-gold);
  }

  .cal__nav:active:not(:disabled) {
    transform: scale(0.92);
  }

  .cal__nav:disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }

  .cal__view[aria-pressed='true'] {
    background: var(--c-gold);
    border-color: var(--c-gold);
    color: var(--c-on-gold);
  }

  /* Grid view: the arrows go (so the toggle sits flush right); count and bar keep their space. */
  .cal[data-view='grid'] .cal__nav {
    display: none;
  }

  .cal[data-view='grid'] .cal__progress,
  .cal[data-view='grid'] .cal__count {
    visibility: hidden;
  }

  /* ---------- Carousel viewport ---------- */
  .cal__viewport {
    --edge: max(var(--gutter), calc((100% - var(--maxw)) / 2));
    display: flex;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--edge);
    padding: var(--space-4) var(--edge) var(--space-7);
    scrollbar-width: none;
    scroll-timeline: --cal-x inline;
    cursor: grab;
  }

  .cal__viewport::-webkit-scrollbar {
    display: none;
  }

  .cal__viewport:focus-visible {
    outline-offset: -4px;
  }

  .cal__viewport.is-dragging {
    scroll-snap-type: none;
    cursor: grabbing;
    user-select: none;
  }

  .cal__track {
    display: flex;
    gap: clamp(0.85rem, 0.5rem + 1vw, 1.5rem);
    list-style: none;
    padding: 0;
    perspective: 1400px;
  }

  .rc {
    flex: 0 0 clamp(16.75rem, 78vw, 21.5rem);
    scroll-snap-align: start;
    display: flex;
    perspective: 1400px;
  }

  /* grid view — morphs in via View Transitions */
  .cal[data-view='grid'] .cal__viewport {
    display: block;
    overflow: visible;
    cursor: auto;
    padding-inline: 0;
    width: min(100% - 2 * var(--gutter), var(--maxw));
    margin-inline: auto;
  }

  .cal[data-view='grid'] .cal__track {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }

  @media (min-width: 40rem) {
    .cal[data-view='grid'] .cal__track {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
