  .rc__map svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .rc__decor {
    fill: none;
    stroke: color-mix(in oklab, var(--c-chalk) 22%, transparent);
    stroke-width: 1.3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .rc__asphalt {
    fill: none;
    stroke: var(--c-steel);
    stroke-width: 9;
