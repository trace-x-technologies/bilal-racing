  .rc__car {
    stroke: var(--c-chalk);
    stroke-width: 7;
    stroke-dasharray: 0.5 999.5;
    animation-name: rc-car;
  }

  /* The comet only laps while you look at a circuit (hover / keyboard focus),
     plus the one in the countdown panel — paint-heavy loops stay rare. */
  .rc:hover .rc__trail,
  .rc:hover .rc__car,
  .rc:focus-within .rc__trail,
  .rc:focus-within .rc__car,
  .cd__map .rc__trail,
  .cd__map .rc__car {
