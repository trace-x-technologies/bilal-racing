    <text x="98" y="62" class="bf-cond" font-size="31" fill="var(--b-ink)" mask="url(#sp-stencil)">LITTER-BOX</text>
    <text x="99" y="82" class="bf-mono" font-size="9.5" letter-spacing="4.2" fill="var(--b-a)">LOGISTICS</text>`,
  nap: `
    <path d="M22 96 L52 22 H94 L74 96 Z" fill="var(--b-a)"/>
    <path d="M70 38 A17 17 0 1 0 82 70 A13 13 0 1 1 70 38 Z" fill="var(--b-ink)"/>
