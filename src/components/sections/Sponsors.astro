</style>

<script>
  import { emit } from '@/scripts/bus';
  import { prefersReducedMotion } from '@/scripts/motion';
  import { sound } from '@/scripts/audio';

  function initSponsors(): void {
    const root = document.querySelector<HTMLElement>('#sponsors');
    if (!root) return;

    // Pause the sleeping-cat loops while offscreen.
    const io = new IntersectionObserver(([entry]) => root.classList.toggle('is-live', entry.isIntersecting), {
      rootMargin: '100px 0px',
    });
    io.observe(root);

    const fine = window.matchMedia('(hover: hover) and (pointer: fine)');

    /* ---------- Spotlight: radial glow follows the pointer ---------- */
    root.querySelectorAll<HTMLElement>('[data-spot]').forEach((card) => {
      let raf = 0;
      card.addEventListener('pointermove', (e) => {
        if (!fine.matches || raf) return;
        raf = requestAnimationFrame(() => {
          raf = 0;
          const r = card.getBoundingClientRect();
          card.style.setProperty('--mx', `${e.clientX - r.left}px`);
          card.style.setProperty('--my', `${e.clientY - r.top}px`);
        });
      });
    });

    /* ---------- 3D tilt on merch cards ---------- */
    root.querySelectorAll<HTMLElement>('[data-tilt]').forEach((card) => {
      let raf = 0;
      let rect: DOMRect | null = null;
      card.addEventListener('pointerenter', () => {
        rect = card.getBoundingClientRect();
      });
      card.addEventListener('pointermove', (e) => {
        if (!fine.matches || prefersReducedMotion() || raf) return;
        raf = requestAnimationFrame(() => {
          raf = 0;
          const r = rect ?? card.getBoundingClientRect();
          const px = (e.clientX - r.left) / r.width;
          const py = (e.clientY - r.top) / r.height;
          card.classList.add('is-tilting');
          card.style.setProperty('--ry', `${(px - 0.5) * 14}deg`);
          card.style.setProperty('--rx', `${(0.5 - py) * 12}deg`);
          card.style.setProperty('--gx', `${px * 100}%`);
          card.style.setProperty('--gy', `${py * 100}%`);
        });
      });
      card.addEventListener('pointerleave', () => {
        cancelAnimationFrame(raf);
        raf = 0;
        rect = null;
        card.classList.remove('is-tilting');
        card.style.setProperty('--rx', '0deg');
        card.style.setProperty('--ry', '0deg');
      });
    });

    /* ---------- Add to cart → always sold out ---------- */
    const countEl = root.querySelector<HTMLElement>('[data-cart-count]');
    const triesEl = root.querySelector<HTMLElement>('[data-cart-tries]');
    let tries = 0;

    root.querySelectorAll<HTMLButtonElement>('[data-add]').forEach((btn) => {
      const label = btn.querySelector<HTMLElement>('[data-add-label]');
      const card = btn.closest<HTMLElement>('.mc');
      let timer = 0;
      btn.addEventListener('click', () => {
        tries += 1;
        emit('bilal:toast', { message: btn.dataset.toast ?? 'Sold out.', tone: 'red' });
        sound.play('meow');
        if (countEl) countEl.textContent = '0';
        if (triesEl) {
          triesEl.hidden = false;
          triesEl.textContent =
            tries === 1 ? '· 1 failed attempt' : tries < 9 ? `· ${tries} failed attempts` : `· ${tries} attempts. Seek help.`;
        }
        if (btn.getAttribute('aria-disabled') === 'true') return;
        btn.setAttribute('aria-disabled', 'true');
        if (label) label.textContent = 'Sold out';
        if (card && !prefersReducedMotion()) {
          card.classList.remove('is-denied');
          void card.offsetWidth; // restart the shake
          card.classList.add('is-denied');
        }
        window.clearTimeout(timer);
        timer = window.setTimeout(() => {
          btn.removeAttribute('aria-disabled');
          if (label) label.textContent = 'Add to cart';
          card?.classList.remove('is-denied');
        }, 2600);
      });
    });

    /* ---------- Title sponsor application ---------- */
    root.querySelector<HTMLButtonElement>('[data-apply]')?.addEventListener('click', (e) => {
      const btn = e.currentTarget as HTMLButtonElement;
      emit('bilal:toast', { message: btn.dataset.toast ?? 'Application received.', tone: 'gold' });
      sound.play('purr');
    });
  }

  initSponsors();
</script>
