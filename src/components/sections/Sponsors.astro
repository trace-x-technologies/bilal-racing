    <path d="M104 34 Q160 4 224 26" fill="none" stroke="var(--b-ink)" stroke-opacity="0.45" stroke-width="1.5" stroke-dasharray="2 5" stroke-linecap="round"/>
    <text x="102" y="74" class="bf-wide-lc" font-size="50" fill="var(--b-ink)">nap</text>
    <text x="104" y="94" class="bf-mono" font-size="9.5" letter-spacing="6" fill="var(--b-a)">AIRLINES</text>`,
  laser: `
