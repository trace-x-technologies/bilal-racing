---

<section class="section sp-sec" id="sponsors" aria-labelledby="sponsors-title">
  <div class="container">
    <SectionHeading
      index="09"
      kicker="Partners"
      title="Official <em>Partners</em>"
      id="sponsors-title"
      lead="Brands brave enough to be seen on a car that stops for sunbeams. All logos are original. All partnerships are imaginary. The gratitude is real."
    />

    <!-- ============ Sponsor wall ============ -->
    <ul class="wall" data-reveal-stagger="70" role="list">
      <li class="wall__title" data-reveal="scale">
        <div class="ts" data-spot>
          <p class="ts__kicker t-mono">
            <span class="ts__dot" aria-hidden="true"></span>
            {titleSponsor.label} · slot available
          </p>
          <div class="ts__art" aria-hidden="true">
            <svg viewBox="0 0 220 130" class="ts__cat">
              <path class="ts__ground" d="M6 118 H214"></path>
              <g class="ts__breathe">
                <path
                  d="M44 116 C34 80 70 52 116 52 C160 52 190 76 184 116 Z"
                  fill="#1b1b25"
                  style="stroke: var(--c-gold)"
                  stroke-width="2.5"
                  stroke-linejoin="round"></path>
                <path
                  d="M184 112 C204 112 206 126 170 124 L64 122"
                  fill="none"
                  style="stroke: var(--c-gold)"
                  stroke-width="2.5"
                  stroke-linecap="round"></path>
                <path d="M122 70 C128 86 128 100 120 112" fill="none" stroke="rgb(255 255 255 / 0.1)" stroke-width="2"
                ></path>
                <path d="M146 68 C154 84 154 100 146 112" fill="none" stroke="rgb(255 255 255 / 0.1)" stroke-width="2"
                ></path>
              </g>
              <g class="ts__head">
                <path
                  d="M40 70 L44 44 L62 60 Z M76 58 L94 44 L96 70 Z"
                  fill="#1b1b25"
                  style="stroke: var(--c-gold)"
                  stroke-width="2.5"
                  stroke-linejoin="round"></path>
                <path d="M46 64 L48 52 L56 60 Z M84 59 L92 52 L92 64 Z" style="fill: var(--c-maroon)"></path>
                <ellipse cx="68" cy="88" rx="32" ry="27" fill="#1b1b25" style="stroke: var(--c-gold)" stroke-width="2.5"></ellipse>
                <path
                  d="M52 88 Q57 93 62 88 M74 88 Q79 93 84 88"
                  fill="none"
                  style="stroke: var(--c-gold)"
                  stroke-width="2.2"
                  stroke-linecap="round"></path>
                <path d="M66 97 L68 99 L70 97" fill="none" style="stroke: var(--c-saffron)" stroke-width="2" stroke-linecap="round"
                ></path>
                <path
                  d="M40 96 L22 94 M40 101 L24 104 M96 96 L114 94 M96 101 L112 104"
                  style="stroke: var(--c-mute)"
                  stroke-width="1.3"
                  stroke-linecap="round"></path>
              </g>
            </svg>
            <span class="ts__z ts__z--1">z</span>
            <span class="ts__z ts__z--2">z</span>
            <span class="ts__z ts__z--3">Z</span>
          </div>
          <h3 class="ts__status t-condensed">{titleSponsor.status}<span class="ts__dots" aria-hidden="true">…</span></h3>
          <p class="ts__pitch">{titleSponsor.pitch}</p>
          <p class="ts__livery t-mono" aria-hidden="true">
            Bilal Racing presented by <span class="ts__blank"><span class="ts__caret"></span></span>
          </p>
          <button type="button" class="ts__cta" data-apply data-toast={titleSponsor.toast}>
            <span>{titleSponsor.cta}</span>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
          </button>
        </div>
      </li>
      {
        sponsors.map((s) => (
          <li class="wall__item" data-reveal="scale">
            <article class="sp" data-accent={s.accent} data-spot aria-labelledby={`sp-${s.id}`}>
              <div class="sp__inner">
              <div class="sp__badge" aria-hidden="true">
                <svg viewBox="0 0 240 120" set:html={varsToStyle(badges[s.id])} />
              </div>
              <div class="sp__text">
                <h3 class="visually-hidden" id={`sp-${s.id}`}>
                  {s.name}
                </h3>
                <p class="sp__cat t-mono">
                  {s.category}
                  {s.si && (
                    <span class="sp__si t-si" lang="si">
                      {sinhala[s.si].si}
                    </span>
                  )}
                </p>
                <p class="sp__line">{s.line}</p>
              </div>
              </div>
            </article>
          </li>
        ))
      }
    </ul>

    <!-- ============ Paddock Shop ============ -->
    <div class="shop" data-shop>
      <header class="shop__head">
        <div>
          <p class="t-mono shop__kicker" data-reveal="fade">Merchandise · Official · Unavailable</p>
          <h3 class="shop__title t-condensed" data-reveal="up">Paddock <em>Shop</em></h3>
          <p class="shop__sub" data-reveal="up">Free shipping to any box he can fit in. Returns accepted if he is not in them.</p>
        </div>
        <p class="shop__cart" data-reveal="fade">
          <svg viewBox="0 0 24 24" aria-hidden="true"
            ><path d="M3 4h2.5l2.2 11h10.6l2-8H7"></path><circle cx="9.5" cy="19" r="1.5"></circle><circle
              cx="16.5"
              cy="19"
              r="1.5"></circle></svg
          >
          <span class="t-mono">Cart <b data-cart-count>0</b></span>
          <span class="shop__tries t-mono" data-cart-tries hidden></span>
        </p>
      </header>

      <ul class="merch" data-reveal-stagger="90" role="list">
        {
          merch.map((m) => (
            <li class="merch__item" data-reveal="up">
              <article class="mc" data-accent={m.accent} data-tilt aria-labelledby={`mc-${m.id}`}>
                <div class="mc__art">
                  <svg viewBox="0 0 200 160" role="img" aria-label={m.art} set:html={varsToStyle(merchArt[m.id])} />
                  {m.tag && <span class="mc__tag t-mono">{m.tag}</span>}
                </div>
                <div class="mc__body">
                  <h4 class="mc__name" id={`mc-${m.id}`}>
                    {m.name}
                  </h4>
                  <p class="mc__blurb">{m.blurb}</p>
                  <div class="mc__foot">
                    <p class="mc__price t-condensed">
                      <span class="mc__cur t-mono">LKR</span>
                      {formatLKR(m.price)}
                    </p>
                    <button type="button" class="mc__add" data-add data-toast={soldOutToast}>
                      <svg viewBox="0 0 24 24" aria-hidden="true">
