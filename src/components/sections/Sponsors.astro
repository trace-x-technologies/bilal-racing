---
/**
 * 09 · Partners — a parody sponsor wall (original typographic SVG badges,
 * pointer-tracked spotlight + hover shine) and the Paddock Shop, where every
 * product tilts in 3D and every product is sold out.
 */
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { sponsors, titleSponsor, merch, soldOutToast, formatLKR } from '@/data/sponsors';
import { sinhala } from '@/data/lore';

/**
 * `fill="var(--x)"` in a presentation attribute is not honoured everywhere, so
 * move any var()-based fill/stroke into a single inline style per element.
 */
const varsToStyle = (svg: string) =>
  svg.replace(/<([a-zA-Z]+)((?:\s+[\w:-]+="[^"]*")*)\s*(\/?)>/g, (tag, name: string, attrs: string, selfClose: string) => {
    const decls: string[] = [];
    const rest = attrs.replace(/\s+(fill|stroke)="(var\([^"]*\))"/g, (_m, prop: string, value: string) => {
      decls.push(`${prop}:${value}`);
      return '';
    });
    if (!decls.length) return tag;
    return `<${name}${rest} style="${decls.join(';')}"${selfClose ? ' /' : ''}>`;
  });

/** Tiny paw print (pad + 4 toes) as SVG circles/ellipses, centred on x,y. */
const paw = (x: number, y: number, s = 1) =>
  `<g transform="translate(${x} ${y}) scale(${s})"><ellipse cx="0" cy="2.2" rx="3.1" ry="2.6"/><circle cx="-3.4" cy="-1.6" r="1.25"/><circle cx="-1.2" cy="-3.3" r="1.25"/><circle cx="1.2" cy="-3.3" r="1.25"/><circle cx="3.4" cy="-1.6" r="1.25"/></g>`;

const pawRow = Array.from({ length: 9 }, (_, i) => paw(44 + i * 19, 84, 0.9)).join('');

const badges: Record<string, string> = {
