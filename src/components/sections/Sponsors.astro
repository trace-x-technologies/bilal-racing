  machan: `
    <path d="M24 24 H84 V60 C84 82 68 94 54 100 C40 94 24 82 24 60 Z" fill="var(--b-a)" stroke="var(--c-gold)" stroke-width="2.5"/>
    <path d="M30 30 H78" stroke="var(--c-gold)" stroke-width="1.2" opacity="0.6"/>
    <text x="54" y="74" text-anchor="middle" class="bf-cond" font-size="32" fill="var(--c-gold)">MM</text>
    <text x="98" y="62" class="bf-wide" font-size="25" fill="var(--b-ink)">MACHAN</text>
    <text x="99" y="84" class="bf-mono" font-size="10" letter-spacing="7" fill="var(--c-gold)">MOTORS</text>`,
  tea: `
    <path d="M44 18 C40 26 48 30 44 38 M54 16 C50 24 58 28 54 36" stroke="var(--b-ink)" stroke-opacity="0.55" stroke-width="1.8" fill="none" stroke-linecap="round"/>
    <rect x="62" y="16" width="7" height="42" rx="3.5" fill="none" stroke="var(--b-ink)" stroke-width="1.8"/>
    <rect x="64.3" y="30" width="2.4" height="26" rx="1.2" fill="var(--c-red)"/>
    <path d="M18 48 H80 V60 C80 80 66 90 49 90 C32 90 18 80 18 60 Z" fill="var(--b-a)"/>
    <path d="M80 54 C94 54 94 74 78 76" stroke="var(--b-a)" stroke-width="4" fill="none"/>
    <path d="M12 96 H86" stroke="var(--b-ink)" stroke-width="2.4" stroke-linecap="round"/>
    <text x="100" y="52" class="bf-cond" font-size="35" fill="var(--b-ink)">CEYLON</text>
    <text x="101" y="71" class="bf-wide" font-size="10.4" letter-spacing="1.2" fill="var(--b-a)">TEA-MPERATURE</text>
    <text x="101" y="88" class="bf-mono" font-size="8.6" letter-spacing="6" fill="var(--b-ink)" opacity="0.75">CONTROL</text>`,
