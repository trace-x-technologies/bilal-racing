</style>

<script>
  import { gsap, ScrollTrigger, getLenis, prefersReducedMotion } from '@/scripts/motion';
  import { sound } from '@/scripts/audio';

  type PopMode = 'hover' | 'focus' | 'pinned';

  /* ---------- Info cards: Popover API + hover/focus enhancement ---------- */
  function setupPopovers(root: HTMLElement): void {
    if (!('showPopover' in HTMLElement.prototype)) return;
    const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-crew-token]'));
    const modes = new WeakMap<HTMLElement, PopMode>();
    let active: { btn: HTMLButtonElement; pop: HTMLElement } | null = null;
    let raf = 0;
    /** Token rect + viewport of the last place() — idle frames skip the rect reads/style writes. */
    let last = '';

    const place = (btn: HTMLElement, pop: HTMLElement) => {
      const r = btn.getBoundingClientRect();
      const vw = document.documentElement.clientWidth;
      const vh = window.innerHeight;
      const pw = pop.offsetWidth;
      const ph = pop.offsetHeight;
      const gap = 14;
      const navH = 64;
      let top = r.top - ph - gap;
      let placement = 'top';
      if (top < navH + 8) {
        top = r.bottom + gap;
        placement = 'bottom';
      }
      top = Math.min(Math.max(8, top), Math.max(8, vh - ph - 8));
      const cx = r.left + r.width / 2;
      const left = Math.min(Math.max(8, cx - pw / 2), Math.max(8, vw - pw - 8));
      pop.style.left = `${Math.round(left)}px`;
      pop.style.top = `${Math.round(top)}px`;
      pop.style.setProperty('--ax', `${Math.round(Math.min(Math.max(18, cx - left), pw - 18))}px`);
      if (pop.dataset.placement !== placement) pop.dataset.placement = placement;
    };

    // Tokens keep moving during the scrub catch-up and Lenis inertia after the wheel stops,
    // so keep following every frame — but only re-place when the token or viewport moved.
    const follow = () => {
      if (!active) return;
      const r = active.btn.getBoundingClientRect();
      if (r.bottom < 0 || r.top > window.innerHeight) {
        active.pop.hidePopover();
        return;
      }
      const key = `${r.left | 0},${r.top | 0},${r.width | 0},${window.innerWidth},${window.innerHeight}`;
      if (key !== last) {
        last = key;
        place(active.btn, active.pop);
      }
      raf = requestAnimationFrame(follow);
    };

    buttons.forEach((btn) => {
      const id = btn.getAttribute('popovertarget');
      const pop = id ? document.getElementById(id) : null;
      if (!pop) return;
      let showT = 0;
      let hideT = 0;

      const isOpen = () => pop.matches(':popover-open');
      const show = (mode: PopMode) => {
        window.clearTimeout(hideT);
        if (isOpen()) {
          if (modes.get(pop) !== 'pinned') modes.set(pop, mode);
          return;
        }
        modes.set(pop, mode);
        try {
          pop.showPopover();
        } catch {
          /* already open elsewhere / not connected */
        }
      };
      const hide = () => {
        if (isOpen()) pop.hidePopover();
      };
      const scheduleHide = () => {
        if (modes.get(pop) !== 'hover') return;
        window.clearTimeout(hideT);
        hideT = window.setTimeout(hide, 160);
      };

      btn.addEventListener('pointerenter', (e) => {
        if (e.pointerType !== 'mouse') return;
        window.clearTimeout(hideT);
        showT = window.setTimeout(() => show('hover'), 60);
      });
      btn.addEventListener('pointerleave', (e) => {
        if (e.pointerType !== 'mouse') return;
        window.clearTimeout(showT);
        scheduleHide();
      });
      pop.addEventListener('pointerenter', () => window.clearTimeout(hideT));
      pop.addEventListener('pointerleave', scheduleHide);

      btn.addEventListener('focus', () => {
        if (btn.matches(':focus-visible')) show('focus');
      });
      btn.addEventListener('blur', () => {
        if (modes.get(pop) === 'focus') hide();
      });
      // A click on a card that hover/focus already opened pins it instead of toggling it shut.
      btn.addEventListener('click', (e) => {
        const mode = modes.get(pop);
        if (isOpen() && (mode === 'hover' || mode === 'focus')) {
          e.preventDefault();
          modes.set(pop, 'pinned');
        }
      });

      pop.addEventListener('beforetoggle', (e) => {
        if ((e as ToggleEvent).newState !== 'open') return;
        if (!modes.has(pop)) modes.set(pop, 'pinned');
        requestAnimationFrame(() => place(btn, pop));
      });
      pop.addEventListener('toggle', (e) => {
        const open = (e as ToggleEvent).newState === 'open';
        btn.classList.toggle('is-active', open);
        if (open) {
          place(btn, pop);
          last = '';
          active = { btn, pop };
          cancelAnimationFrame(raf);
          raf = requestAnimationFrame(follow);
          sound.play('click', { volume: 0.4 });
        } else {
          modes.delete(pop);
          if (active?.pop === pop) {
            active = null;
            cancelAnimationFrame(raf);
          }
        }
      });
    });
  }

  /* ---------- Pit wall card tilt ---------- */
  function setupTilt(root: HTMLElement): void {
    if (prefersReducedMotion() || !window.matchMedia('(hover: hover) and (pointer: fine)').matches) return;
    root.querySelectorAll<HTMLElement>('.pw-card').forEach((card) => {
      let frame = 0;
      card.addEventListener('pointermove', (e) => {
        if (frame) return;
        frame = requestAnimationFrame(() => {
          frame = 0;
          const r = card.getBoundingClientRect();
          const px = (e.clientX - r.left) / r.width;
          const py = (e.clientY - r.top) / r.height;
          card.classList.add('is-tilting');
          card.style.setProperty('--ry', `${((px - 0.5) * 10).toFixed(2)}deg`);
          card.style.setProperty('--rx', `${((0.5 - py) * 8).toFixed(2)}deg`);
          card.style.setProperty('--gx', `${(px * 100).toFixed(1)}%`);
          card.style.setProperty('--gy', `${(py * 100).toFixed(1)}%`);
        });
      });
      card.addEventListener('pointerleave', () => {
        cancelAnimationFrame(frame);
        frame = 0;
        card.classList.remove('is-tilting');
        card.style.setProperty('--rx', '0deg');
        card.style.setProperty('--ry', '0deg');
      });
    });
  }

  /* ---------- Pause CSS loops offscreen ---------- */
  function setupInView(root: HTMLElement): void {
    const stage = root.querySelector('.stage');
    if (!stage || !('IntersectionObserver' in window)) return;
    root.dataset.inview = 'false';
    new IntersectionObserver(([entry]) => {
      root.dataset.inview = entry?.isIntersecting ? 'true' : 'false';
    }).observe(stage);
  }

  /* ---------- Scroll-scrubbed pit stop ---------- */
  function setupPitStop(root: HTMLElement): void {
    const scrolly = root.querySelector<HTMLElement>('.crew-scrolly');
    const stage = root.querySelector<HTMLElement>('.stage');
    if (!scrolly || !stage) return;

    const all = <T extends Element = HTMLElement>(sel: string, scope: ParentNode = stage) =>
      Array.from(scope.querySelectorAll<T>(sel));
    const one = <T extends Element = HTMLElement>(sel: string, scope: ParentNode = root) =>
      scope.querySelector<T>(sel);

    const slots = all('.tok-slot');
    const carRig = one('.car-rig', stage);
    const carLift = one('.car-lift', stage);
    const shadow = one('.car-shadow', stage);
    const oldWheels = all<SVGGElement>('.w-old');
    const newWheels = all<SVGGElement>('.w-new');
    const rings = all('.tok-ring');
    const lolliBoard = one('.lolli-board', stage);
    const speed = all('.speed i');
    const radio = one('.radio', stage);
    const frontJack = one('[data-id="front-jack"]', stage);
    const timerVal = one('.timer-val');
    const strike = one('.timer-strike');
    const pb = one('.pb-chip');
    const stamp = one('.stamp');
    const phaseItems = all('.phases li', root);
    const phaseNow = one('.phase-now');
    if (!carRig || !carLift || !shadow || !timerVal) return;

    // Stage size, read once per ScrollTrigger refresh (refreshInit runs before invalidated
    // function-based values are re-evaluated). Reading clientWidth inside every function value
    // forced a synchronous layout after each immediate-rendered fromTo.
    let stageW = stage.clientWidth;
    let stageH = stage.clientHeight;
    ScrollTrigger.addEventListener('refreshInit', () => {
      stageW = stage.clientWidth;
      stageH = stage.clientHeight;
    });
    const W = () => stageW;
    const H = () => stageH;
    const phaseAt = phaseItems.map((li) => Number(li.dataset.at) || 0);
    const phaseLabels = phaseItems.map((li) => li.querySelector('.ph-label')?.textContent ?? '');
    const STOP_START = 3.6;
    const STOP_END = 6.3;
    const CORRECTED = 8.8;
    const ALL_DONE = 9.5;

    gsap.set(oldWheels, { autoAlpha: 1 });
    timerVal.textContent = '0.0';

    const tl = gsap.timeline({
      defaults: { ease: 'none' },
      scrollTrigger: {
        trigger: scrolly,
        start: 'top 62%',
        end: 'bottom bottom',
        scrub: 0.7,
        invalidateOnRefresh: true,
      },
    });

    // 1 — crew sprint in from the pit wall (left edge), staggered.
    // Opacity, not autoAlpha: visibility:hidden would drop the tokens out of the Tab order
    // until the scrub reached them (see the focus catch-up below).
    const early = slots.filter((s) => !('late' in s.dataset));
    const late = slots.filter((s) => 'late' in s.dataset);
    const sprint = (slot: HTMLElement, at: number) => {
      const x = Number(slot.dataset.x) || 50;
      const y = Number(slot.dataset.y) || 50;
      tl.fromTo(
        slot,
        { x: () => -(x / 100) * W() - W() * 0.12, y: () => (y < 50 ? 1 : -1) * H() * 0.04, opacity: 0 },
        { x: 0, y: 0, opacity: 1, duration: 1.25, ease: 'power2.out' },
        at,
      );
      const body = slot.querySelector('.tok-body');
      if (body) {
        tl.fromTo(body, { rotation: -14 }, { rotation: 14, duration: 0.17, repeat: 5, yoyo: true, ease: 'sine.inOut' }, at);
        tl.to(body, { rotation: 0, duration: 0.3, ease: 'back.out(3)' }, at + 1.02);
      }
    };
    early.forEach((slot, i) => sprint(slot, 0.1 + i * 0.17));

    // 2 — car rolls into the box
    tl.fromTo(carRig, { y: () => H() * 0.92 }, { y: 0, duration: 1.3, ease: 'power3.out' }, 2.4);
    late.forEach((slot, i) => sprint(slot, 3.2 + i * 0.15));
    // Every token (incl. the late runners' wobble settle) has landed by here.
    const CREW_IN = 3.2 + late.length * 0.15 + 1.3;
    tl.addLabel('crewIn', CREW_IN);

    // 3 — jacks up (bigger + shadow spreads = lifted, top-down)
    tl.to(carLift, { scale: 1.045, x: -3, y: -6, duration: 0.35, ease: 'power2.out' }, 3.9);
    tl.to(shadow, { scale: 1.08, opacity: 0.5, duration: 0.35 }, 3.9);

    // 4 — tyres: hards off, Purrelli Paw softs on, wheel guns spin
    const side = (el: Element) => ((el as SVGElement).dataset.side === 'l' ? -46 : 46);
    tl.to(oldWheels, { x: (_i: number, el: Element) => side(el), autoAlpha: 0, duration: 0.55, ease: 'power2.in', stagger: 0.05 }, 4.3);
    // (staggered fromTo only immediate-renders its first target, so park the new set explicitly)
    gsap.set(newWheels, { x: (_i: number, el: Element) => side(el), autoAlpha: 0 });
    tl.to(newWheels, { x: 0, autoAlpha: 1, duration: 0.55, ease: 'power2.out', stagger: 0.05 }, 5.0);
    if (rings.length) {
      tl.fromTo(rings, { rotation: 0, autoAlpha: 0 }, { rotation: 540, autoAlpha: 1, duration: 1.25 }, 4.3);
      tl.to(rings, { autoAlpha: 0, duration: 0.2 }, 5.55);
    }

    // 5 — jacks down, lollipop flips, front jack steps aside, GO
    tl.to(carLift, { scale: 1, x: 0, y: 0, duration: 0.3, ease: 'power2.in' }, 5.7);
    tl.to(shadow, { scale: 1, opacity: 1, duration: 0.3 }, 5.7);
    if (frontJack) tl.to(frontJack, { x: () => W() * 0.16, duration: 0.35, ease: 'power2.out' }, 5.95);
    if (lolliBoard) tl.to(lolliBoard, { rotationY: 180, duration: 0.3, ease: 'power2.inOut' }, 6.0);

    // Timer runs from car-stop to release
    const clock = { t: 0 };
    tl.to(clock, { t: 2.9, duration: STOP_END - STOP_START }, STOP_START);
    if (pb) tl.fromTo(pb, { autoAlpha: 0, scale: 0.4 }, { autoAlpha: 1, scale: 1, duration: 0.3, ease: 'back.out(3)' }, STOP_END);

    // 6 — launch out of the box
    tl.to(carRig, { y: () => -H() * 0.95, duration: 0.6, ease: 'power3.in' }, 6.4);
    if (speed.length) {
      gsap.set(speed, { autoAlpha: 0, scaleY: 0.3 });
      tl.to(speed, { autoAlpha: 1, scaleY: 1, duration: 0.3, stagger: 0.03 }, 6.6);
      tl.to(speed, { autoAlpha: 0, duration: 0.3 }, 7.05);
    }

    // 7 — box, box: the owner radios it straight back in (he wants to sit in the box)
    tl.to(carRig, { y: 0, duration: 0.9, ease: 'power2.out' }, 7.5);
    if (lolliBoard) tl.to(lolliBoard, { rotationY: 360, duration: 0.3, ease: 'power2.inOut' }, 8.3);
    if (radio) {
      tl.fromTo(
        radio,
        { autoAlpha: 0, scale: 0.5, y: 12 },
        { autoAlpha: 1, scale: 1, y: 0, duration: 0.3, ease: 'back.out(2.2)' },
        8.3,
      );
    }
    if (frontJack) tl.to(frontJack, { x: 0, duration: 0.35, ease: 'power2.out' }, 8.5);
    if (strike) tl.fromTo(strike, { scaleX: 0 }, { scaleX: 1, duration: 0.3, ease: 'power2.out' }, CORRECTED);
    if (stamp) {
      tl.fromTo(
        stamp,
        { autoAlpha: 0, scale: 2.1, rotation: -30 },
        // GSAP folds the CSS `rotate: -7deg` into its own rotation, so land on -7 explicitly
        { autoAlpha: 1, scale: 1, rotation: -7, duration: 0.35, ease: 'power4.in' },
        CORRECTED + 0.3,
      );
    }
    tl.to({}, { duration: 0.9 }, ALL_DONE);

    // HUD state (digits, phase list, timer colour) derived from timeline time. Called from the
    // timeline's onUpdate AND after every ScrollTrigger refresh, because refresh restores the
    // timeline's progress with callbacks suppressed.
    let lastPhase = -2;
    let lastTimer = '';
    let lastDigits = '';
    const hud = () => {
      const t = tl.time();
      const digits = clock.t.toFixed(1);
      if (digits !== lastDigits) {
        lastDigits = digits;
        timerVal.textContent = digits;
      }
      let phase = 0;
      phaseAt.forEach((at, i) => {
        if (t >= at) phase = i;
      });
      if (t >= ALL_DONE) phase = phaseAt.length;
      if (phase !== lastPhase) {
        if (phase > lastPhase && lastPhase >= 0) {
          if (phase === 4) sound.play('rev', { volume: 0.5 });
          if (phase === 5) sound.play('meow', { volume: 0.5 });
        }
        lastPhase = phase;
        phaseItems.forEach((li, i) => {
          li.dataset.state = i < phase ? 'done' : i === phase ? 'active' : '';
        });
        if (phaseNow) {
          phaseNow.textContent =
            phase >= phaseItems.length
              ? 'Stop complete · world record'
              : `${String(phase + 1).padStart(2, '0')} / ${phaseLabels[phase]}`;
        }
        root.dataset.phase = String(phase);
      }
      const timer = t < STOP_START ? 'idle' : t < STOP_END ? 'run' : t < CORRECTED ? 'pb' : 'corrected';
      if (timer !== lastTimer) {
        lastTimer = timer;
        root.dataset.timer = timer;
      }
    };
    tl.eventCallback('onUpdate', hud);
    ScrollTrigger.addEventListener('refresh', hud);
    hud();

    // Keyboard users can Tab onto a token before the scrub has run it in (it would be
    // off-stage and transparent). Jump the page to the point where the crew is in formation
    // and settle the scrub on the same frame, so focus and its info card land on a visible token.
    const formation = one('.formation', stage);
    formation?.addEventListener('focusin', (e) => {
      const target = e.target as HTMLElement | null;
      if (!target?.matches(':focus-visible') || tl.time() >= CREW_IN) return;
      const st = tl.scrollTrigger;
      if (!st) return;
      const y = st.start + (st.end - st.start) * (CREW_IN / tl.duration());
      const lenis = getLenis();
      if (lenis) lenis.scrollTo(y, { immediate: true });
      else window.scrollTo({ top: y, behavior: 'instant' });
      ScrollTrigger.update(); // bumps ScrollTrigger's scroll cache, then updates every trigger
      st.getTween()?.progress(1);
    });
  }

  function initCrew(): void {
    const root = document.querySelector<HTMLElement>('#crew');
    if (!root) return;
    // The crew sheet adds ~740px (desktop) / ~1060px (phone) when opened: every trigger below
    // #crew (gallery batch, calendar, lights out, footer) must re-measure, reduced motion or not.
    root
      .querySelector<HTMLDetailsElement>('details.sheet')
      ?.addEventListener('toggle', () => requestAnimationFrame(() => ScrollTrigger.refresh()));
    setupPopovers(root);
    setupTilt(root);
    setupInView(root);
    if (!prefersReducedMotion()) setupPitStop(root);
  }

  initCrew();
</script>
