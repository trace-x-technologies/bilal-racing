---
/**
 * 05 · Paddock — "Paddock Pass" photo wall of the gang's real photos.
 *
 * - Featured: the official team photo as a wide, double-lanyard season pass.
 * - The rest: a masonry wall (CSS multi-column) where every frame takes the
 *   photo's TRUE aspect ratio, read from its ImageMetadata — portrait shots
 *   hang as lanyard accreditation passes, landscape shots are taped polaroids.
 * - Motion: tiles fly in with 3D depth (GSAP batch); photos drift inside their
 *   frames and polaroids "develop" via CSS scroll-driven animations
 *   (progressive enhancement; static where unsupported / reduced motion).
 * - Click / Enter opens a <dialog> lightbox that morphs out of the tile with
 *   the View Transitions API (same aspect on both ends → a clean morph), shows
 *   the full image at its true aspect with the caption as a stewards' decision,
 *   arrow-key / swipe navigation, Esc to close, focus trap + restore, lockScroll().
 *
 * Captions and alt text come only from data/photos.ts (never name anyone in a
 * group photo). All images are lazy, responsive AVIF/WebP via astro:assets.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import PhotoSlot from '@/components/ui/PhotoSlot.astro';
import Emblem from '@/components/ui/Emblem.astro';
import { gallery, resolvePhoto } from '@/data/photos';
import { sinhala, team } from '@/data/lore';

type Kind = 'pass' | 'polaroid';

/** The wide "season pass" at the top of the wall. */
const FEATURED_ID = 'team-pool';

/** Pass zone + stamp per photo, chosen to fit each shot (not cycled by position). 'All areas*'
 *  pairs with the wall footnote ("* Except the kitchen"). */
const LABELS: Record<string, { zone: string; stamp: string }> = {
  'team-pool': { zone: 'All areas*', stamp: 'Verified' },
  helmets: { zone: 'Pit lane', stamp: 'Helmets on' },
  'night-celebration': { zone: 'Night shift', stamp: 'Night race' },
  'wedding-suits': { zone: 'Black-tie grid', stamp: 'Dress code met' },
  'road-trip': { zone: 'Recon lap', stamp: 'Exhibit A' },
  'pool-strategy': { zone: 'Strategy room', stamp: 'Certified' },
  'garage-five': { zone: 'Garage', stamp: 'Approved' },
  'wedding-street': { zone: 'Formation lap', stamp: 'Approved' },
  cycling: { zone: 'Fitness bay', stamp: 'Verified' },
  'wedding-hotel': { zone: 'Hospitality', stamp: 'Reference' },
  'parc-ferme': { zone: 'Nap room', stamp: 'Impounded' },
  hospitality: { zone: 'Snack bay', stamp: 'P1 · Snacks' },
  'wedding-laughs': { zone: 'Photo lab', stamp: 'Exhibit B' },
  'shed-selfie': { zone: 'Rain delay', stamp: 'Certified' },
  'wedding-bouquet': { zone: 'Podium (mirror)', stamp: 'Caught' },
};
const LABEL_FALLBACK = { zone: 'Paddock', stamp: 'Verified' };
const ACCENTS = ['gold', 'saffron', 'teal', 'purple'];
const TILTS = [-1.8, 1.3, 2, -1.4, 2.2, -1.1, 0.8, -2.2];

/** Never ask sharp to upscale: clamp each width to the original, dedupe. */
const fit = (widths: number[], src: ImageMetadata | null) =>
  src ? [...new Set(widths.map((w) => Math.min(w, src.width)))].sort((a, b) => a - b) : widths;

const total = gallery.length;
const pad = (n: number) => String(n).padStart(2, '0');

const items = gallery.map((p, i) => {
  const src = resolvePhoto(p).src;
  const w = src?.width ?? 4;
  const h = src?.height ?? 3;
  const ar = w / h;
  const portrait = ar < 0.95;
  const kind: Kind = portrait ? 'pass' : 'polaroid';
  return {
    p,
    i,
    src,
    no: pad(i + 1),
    kind,
    /** Exact aspect for CSS (`aspect-ratio`) and as a number for width maths. */
    arCss: `${w} / ${h}`,
    arNum: ar.toFixed(4),
    zone: (LABELS[p.id] ?? LABEL_FALLBACK).zone,
    stamp: (LABELS[p.id] ?? LABEL_FALLBACK).stamp,
    accent: ACCENTS[i % ACCENTS.length],
    tilt: TILTS[i % TILTS.length],
    /** Lightbox: landscape is width-bound, portrait is height-bound (see .lb-photo). */
    lbSizes: portrait
      ? `(min-width: 60rem) calc((100vh - 12rem) * ${ar.toFixed(3)}), calc(50vh * ${ar.toFixed(3)})`
      : '(min-width: 60rem) calc(100vw - 38rem), 94vw',
  };
});

const featured = items.find((t) => t.p.id === FEATURED_ID) ?? items[0];
const wall = items.filter((t) => t !== featured);

const TILE_WIDTHS = [360, 640, 960];
const TILE_SIZES = '(min-width: 82.5rem) 290px, (min-width: 64rem) 22vw, (min-width: 40rem) 30vw, 45vw';
const FEATURE_WIDTHS = [640, 960, 1400];
const FEATURE_SIZES = '(min-width: 82.5rem) 860px, (min-width: 64rem) 64vw, 94vw';
const LB_WIDTHS = [640, 960, 1400, 2000];
---

<section class="section paddock" id="paddock" aria-labelledby="paddock-title">
  <div class="bg-marquee" aria-hidden="true">
    <p class="bg-track bg-track-a t-condensed">Paddock pass · All access · Paddock pass · All access · Paddock pass ·</p>
    <p class="bg-track bg-track-b t-condensed">Exhibit A · Stewards approved · Exhibit A · Stewards approved ·</p>
  </div>

  <div class="container">
    <SectionHeading
      index="05"
      kicker="Paddock"
      id="paddock-title"
      title="Paddock <em>pass</em>"
      si={sinhala.ammo.si}
      lead={`Accredited evidence from the paddock: ${total} photos, every one checked by the stewards, laminated and napped on by the owner. Tap any pass to open the full document.`}
    />

    {
      featured && (
        <div class="tile feature" style={`--tilt: -0.5deg; --accent: var(--c-gold); --ar: ${featured.arCss};`}>
          <span class="lanyard lanyard-l" aria-hidden="true">
            <span class="strap strap-l" />
            <span class="strap strap-r" />
            <span class="clip" />
          </span>
          <span class="lanyard lanyard-r" aria-hidden="true">
            <span class="strap strap-l" />
            <span class="strap strap-r" />
            <span class="clip" />
          </span>

          <figure class="card pass feature-card" data-tilt="0.35">
            <div class="pass-head" aria-hidden="true">
              <Emblem size="1.9em" title="" />
              <span class="pass-brand">
                <span class="pass-team">Bilal Racing</span>
                <span class="pass-type t-mono">Season pass · {team.founded}</span>
              </span>
              <span class="pass-no t-mono">09-{featured.no}</span>
            </div>

            <div class="feature-body">
              <div class="tile-photo">
                <div class="tile-photo-inner" style={`--focal: ${featured.p.focal ?? '50% 50%'}`}>
                  {featured.src ? (
                    <Picture
                      src={featured.src}
                      alt={featured.p.alt}
                      formats={['avif', 'webp']}
                      widths={fit(FEATURE_WIDTHS, featured.src)}
                      sizes={FEATURE_SIZES}
                      loading="lazy"
                      decoding="async"
                    />
                  ) : (
                    <PhotoSlot photo={featured.p} sizes={FEATURE_SIZES} widths={FEATURE_WIDTHS} />
                  )}
                </div>
              </div>

              <figcaption class="feature-side">
                <p class="feature-kicker t-mono" aria-hidden="true">
                  Official team photo
                </p>
                <p class="feature-title t-condensed" aria-hidden="true">
                  Class of {team.founded}
                </p>
                <p class="feature-caption">{featured.p.caption}</p>
                <p class="feature-stamp t-mono" aria-hidden="true">
                  <span>Stewards · Approved</span>
                  <span class="feature-stamp-big t-condensed">9/9</span>
                  <span>Lives remaining</span>
                </p>
                <dl class="feature-meta t-mono" aria-hidden="true">
                  <div>
                    <dt>Zone</dt>
                    <dd>{featured.zone}</dd>
                  </div>
                  <div>
                    <dt>Valid</dt>
                    <dd>All nine lives</dd>
                  </div>
                  <div>
                    <dt>Issued by</dt>
                    <dd>The owner (asleep)</dd>
                  </div>
                </dl>
                <div class="pass-foot" aria-hidden="true">
                  <span class="barcode" />
                  <span class="holo t-mono">
                    All
                    <br />
                    access
                  </span>
                </div>
              </figcaption>
            </div>

            <button type="button" class="card-hit" data-lb-open={featured.i} aria-haspopup="dialog">
              <span class="visually-hidden">
                Open photo {featured.no} of {total}: {featured.p.alt}
              </span>
            </button>
          </figure>
        </div>
      )
    }

    <ul class="wall" role="list">
      {
        wall.map((t) => (
          <li
            class:list={['tile', `kind-${t.kind}`]}
            style={`--tilt: ${t.tilt}deg; --accent: var(--c-${t.accent}); --ar: ${t.arCss};`}
            data-index={t.i}
          >
            {t.kind === 'pass' ? (
              <span class="lanyard" aria-hidden="true">
                <span class="strap strap-l" />
                <span class="strap strap-r" />
                <span class="clip" />
              </span>
            ) : (
              <span class="tape" aria-hidden="true" />
            )}

            <figure class:list={['card', t.kind]}>
              {t.kind === 'pass' && (
                <div class="pass-head" aria-hidden="true">
                  <Emblem size="1.9em" title="" />
                  <span class="pass-brand">
                    <span class="pass-team">Bilal Racing</span>
                    <span class="pass-type t-mono">Paddock pass</span>
                  </span>
                  <span class="pass-no t-mono">09-{t.no}</span>
                </div>
              )}

              <div class="tile-photo">
                <div class="tile-photo-inner" style={`--focal: ${t.p.focal ?? '50% 50%'}`}>
                  {t.src ? (
                    <Picture
                      src={t.src}
                      alt={t.p.alt}
                      formats={['avif', 'webp']}
                      widths={fit(TILE_WIDTHS, t.src)}
                      sizes={TILE_SIZES}
                      loading="lazy"
                      decoding="async"
                    />
                  ) : (
                    <PhotoSlot photo={t.p} sizes={TILE_SIZES} widths={TILE_WIDTHS} />
                  )}
                </div>
                {t.kind === 'polaroid' && <span class="pol-develop" aria-hidden="true" />}
              </div>

              {t.kind === 'pass' ? (
                <figcaption class="pass-info">
                  <p class="pass-zone" aria-hidden="true">
                    <span class="t-mono">Zone</span> {t.zone}
                  </p>
                  <p class="pass-caption">{t.p.caption}</p>
                  <div class="pass-foot" aria-hidden="true">
                    <span class="barcode" />
                    <span class="holo t-mono">
                      All
                      <br />
                      access
                    </span>
                  </div>
                </figcaption>
              ) : (
                <figcaption class="pol-info">
                  <p class="pol-caption">{t.p.caption}</p>
                  <div class="pol-foot" aria-hidden="true">
                    <span class="pol-meta t-mono">
                      BR·09 — {t.no}/{pad(total)}
                    </span>
                    <span class="pol-stamp t-mono">{t.stamp}</span>
                  </div>
                </figcaption>
              )}

              <button type="button" class="card-hit" data-lb-open={t.i} aria-haspopup="dialog">
                <span class="visually-hidden">
                  Open photo {t.no} of {total}: {t.p.alt}
                </span>
              </button>
            </figure>
          </li>
        ))
      }
    </ul>

    <p class="wall-foot t-mono" data-reveal="fade">
      * Except the kitchen. Passes may be revoked once the owner wakes up.
    </p>
  </div>

  <!-- ================= Lightbox ================= -->
  <dialog class="lb" aria-label="Paddock photo viewer" data-lenis-prevent>
    <div class="lb-shell">
      <header class="lb-top">
        <p class="lb-count t-mono" aria-hidden="true">
          <span class="lb-i">01</span> / {pad(total)}
        </p>
        <p class="lb-title t-mono" aria-hidden="true">
          <Emblem size="1.3em" title="" />
          Stewards’ document
        </p>
        <button type="button" class="lb-btn lb-close" aria-label="Close photo viewer" autofocus>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6 L18 18 M18 6 L6 18"></path></svg>
        </button>
      </header>

      <div class="lb-stage">
        <button type="button" class="lb-btn lb-nav lb-prev" aria-label="Previous photo">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5 L8 12 L15 19"></path></svg>
        </button>

        <ul class="lb-slides" role="list">
          {
            items.map((t) => (
              <li
                class="lb-slide"
                data-index={t.i}
                hidden={t.i !== 0}
                style={`--accent: var(--c-${t.accent}); --ar: ${t.arCss}; --arn: ${t.arNum};`}
              >
                <figure class="lb-fig">
                  <div class="lb-photo" data-ph={t.src ? undefined : ''}>
                    {t.src ? (
                      <Picture
                        src={t.src}
                        alt={t.p.alt}
                        formats={['avif', 'webp']}
                        widths={fit(LB_WIDTHS, t.src)}
                        sizes={t.lbSizes}
                        loading="lazy"
                        decoding="async"
                      />
                    ) : (
                      <PhotoSlot photo={t.p} sizes="(min-width: 960px) 65vw, 94vw" widths={LB_WIDTHS} />
                    )}
                  </div>
                  <figcaption class="doc">
                    <p class="doc-head t-mono">
                      <span>Decision</span>
                      <span>Doc 09-{t.no}</span>
                    </p>
                    <dl class="doc-grid">
                      <div class="doc-row doc-from">
                        <dt class="t-mono">From</dt>
                        <dd>The Stewards</dd>
                      </div>
                      <div class="doc-row doc-to">
                        <dt class="t-mono">To</dt>
                        <dd>Bilal Racing &amp; friends</dd>
                      </div>
                      <div class="doc-row">
                        <dt class="t-mono">Subject</dt>
                        <dd>{t.p.alt}</dd>
                      </div>
                      <div class="doc-row doc-decision">
                        <dt class="t-mono">Finding</dt>
                        <dd>{t.p.caption}</dd>
                      </div>
                    </dl>
                    <p class="doc-foot t-mono">
                      <span>Clearance: {t.zone}</span>
                      <span class="doc-stamp">{t.stamp}</span>
                    </p>
                  </figcaption>
                </figure>
              </li>
            ))
          }
        </ul>

        <button type="button" class="lb-btn lb-nav lb-next" aria-label="Next photo">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5 L16 12 L9 19"></path></svg>
        </button>
      </div>

      <footer class="lb-foot" aria-hidden="true">
        <span class="lb-pips">
          {items.map((t) => <i data-pip={t.i} class:list={{ on: t.i === 0 }} />)}
        </span>
        <span class="lb-hint t-mono">← → browse · swipe · Esc leaves the paddock</span>
      </footer>
      <p class="lb-live visually-hidden" aria-live="polite"></p>
    </div>
  </dialog>
</section>

<style>
  .paddock {
    overflow-x: clip;
    view-timeline: --pp-view block;
  }

  /* ================= Background marquee (CSS scroll-driven) ================= */
  .bg-marquee {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: clip;
    pointer-events: none;
  }

  .bg-track {
    position: absolute;
    left: 0;
    white-space: nowrap;
    font-family: var(--f-display);
    font-weight: 900;
    font-size: clamp(6rem, 3rem + 14vw, 19rem);
    line-height: 0.8;
    text-transform: uppercase;
    color: transparent;
    -webkit-text-stroke: 1px rgb(255 255 255 / 0.06);
  }

  .bg-track-a {
    top: 18%;
  }

  .bg-track-b {
    top: 62%;
    translate: -30% 0;
    -webkit-text-stroke-color: rgb(255 197 46 / 0.07);
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .bg-track-a {
        animation: pp-drift-a linear both;
      }

      .bg-track-b {
        animation: pp-drift-b linear both;
      }

      /* separate, more specific rules: Lightning CSS would fold these into the shorthand */
      .bg-marquee .bg-track-a,
      .bg-marquee .bg-track-b {
        animation-timeline: --pp-view;
      }
    }
  }

  @keyframes pp-drift-a {
    from {
      transform: translateX(5%);
    }
    to {
      transform: translateX(-45%);
    }
  }

  @keyframes pp-drift-b {
    from {
      transform: translateX(-35%);
    }
    to {
      transform: translateX(10%);
    }
  }

  /* ================= Tiles (shared) ================= */
  .tile {
    position: relative;
    rotate: var(--tilt);
    transform-origin: 50% 0;
    transition: rotate 0.6s var(--ease-out-back);
  }

  @media (hover: hover) and (pointer: fine) {
    .tile:hover,
    .tile:focus-within {
      rotate: calc(var(--tilt) * -0.4);
      z-index: 2;
    }
  }

  .card {
    --rx: 0deg;
    --ry: 0deg;
    --mx: 0.5;
    --my: 0.5;
    position: relative;
    container-type: inline-size;
    display: flex;
    flex-direction: column;
    margin: 0;
    transition:
      transform 0.6s var(--ease-out-expo),
      box-shadow 0.6s var(--ease-out-expo);
    box-shadow:
      0 1.5rem 3rem -1.25rem rgb(0 0 0 / 0.9),
      0 0.25rem 0.5rem rgb(0 0 0 / 0.4);
  }

  .tile:hover .card {
    /* 3D only while hovered, so idle passes don't each hold a compositor layer */
    transform: perspective(60rem) rotateX(var(--rx)) rotateY(var(--ry));
  }

  .card:global(.is-tilting) {
    transition:
      transform 0.12s linear,
      box-shadow 0.6s var(--ease-out-expo);
  }

  .tile:hover .card,
  .tile:focus-within .card {
    box-shadow:
      0 2.5rem 4.5rem -1.5rem rgb(0 0 0 / 0.95),
      0 0 0 1px color-mix(in oklab, var(--accent) 60%, transparent);
  }

  .card::after {
    /* laminate sheen that follows the pointer */
    content: '';
    position: absolute;
    inset: 0;
    z-index: 3;
    border-radius: inherit;
    pointer-events: none;
    background: linear-gradient(
      115deg,
      transparent 30%,
      rgb(255 255 255 / 0.12) 45%,
      rgb(255 255 255 / 0.02) 55%,
      transparent 65%
    );
    background-size: 260% 100%;
    background-position: calc(var(--mx) * 100%) 0;
    opacity: 0.45;
    transition: opacity var(--dur-med);
  }

  .tile:hover .card::after {
    opacity: 1;
  }

  .card-hit {
    position: absolute;
    inset: 0;
    z-index: 4;
    border-radius: inherit;
    cursor: zoom-in;
  }

  .card-hit:focus-visible {
    outline: 3px solid var(--c-gold);
    outline-offset: 4px;
  }

  /* ---- the photo frame: exactly the photo's own aspect ratio ---- */
  .tile-photo {
    position: relative;
    overflow: clip;
    aspect-ratio: var(--ar, 4 / 3);
    background: var(--c-graphite);
    flex: none;
  }

  .tile-photo-inner {
    position: absolute;
    inset: 0;
  }

  .tile-photo-inner :global(picture) {
    position: absolute;
    inset: 0;
    display: block;
  }

  .tile-photo-inner :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 0;
    object-fit: cover;
    object-position: var(--focal, 50% 50%);
  }

  .tile-photo :global(.photo-placeholder) {
    min-height: 0;
    height: 100%;
    border: 0;
  }

  /* photos drift inside their frames as you scroll (compositor-only, CSS scroll-driven) */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .tile-photo-inner {
        animation: pp-inframe linear both;
      }

      .tile .tile-photo-inner {
        animation-timeline: view();
        animation-range: cover 0% cover 100%;
      }
    }
  }

  @keyframes pp-inframe {
    from {
      transform: scale(1.05) translateY(-2%);
    }
    to {
      transform: scale(1.05) translateY(2%);
    }
  }

  /* ================= Pass (lanyard accreditation) ================= */
  .pass {
    padding: 0.5rem 0.5rem 0.65rem;
    border-radius: clamp(0.6rem, 5cqi, 1rem);
    background:
      radial-gradient(120% 60% at 100% 0%, color-mix(in oklab, var(--accent) 16%, transparent), transparent 60%),
      linear-gradient(165deg, var(--c-steel), var(--c-graphite) 30%, var(--c-asphalt));
    border: 1px solid var(--c-line-strong);
    gap: 0.45rem;
  }

  .pass::before {
    /* punched slot for the clip */
    content: '';
    position: absolute;
    top: 0.45rem;
    left: 50%;
    width: 18%;
    height: 0.4rem;
    translate: -50% 0;
    border-radius: 99px;
    background: var(--c-carbon);
    box-shadow: inset 0 1px 2px rgb(0 0 0 / 0.8);
    z-index: 2;
  }

  .pass-head {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 0.75rem;
    padding: 0.4rem 0.5rem;
    border-radius: clamp(0.35rem, 3cqi, 0.6rem);
    background: var(--accent);
    color: var(--c-carbon);
    font-size: clamp(0.56rem, 5.5cqi, 0.95rem);
  }

  .pass-head :global(.emblem) {
    flex: none;
  }

  .pass-brand {
    display: grid;
    line-height: 1;
    min-width: 0;
  }

  .pass-team {
    font-weight: 900;
    text-transform: uppercase;
    font-variation-settings: 'wdth' 62;
    font-stretch: 62%;
    font-size: 1.15em;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  .pass-type {
    font-size: 0.58em;
    font-weight: 700;
    letter-spacing: 0.12em;
    white-space: nowrap;
  }

  .pass-no {
    margin-left: auto;
    font-size: 0.6em;
    font-weight: 700;
    letter-spacing: 0.06em;
    padding: 0.2em 0.4em;
    border: 1.5px solid currentColor;
    border-radius: 0.3em;
    white-space: nowrap;
  }

  .pass .tile-photo {
    border-radius: clamp(0.3rem, 3cqi, 0.55rem);
  }

  .pass-info {
    display: grid;
    gap: 0.4rem;
  }

  .pass-zone {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.4rem;
    font-size: clamp(0.6rem, 5cqi, 0.8rem);
    font-weight: 700;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    line-height: 1.2;
  }

  .pass-zone .t-mono {
    font-size: 0.8em;
    color: var(--c-mute);
  }

  .pass-caption {
    font-size: clamp(0.74rem, 5.6cqi, 0.98rem);
    line-height: 1.35;
    color: var(--c-chalk);
    text-wrap: pretty;
  }

  .pass-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-top: 0.15rem;
  }

  .barcode {
    flex: 1;
    max-width: 62%;
    height: clamp(0.9rem, 9cqi, 1.6rem);
    background: repeating-linear-gradient(
      90deg,
      var(--c-chalk) 0 2px,
      transparent 2px 4px,
      var(--c-chalk) 4px 5px,
      transparent 5px 8px,
      var(--c-chalk) 8px 11px,
      transparent 11px 12px
    );
    opacity: 0.7;
  }

  .holo {
    display: grid;
    place-items: center;
    width: clamp(1.9rem, 17cqi, 3rem);
    aspect-ratio: 1;
    border-radius: 50%;
    font-size: clamp(0.34rem, 2.6cqi, 0.5rem);
    font-weight: 700;
    line-height: 1.1;
    text-align: center;
    color: var(--c-carbon);
    background: conic-gradient(
      from calc(var(--mx) * 360deg),
      var(--c-teal),
      var(--c-purple),
      var(--c-gold),
      var(--c-saffron),
      var(--c-teal)
    );
    box-shadow:
      inset 0 0 0 2px rgb(255 255 255 / 0.4),
      0 0 1rem rgb(179 107 255 / 0.25);
  }

  /* ---- lanyard ---- */
  /* hangs inside its item's top padding, so it never drapes over the card above */
  .lanyard {
    position: absolute;
    left: 50%;
    top: 0;
    width: clamp(2.2rem, 22%, 3.4rem);
    height: 3.6rem;
    translate: -50% 0;
    z-index: 3;
    pointer-events: none;
  }

  .strap {
    position: absolute;
    left: 50%;
    bottom: 0.7rem;
    width: 0.8rem;
    height: 3.4rem;
    margin-left: -0.4rem;
    border-radius: 1px;
    background:
      repeating-linear-gradient(to bottom, transparent 0 5px, rgb(0 0 0 / 0.28) 5px 7px),
      linear-gradient(
        90deg,
        color-mix(in oklab, var(--accent) 65%, black),
        var(--accent) 40%,
        color-mix(in oklab, var(--accent) 75%, black)
      );
    -webkit-mask-image: linear-gradient(to top, #000 45%, transparent);
    mask-image: linear-gradient(to top, #000 45%, transparent);
    transform-origin: 50% 100%;
    box-shadow: 0 0 0.5rem rgb(0 0 0 / 0.4);
  }

  .strap-l {
    rotate: -17deg;
  }

  .strap-r {
    rotate: 17deg;
  }

  .clip {
    position: absolute;
    left: 50%;
    bottom: 0;
    width: 42%;
    height: 1.35rem;
    translate: -50% 0;
    border-radius: 0.3rem 0.3rem 0.5rem 0.5rem;
    background: linear-gradient(90deg, var(--c-faint), var(--c-chalk) 45%, var(--c-mute) 70%, var(--c-faint));
    box-shadow:
      0 2px 4px rgb(0 0 0 / 0.6),
      inset 0 -3px 0 rgb(0 0 0 / 0.25);
  }

  .clip::before {
    content: '';
    position: absolute;
    left: 50%;
    top: -0.55rem;
    width: 0.8rem;
    height: 0.8rem;
    translate: -50% 0;
    border-radius: 50%;
    border: 2px solid var(--c-mute);
  }

  /* ================= Polaroid ================= */
  .polaroid {
    padding: 0.55rem 0.55rem 0.6rem;
    border-radius: 0.25rem;
    background: linear-gradient(170deg, var(--c-chalk), color-mix(in oklab, var(--c-chalk) 88%, var(--c-gold)));
    color: var(--c-carbon);
    gap: 0.5rem;
  }

  .polaroid .tile-photo {
    border-radius: 2px;
    box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.2);
  }

  /* the print "develops" as it scrolls in (opacity-only overlay) */
  .pol-develop {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    opacity: 0;
    background:
      radial-gradient(80% 70% at 40% 40%, rgb(255 244 214 / 0.55), transparent 75%),
      linear-gradient(160deg, rgb(236 226 205), rgb(196 184 160));
    mix-blend-mode: normal;
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .pol-develop {
        animation: pp-develop linear both;
      }

      .tile .pol-develop {
        animation-timeline: view();
        animation-range: entry 10% cover 38%;
      }
    }
  }

  @keyframes pp-develop {
    from {
      opacity: 0.92;
    }
    to {
      opacity: 0;
    }
  }

  .pol-info {
    display: grid;
    gap: 0.4rem;
  }

  .pol-caption {
    font-size: clamp(0.74rem, 5.6cqi, 1.02rem);
    font-weight: 600;
    line-height: 1.3;
    font-style: italic;
    letter-spacing: -0.005em;
    text-wrap: pretty;
  }

  .pol-meta {
    font-size: clamp(0.46rem, 3.4cqi, 0.6rem);
    color: color-mix(in oklab, var(--c-carbon) 70%, var(--c-chalk));
  }

  /* serial number left, stewards' stamp right: the stamp lives in the cream strip, off the faces.
     Neither label wraps its text; on a narrow phone polaroid a long stamp drops under the serial,
     still right-aligned. */
  .pol-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.35rem 0.5rem;
  }

  .pol-foot > * {
    white-space: nowrap;
  }

  .pol-stamp {
    margin-left: auto;
    position: static;
    padding: 0.25em 0.5em;
    border: 2px solid currentColor;
    border-radius: 0.25rem;
    color: color-mix(in oklab, var(--c-red) 80%, var(--c-carbon));
    background: none;
    font-size: clamp(0.42rem, 3.6cqi, 0.64rem);
    font-weight: 700;
    rotate: -6deg;
  }

  .tape {
    position: absolute;
    top: 0.3rem;
    left: 50%;
    z-index: 5;
    width: clamp(3.5rem, 32%, 6rem);
    height: 1.5rem;
    translate: -50% 0;
    rotate: calc(var(--tilt) * -2.2);
    background: linear-gradient(90deg, rgb(255 255 255 / 0.22), rgb(255 255 255 / 0.36), rgb(255 255 255 / 0.2));
    backdrop-filter: blur(1px);
    clip-path: polygon(3% 0, 97% 4%, 100% 50%, 96% 100%, 2% 96%, 0 50%);
    box-shadow: 0 1px 3px rgb(0 0 0 / 0.3);
    pointer-events: none;
  }

  /* ================= Featured season pass ================= */
  .feature {
    margin: var(--space-5) 0 var(--space-7);
    padding-top: 2.85rem;
    transform-origin: 50% 0;
  }

  .feature .lanyard-l {
    left: 22%;
  }

  .feature .lanyard-r {
    left: 78%;
  }

  .feature-card {
    padding: 0.6rem 0.6rem 0.75rem;
    gap: 0.6rem;
    border-color: color-mix(in oklab, var(--c-gold) 40%, transparent);
  }

  .feature-card .pass-head {
    font-size: clamp(0.8rem, 0.7rem + 0.5vw, 1.05rem);
  }

  .feature-body {
    display: grid;
    gap: 0.75rem;
  }

  .feature .tile-photo {
    border-radius: clamp(0.4rem, 1.2cqi, 0.8rem);
  }

  /* desktop: the full frame is mostly canopy and sky, so trim it to a wide strip around the
     people (object-position comes from the photo's focal point). Stretch in both axes: when
     the side column is taller than a 2.4:1 strip, the row grows and an aspect-ratio box would
     otherwise widen out of its column (height × 2.4) over the side column. */
  @media (min-width: 64rem) {
    .feature .tile-photo {
      aspect-ratio: 2.4 / 1;
      justify-self: stretch;
      align-self: stretch;
    }
  }

  .feature-side {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    padding: 0.2rem 0.3rem 0;
  }

  .feature-kicker {
    color: var(--accent);
  }

  .feature-title {
    font-family: var(--f-display);
    font-weight: 900;
    font-size: clamp(2.2rem, 1.4rem + 3vw, 3.8rem);
    line-height: 0.85;
    text-transform: uppercase;
    color: var(--c-chalk);
  }

  .feature-caption {
    font-size: clamp(1rem, 0.92rem + 0.4vw, 1.2rem);
    line-height: 1.4;
    color: var(--c-chalk);
    text-wrap: pretty;
  }

  /* stewards' rubber stamp in the pass's free space (desktop only) */
  .feature-stamp {
    display: none;
    justify-items: center;
    align-self: center;
    gap: 0.2rem;
    margin-block: auto;
    padding: 0.55rem 0.9rem 0.6rem;
    border: 3px double var(--c-red);
    border-radius: var(--radius-s);
    color: var(--c-red);
    background: color-mix(in oklab, var(--c-carbon) 60%, transparent);
    box-shadow: inset 0 0 0 1px rgb(255 45 58 / 0.25);
    text-align: center;
    font-size: 0.58rem;
    rotate: -8deg;
  }

  .feature-stamp-big {
    font-family: var(--f-display);
    font-weight: 900;
    font-size: 2.6rem;
    line-height: 0.85;
    letter-spacing: 0;
  }

  .feature-meta {
    display: grid;
    gap: 0.3rem;
    margin: 0.2rem 0 0;
    padding-top: 0.6rem;
    border-top: 1px dashed var(--c-line-strong);
  }

  .feature-meta div {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .feature-meta dt {
    color: var(--c-mute);
  }

  .feature-meta dd {
    margin: 0;
    color: var(--c-chalk);
    text-align: right;
  }

  .feature .pass-foot {
    margin-top: auto;
    padding-top: 0.4rem;
  }

  .feature .barcode {
    max-width: 70%;
    height: 1.6rem;
  }

  .feature .holo {
    width: 3.2rem;
    font-size: 0.52rem;
  }

  @media (min-width: 64rem) {
    .feature-body {
      grid-template-columns: minmax(0, 2.4fr) minmax(15rem, 1fr);
      align-items: stretch;
      gap: 1.25rem;
    }

    .feature-side {
      padding: 0.4rem 0.5rem 0.2rem 0;
    }

    .feature-stamp {
      display: grid;
    }
  }

  /* ================= Masonry wall =================
   * CSS multi-column: every frame keeps its photo's true aspect, columns
   * balance themselves. Items never split across columns.
   */
  .wall {
    columns: 2;
    column-gap: clamp(0.9rem, 3.5vw, 1.5rem);
    margin: 0;
    padding: 0 0 var(--space-5);
    list-style: none;
  }

  @media (min-width: 40rem) {
    .wall {
      columns: 3;
    }
  }

  @media (min-width: 64rem) {
    .wall {
      columns: 4;
      column-gap: clamp(1.25rem, 2.2vw, 2.25rem);
    }
  }

  .wall .tile {
    display: block;
    break-inside: avoid;
    margin: 0 0 clamp(1.25rem, 3vw, 2rem);
  }

  /* room above each card for its lanyard / tape (kept inside the item, so columns never clip it) */
  .wall .kind-pass {
    padding-top: 2.85rem;
  }

  .wall .kind-polaroid {
    padding-top: 1rem;
  }

  .wall-foot {
    color: var(--c-mute);
    text-align: center;
    margin-top: var(--space-3);
  }

  /* ================= Lightbox ================= */
  .lb {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--c-chalk);
    overflow: hidden;
  }

  .lb::backdrop {
    background:
      radial-gradient(60% 50% at 50% 40%, rgb(255 197 46 / 0.08), transparent 70%),
      rgb(7 7 11 / 0.92);
    backdrop-filter: blur(14px) saturate(0.7);
  }

  .lb[open] {
    animation: lb-in 0.35s var(--ease-out-expo);
  }

  :global(html[data-pp-vt]) .lb[open] {
    animation: none;
  }

  @keyframes lb-in {
    from {
      opacity: 0;
    }
  }

  .lb-shell {
    height: 100%;
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    gap: var(--space-3);
    padding: max(var(--space-3), env(safe-area-inset-top)) var(--gutter) max(var(--space-3), env(safe-area-inset-bottom));
  }

  .lb-top {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--space-3);
  }

  .lb-count {
    color: var(--c-mute);
  }

  .lb-i {
    color: var(--c-gold);
  }

  .lb-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--c-chalk);
  }

  .lb-close {
    justify-self: end;
  }

  .lb-btn {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    border: 1px solid var(--c-line-strong);
    background: rgb(16 16 23 / 0.7);
    color: var(--c-chalk);
    transition:
      background-color var(--dur-fast),
      border-color var(--dur-fast),
      transform var(--dur-med) var(--ease-out-back);
  }

  .lb-btn svg {
    width: 1.25rem;
    height: 1.25rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* hover only where hover is real: on touch the sticky :hover left prev/next gold after a tap */
  @media (hover: hover) and (pointer: fine) {
    .lb-btn:hover {
      background: var(--c-gold);
      border-color: var(--c-gold);
      color: var(--c-on-gold);
    }
  }

  .lb-btn:focus-visible {
    background: var(--c-gold);
    border-color: var(--c-gold);
    color: var(--c-on-gold);
  }

  .lb-btn:active {
    transform: scale(0.92);
  }

  .lb-stage {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    grid-template-areas: 'prev slides next';
    align-items: center;
    gap: var(--space-4);
    min-height: 0;
    touch-action: pan-y;
  }

  .lb-prev {
    grid-area: prev;
  }

  .lb-next {
    grid-area: next;
  }

  .lb-slides {
    grid-area: slides;
    height: 100%;
    min-height: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
  }

  .lb-slide {
    grid-area: 1 / 1;
    min-height: 0;
    display: grid;
    place-items: center;
  }

  .lb-fig {
    display: grid;
    justify-items: center;
    align-items: center;
    gap: var(--space-4);
    margin: 0;
    max-height: 100%;
  }

  /* the full photo at its true aspect: width = min(width cap, height cap × aspect) */
  .lb-photo {
    --lb-max-w: calc(100vw - 2 * var(--gutter) - 8rem);
    --lb-max-h: calc(100svh - 24rem);
    position: relative;
    width: min(var(--lb-max-w), calc(var(--lb-max-h) * var(--arn, 1.3333)));
    aspect-ratio: var(--ar, 4 / 3);
    border-radius: var(--radius-m);
    overflow: clip;
    background:
      radial-gradient(60% 60% at 50% 50%, rgb(255 197 46 / 0.06), transparent 70%),
      var(--c-graphite);
    box-shadow:
      0 2rem 5rem -1.5rem rgb(0 0 0 / 0.9),
      0 0 0 1px var(--c-line-strong);
  }

  .lb-photo :global(picture) {
    position: absolute;
    inset: 0;
    display: block;
  }

  .lb-photo :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 0;
    object-fit: cover;
  }

  .lb-photo :global(.photo-placeholder) {
    min-height: 0;
    height: 100%;
    border: 0;
  }

  .lb-photo :global(.ph-emblem) {
    width: clamp(4rem, 10vw, 8rem);
    height: auto;
  }

  .doc {
    width: min(100%, 26rem);
    padding: 0.9rem 1rem 1rem;
    border-radius: var(--radius-m);
    background: linear-gradient(170deg, var(--c-graphite), var(--c-asphalt));
    border: 1px solid var(--c-line-strong);
    border-top: 3px solid var(--accent);
  }

  .doc-head {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--c-line);
    color: var(--accent);
  }

  .doc-grid {
    display: grid;
    gap: 0.4rem;
    margin: 0.6rem 0 0;
  }

  .doc-row {
    display: grid;
    grid-template-columns: 4.5rem 1fr;
    gap: var(--space-3);
    align-items: baseline;
  }

  .doc-row dt {
    color: var(--c-mute);
  }

  .doc-row dd {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.35;
  }

  .doc-from,
  .doc-to {
    display: none;
  }

  .doc-decision dd {
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--c-chalk);
  }

  .doc-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-top: 0.75rem;
    padding-top: 0.6rem;
    border-top: 1px dashed var(--c-line-strong);
    color: var(--c-mute);
  }

  .doc-stamp {
    padding: 0.25em 0.5em;
    border: 2px solid var(--c-red);
    border-radius: 0.25rem;
    color: var(--c-red);
    rotate: -6deg;
    font-weight: 700;
    white-space: nowrap;
  }

  .lb-foot {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-5);
    min-height: 1.5rem;
  }

  .lb-pips {
    display: flex;
    gap: 0.3rem;
  }

  .lb-pips i {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 99px;
    background: var(--c-line-strong);
    transition:
      width var(--dur-med) var(--ease-out-expo),
      background-color var(--dur-med);
  }

  .lb-pips i:global(.on) {
    width: 1.4rem;
    background: var(--c-gold);
  }

  .lb-hint {
    color: var(--c-mute);
  }

  @media (max-width: 59.99rem) {
    .lb-stage {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: minmax(0, 1fr) auto;
      grid-template-areas:
        'slides slides'
        'prev next';
      gap: var(--space-3);
    }

    .lb-next {
      justify-self: end;
    }

    .lb-photo {
      --lb-max-w: calc(100vw - 2 * var(--gutter));
      --lb-max-h: 50svh;
    }

    .lb-fig {
      gap: var(--space-3);
    }

    .lb-hint {
      display: none;
    }

    .lb-title {
      font-size: 0.62rem;
    }

    .doc {
      padding: 0.7rem 0.85rem 0.8rem;
    }

    .doc-head {
      padding-bottom: 0.4rem;
    }

    .doc-grid {
      margin-top: 0.45rem;
      gap: 0.3rem;
    }

    .doc-row dd {
      font-size: 0.86rem;
    }

    .doc-decision dd {
      font-size: 0.95rem;
    }

    .doc-foot {
      margin-top: 0.55rem;
      padding-top: 0.45rem;
    }

    .lb-foot {
      position: absolute;
      left: 50%;
      bottom: max(var(--space-3), env(safe-area-inset-bottom));
      translate: -50% 0;
      min-height: 3rem;
    }

    .lb-pips {
      gap: 0.22rem;
    }

    .lb-pips i {
      width: 0.3rem;
      height: 0.3rem;
    }

    .lb-pips i:global(.on) {
      width: 0.9rem;
    }
  }

  @media (min-width: 60rem) {
    .lb-fig {
      grid-template-columns: minmax(0, auto) 22rem;
      gap: var(--space-6);
    }

    .lb-photo {
      --lb-max-w: calc(100vw - 2 * var(--gutter) - 22rem - 12rem);
      --lb-max-h: calc(100svh - 12rem);
    }

    .doc {
      width: 22rem;
      padding: 1.25rem 1.35rem 1.35rem;
    }

    .doc-from,
    .doc-to {
      display: grid;
    }

    .doc-decision dd {
      font-size: 1.3rem;
      line-height: 1.3;
    }
  }

  /* Short viewports (landscape phones): if the doc still doesn't fit, the slide scrolls
   * (the dialog carries data-lenis-prevent so the stopped Lenis doesn't eat wheel/touch);
   * `safe` keeps the top of an overflowing figure reachable. */
  @media (max-height: 30em) and (orientation: landscape) {
    .lb-slide {
      overflow-y: auto;
      overscroll-behavior: contain;
      place-items: safe center;
      /* a scroll container resets touch-action: keep horizontal drags for the stage's swipe
         handler, or the browser claims the pan and fires pointercancel */
      touch-action: pan-y;
    }
  }

  /* Landscape phones: photo and stewards' doc side by side instead of stacked. */
  @media (max-width: 59.99rem) and (max-height: 30em) and (orientation: landscape) {
    .lb-fig {
      grid-template-columns: auto minmax(0, 1fr);
      align-items: center;
      gap: var(--space-4);
    }

    .lb-photo {
      /* viewport minus header, nav row, paddings and gaps */
      --lb-max-h: calc(100svh - 10rem);
      --lb-max-w: 45vw;
    }
  }

  /* ================= View-transition choreography =================
   * pp-photo morphs tile ⇄ lightbox (same aspect on both ends); pp-out / pp-in
   * slide between photos.
   */
  :global(::view-transition-group(pp-photo)) {
    animation-duration: 0.62s;
    animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 2;
  }

  :global(::view-transition-old(pp-photo)),
  :global(::view-transition-new(pp-photo)) {
    height: 100%;
    object-fit: cover;
    animation-duration: 0.45s;
  }

  :global(html[data-pp-vt]::view-transition-old(root)),
  :global(html[data-pp-vt]::view-transition-new(root)) {
    animation-duration: 0.4s;
  }

  :global(::view-transition-old(pp-out)) {
    animation: pp-out-next 0.45s cubic-bezier(0.65, 0, 0.35, 1) both;
  }

  :global(::view-transition-new(pp-in)) {
    animation: pp-in-next 0.6s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  :global(html[data-pp-vt='prev']::view-transition-old(pp-out)) {
    animation-name: pp-out-prev;
  }

  :global(html[data-pp-vt='prev']::view-transition-new(pp-in)) {
    animation-name: pp-in-prev;
  }

  @keyframes pp-out-next {
    to {
      opacity: 0;
      transform: translateX(-22%) rotate(-5deg) scale(0.9);
    }
  }

  @keyframes pp-in-next {
    from {
      opacity: 0;
      transform: translateX(22%) rotate(5deg) scale(0.9);
    }
  }

  @keyframes pp-out-prev {
    to {
      opacity: 0;
      transform: translateX(22%) rotate(5deg) scale(0.9);
    }
  }

  @keyframes pp-in-prev {
    from {
      opacity: 0;
      transform: translateX(-22%) rotate(-5deg) scale(0.9);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tile,
    .card {
      transition: none;
    }

    .card {
      transform: none;
    }
  }
</style>

<script>
  import { gsap, ScrollTrigger, prefersReducedMotion, isLowPowerDevice, lockScroll } from '@/scripts/motion';
  import { sound } from '@/scripts/audio';

  const wait = (ms: number) => new Promise<void>((r) => window.setTimeout(r, ms));

  /* ---------- Tiles fly in out of the depth of the paddock ---------- */
  function setupWall(root: HTMLElement): void {
    const tiles = Array.from(root.querySelectorAll<HTMLElement>('.tile'));
    if (!tiles.length || prefersReducedMotion()) return;
    const low = isLowPowerDevice();

    const shown = new WeakSet<HTMLElement>();
    const reveal = (batch: Element[], instant = false) => {
      const fresh = (batch as HTMLElement[]).filter((el) => !shown.has(el));
      if (!fresh.length) return;
      fresh.forEach((el) => shown.add(el));
      if (instant) {
        gsap.set(fresh, { clearProps: 'opacity,transform' });
        return;
      }
      // One tween per tile (delay = the stagger) rather than one staggered tween: GSAP can't
      // kill a single target out of a running stagger (killTweensOf misses the nested child
      // tween), and the focus handler below needs to finish exactly one tile.
      fresh.forEach((el, i) => {
        gsap.fromTo(
          el,
          {
            opacity: 0,
            y: low ? 90 : 160,
            z: low ? -160 : -420,
            rotationX: low ? -24 : -48,
            rotationY: low ? 0 : i % 2 ? 16 : -16,
            transformPerspective: 1100,
          },
          {
            opacity: 1,
            y: 0,
            z: 0,
            rotationX: 0,
            rotationY: 0,
            duration: low ? 0.9 : 1.25,
            delay: i * 0.09,
            ease: 'expo.out',
            overwrite: true,
            clearProps: 'opacity,transform',
          },
        );
      });
    };

    gsap.set(tiles, { opacity: 0 });
    ScrollTrigger.batch(tiles, {
      start: 'top 92%',
      onEnter: (batch) => reveal(batch),
      onEnterBack: (batch) => reveal(batch, true),
      onLeave: (batch) => reveal(batch, true),
    });
    // Keyboard users tabbing ahead of the scroll never land on an invisible tile.
    // Also finish a tile whose fly-in has only just started (still ~opacity 0): kill just
    // this tile's tween; the rest of its batch keeps animating.
    tiles.forEach((tile) =>
      tile.addEventListener('focusin', () => {
        gsap.killTweensOf(tile);
        gsap.set(tile, { clearProps: 'opacity,transform' });
        shown.add(tile);
      }),
    );
  }

  /* ---------- Laminate tilt + holo shimmer following the pointer ---------- */
  function setupTilt(root: HTMLElement): void {
    if (prefersReducedMotion() || !window.matchMedia('(hover: hover) and (pointer: fine)').matches) return;
    root.querySelectorAll<HTMLElement>('.card').forEach((card) => {
      const amp = Number(card.dataset.tilt ?? 1) || 1;
      let frame = 0;
      card.addEventListener('pointermove', (e) => {
        if (frame) return;
        frame = requestAnimationFrame(() => {
          frame = 0;
          const r = card.getBoundingClientRect();
          const px = Math.min(1, Math.max(0, (e.clientX - r.left) / r.width));
          const py = Math.min(1, Math.max(0, (e.clientY - r.top) / r.height));
          card.classList.add('is-tilting');
          card.style.setProperty('--mx', px.toFixed(3));
          card.style.setProperty('--my', py.toFixed(3));
          card.style.setProperty('--ry', `${((px - 0.5) * 12 * amp).toFixed(2)}deg`);
          card.style.setProperty('--rx', `${((0.5 - py) * 9 * amp).toFixed(2)}deg`);
        });
      });
      card.addEventListener('pointerleave', () => {
        cancelAnimationFrame(frame);
        frame = 0;
        card.classList.remove('is-tilting');
        card.style.setProperty('--rx', '0deg');
        card.style.setProperty('--ry', '0deg');
      });
    });
  }

  /* ---------- Lightbox ---------- */
  function setupLightbox(root: HTMLElement): void {
    const dialog = root.querySelector<HTMLDialogElement>('dialog.lb');
    if (!dialog || typeof dialog.showModal !== 'function') return;
    const triggers = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-lb-open]'));
    const slides = Array.from(dialog.querySelectorAll<HTMLElement>('.lb-slide'));
    const pips = Array.from(dialog.querySelectorAll<HTMLElement>('[data-pip]'));
    const countEl = dialog.querySelector<HTMLElement>('.lb-i');
    const live = dialog.querySelector<HTMLElement>('.lb-live');
    const stage = dialog.querySelector<HTMLElement>('.lb-stage');
    const n = slides.length;
    if (!n) return;

    let current = 0;
    let gen = 0;
    const named = new Set<HTMLElement>();
    const html = document.documentElement;

    /** Tile trigger for gallery index i (the featured pass is not in DOM order with the wall). */
    const trigger = (i: number) => triggers.find((b) => Number(b.dataset.lbOpen) === i) ?? null;
    const tilePhoto = (i: number) => trigger(i)?.closest('.card')?.querySelector<HTMLElement>('.tile-photo') ?? null;
    const lbPhoto = (i: number) => slides[i]?.querySelector<HTMLElement>('.lb-photo') ?? null;
    const lbImg = (i: number) => slides[i]?.querySelector<HTMLImageElement>('.lb-photo img') ?? null;

    /** Start fetching a slide's full-size image early (lazy images inside a closed dialog never load). */
    const prime = (i: number) => {
      const img = lbImg((i + n) % n);
      if (img && img.loading !== 'eager') img.loading = 'eager';
    };
    /** Give the full image a moment to decode so the view transition morphs into a real photo. */
    const ready = (i: number) => {
      const img = lbImg(i);
      if (!img || (img.complete && img.naturalWidth > 0)) return Promise.resolve();
      return Promise.race([img.decode().catch(() => undefined), wait(380)]);
    };

    const setName = (el: HTMLElement | null, name: string) => {
      if (!el) return;
      el.style.setProperty('view-transition-name', name);
      named.add(el);
    };
    const clearNames = () => {
      named.forEach((el) => el.style.removeProperty('view-transition-name'));
      named.clear();
    };
    const inViewport = (el: HTMLElement | null) => {
      if (!el) return false;
      const r = el.getBoundingClientRect();
      return r.bottom > 0 && r.top < window.innerHeight && r.right > 0 && r.left < window.innerWidth;
    };
    const canVT = () =>
      typeof document.startViewTransition === 'function' && !prefersReducedMotion() && !document.hidden;

    /** Run a DOM update, as a view transition when possible. */
    const transition = (kind: string, before: () => void, update: (vt: boolean) => Promise<void> | void) => {
      if (!canVT()) {
        void update(false);
        return;
      }
      const mine = ++gen;
      clearNames();
      before();
      html.dataset.ppVt = kind;
      const vt = document.startViewTransition(async () => {
        await update(true);
      });
      vt.finished
        .catch(() => undefined)
        .finally(() => {
          if (mine !== gen) return;
          clearNames();
          delete html.dataset.ppVt;
        });
    };

    const render = () => {
      slides.forEach((s, i) => {
        s.hidden = i !== current;
      });
      pips.forEach((p, i) => p.classList.toggle('on', i === current));
      if (countEl) countEl.textContent = String(current + 1).padStart(2, '0');
      const caption = slides[current]?.querySelector('.doc-decision dd')?.textContent ?? '';
      if (live) live.textContent = `Photo ${current + 1} of ${n}. ${caption}`;
      prime(current + 1);
      prime(current - 1);
    };

    const open = (i: number) => {
      if (dialog.open) return;
      current = Math.min(Math.max(0, i), n - 1);
      prime(current);
      const from = tilePhoto(current);
      const show = inViewport(from);
      transition(
        'open',
        () => {
          if (show) setName(from, 'pp-photo');
        },
        async (vt) => {
          if (vt) clearNames();
          render();
          dialog.showModal();
          lockScroll(true);
          if (vt) {
            setName(lbPhoto(current), 'pp-photo');
            await ready(current);
          }
        },
      );
      sound.play('click', { volume: 0.5 });
    };

    const close = () => {
      if (!dialog.open) return;
      const to = tilePhoto(current);
      const back = inViewport(to);
      transition(
        'close',
        () => setName(lbPhoto(current), 'pp-photo'),
        (vt) => {
          if (vt) clearNames();
          dialog.close();
          if (vt && back) setName(to, 'pp-photo');
        },
      );
    };

    const go = (delta: number) => {
      if (!dialog.open || n < 2) return;
      const from = current;
      current = (current + delta + n) % n;
      prime(current);
      transition(
        delta > 0 ? 'next' : 'prev',
        () => setName(lbPhoto(from), 'pp-out'),
        async (vt) => {
          render();
          if (vt) {
            setName(lbPhoto(current), 'pp-in');
            await ready(current);
          }
        },
      );
      sound.play('whoosh', { volume: 0.35 });
    };

    const goTo = (index: number) => {
      if (index === current) return;
      go(index - current);
    };

    triggers.forEach((btn) => {
      const i = Number(btn.dataset.lbOpen) || 0;
      btn.addEventListener('click', () => open(i));
      // Intent (hover / keyboard focus) → warm up the full-size image. Not on touch: a finger
      // scrolling over the wall fires pointerenter/pointerdown on every card it crosses, and
      // open() primes + waits for decode anyway. prime() is idempotent.
      const warm = () => prime(i);
      btn.addEventListener('pointerenter', (e) => {
        if (e.pointerType !== 'touch') warm();
      });
      btn.addEventListener('focus', warm, { once: true });
    });

    dialog.querySelector('.lb-close')?.addEventListener('click', close);
    dialog.querySelector('.lb-prev')?.addEventListener('click', () => go(-1));
    dialog.querySelector('.lb-next')?.addEventListener('click', () => go(1));

    // Esc: animate the close ourselves (the browser may still force-close; 'close' cleans up).
    dialog.addEventListener('cancel', (e) => {
      e.preventDefault();
      close();
    });
    dialog.addEventListener('close', () => {
      lockScroll(false);
      const btn = trigger(current);
      if (btn) btn.focus({ preventScroll: inViewport(btn) });
    });

    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'Tab') {
        // Keep Tab cycling inside the viewer (the modal already makes the page inert).
        const focusables = Array.from(dialog.querySelectorAll<HTMLElement>('button:not([disabled])')).filter(
          (el) => el.offsetParent !== null,
        );
        const first = focusables[0];
        const last = focusables[focusables.length - 1];
        if (!first || !last) return;
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
        return;
      }
      if (e.key === 'ArrowRight') {
        e.preventDefault();
        go(1);
      } else if (e.key === 'ArrowLeft') {
        e.preventDefault();
        go(-1);
      } else if (e.key === 'Home') {
        e.preventDefault();
        goTo(0);
      } else if (e.key === 'End') {
        e.preventDefault();
        goTo(n - 1);
      }
    });

    // Swipe (touch / pen) + tap-outside-to-close.
    let sx = 0;
    let sy = 0;
    let tracking = false;
    let swipedAt = 0;
    stage?.addEventListener('pointerdown', (e) => {
      if (e.pointerType === 'mouse') return;
      tracking = true;
      sx = e.clientX;
      sy = e.clientY;
    });
    stage?.addEventListener('pointerup', (e) => {
      if (!tracking) return;
      tracking = false;
      const dx = e.clientX - sx;
      const dy = e.clientY - sy;
      if (Math.abs(dx) > 48 && Math.abs(dx) > Math.abs(dy) * 1.2) {
        swipedAt = performance.now();
        go(dx < 0 ? 1 : -1);
      }
    });
    stage?.addEventListener('pointercancel', () => {
      tracking = false;
    });
    dialog.addEventListener('click', (e) => {
      if (performance.now() - swipedAt < 400) return;
      const target = e.target as HTMLElement | null;
      if (!target) return;
      if (target === dialog || target.matches('.lb-shell, .lb-stage, .lb-slides, .lb-slide, .lb-foot')) close();
    });
  }

  function initPaddock(): void {
    const root = document.querySelector<HTMLElement>('#paddock');
    if (!root) return;
    setupWall(root);
    setupTilt(root);
    setupLightbox(root);
  }

  initPaddock();
</script>
