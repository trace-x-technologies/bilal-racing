                  <circle r="46" fill="url(#rd-flood)"></circle>
                </g>
                <g transform="translate(1140 420)">
                  <rect x="-2" y="0" width="4" height="190" fill="#16131d"></rect>
                  <circle r="46" fill="url(#rd-flood)"></circle>
                </g>
                <g transform="translate(1450 330)">
                  <rect x="-3" y="0" width="6" height="280" fill="#16131d"></rect>
                  <circle r="70" fill="url(#rd-flood)"></circle>
                </g>
              </g>
            </svg>

            <!-- Road: a CSS 3D plane; the surface scrolls on the compositor. -->
            <div class="rd-road">
              <div class="rd-road-surface">
                <span class="rd-kerb rd-kerb-l"></span>
                <span class="rd-edge rd-edge-l"></span>
                <span class="rd-dash"></span>
                <span class="rd-edge rd-edge-r"></span>
                <span class="rd-kerb rd-kerb-r"></span>
