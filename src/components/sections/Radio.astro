---
/**
 * 08 · TEAM RADIO — an F1-TV-style onboard with the radio overlay.
 * Plays lore.radioMessages: the owner (Poosa, callsign RAT) on the pit wall
 * talking to both drivers, #13 Isuru (DHA) and #17 Yasas (DEE). Typewriter
 * transcript, per-speaker name bar + team colour, canvas waveform, squelch
 * in/out and (sound on) every line spoken aloud through the radio bus — a
 * text-to-speech clip per line, one voice per speaker, the owner pitched up.
 * Clips come from `npm run voices`. Autoplays the first exchange when seen.
 */
import SectionHeading from '@/components/ui/SectionHeading.astro';
import Emblem from '@/components/ui/Emblem.astro';
import PhotoSlot from '@/components/ui/PhotoSlot.astro';
import { drivers, owner, radioMessages, sinhala, team, type Driver, type RadioSpeaker } from '@/data/lore';
import { driverPortraits, type PhotoEntry } from '@/data/photos';
import clipFiles from '@/assets/audio/radio/manifest.json';

interface Speaker {
  id: RadioSpeaker;
  /** Name on the transcript ("Poosa", "Isuru"). */
  name: string;
  /** Big name on the name bar. */
  surname: string;
  /** Pit-wall callsign (owner) or timing code (drivers). */
  code: string;
  /** Car number; null = pit wall. */
  car: number | null;
  /** Small line under the name. */
  role: string;
  /** Decorative avatar (the name bar is aria-hidden, so alt stays empty). */
  photo: PhotoEntry;
  /** Avatar crop: zoom into the portrait around `origin`, then nudge sideways to centre the face. */
  zoom: number;
  origin: string;
  shift: string;
}

const OWNER: RadioSpeaker = 'Poosa';

/** Face crops into the full driver portraits (the owner already has a face-cropped avatar). */
const CROPS: Record<Driver['id'], { focal: string; zoom: number; origin: string; shift: string }> = {
  dha: { focal: '36% 43%', zoom: 1.7, origin: '36% 50%', shift: '12%' },
  dee: { focal: '48% 60%', zoom: 1.45, origin: '48% 50%', shift: '2%' },
};

const driverSpeaker = (id: Exclude<RadioSpeaker, 'Poosa'>): Speaker => {
  const d = drivers.find((x) => x.firstName === id) ?? drivers[0];
  const crop = CROPS[d.id];
  return {
    id,
    name: d.firstName,
    surname: d.lastName,
    code: d.code,
    car: d.number,
    role: `${d.code} · ${team.name}`,
    photo: { ...driverPortraits[d.id], id: `radio-${d.id}`, alt: '', focal: crop.focal },
    zoom: crop.zoom,
    origin: crop.origin,
    shift: crop.shift,
  };
};

const speakers: Record<RadioSpeaker, Speaker> = {
  Poosa: {
    id: 'Poosa',
    name: owner.nicknameLatin,
    surname: owner.lastName,
    code: owner.callsign,
    car: null,
    role: `${owner.nicknameLatin} · Team Principal`,
    photo: { id: 'radio-owner', folder: 'crew', file: 'nirod-rathnaweera.jpg', alt: '', caption: '', focal: '50% 45%' },
    zoom: 1,
    origin: '50% 50%',
    shift: '0%',
  },
  Isuru: driverSpeaker('Isuru'),
  Yasas: driverSpeaker('Yasas'),
};
const cast = [speakers.Poosa, speakers.Isuru, speakers.Yasas];

/** Spoken clips, keyed "<speaker>|<text>" in the manifest. A line without one plays silent. */
const CLIP_DIR = '/src/assets/audio/radio/';
const clipUrls = import.meta.glob<string>('/src/assets/audio/radio/*.m4a', { eager: true, query: '?url', import: 'default' });
const clipFor = (from: RadioSpeaker, text: string): string | undefined => {
  const file = (clipFiles as Record<string, string>)[`${from}|${text}`];
  return file ? clipUrls[CLIP_DIR + file] : undefined;
};

type Line = { from: RadioSpeaker; text: string; clip?: string };
type Exchange = { lap: number; car: RadioSpeaker; lines: Line[] };

/**
 * Group the radio into exchanges that each end on the owner's punchline
 * (driver asks → cat answers). An exchange's car is the driver in it.
 */
const laps = [9, 13, 17, 31, 44, 57];
const exchanges: Exchange[] = [];
const close = (lines: Line[]) =>
  exchanges.push({
    lap: laps[exchanges.length] ?? 57,
    car: lines.find((l) => l.from !== OWNER)?.from ?? 'Isuru',
    lines,
  });
let pending: Line[] = [];
for (const m of radioMessages) {
  pending.push({ from: m.from, text: m.text, clip: clipFor(m.from, m.text) });
  if (m.from === OWNER && pending.some((l) => l.from !== OWNER)) {
    close(pending);
    pending = [];
  }
}
if (pending.length) close(pending);

const totalLaps = 57;
const slots = Math.max(2, ...exchanges.map((ex) => ex.lines.length));
const firstCar = speakers[exchanges[0]?.car ?? 'Isuru'];
const route = (ex: Exchange) => {
  const opener = speakers[ex.lines[0].from];
  const car = speakers[ex.car];
  return opener.car == null ? `Pit wall → Car ${car.car}` : `Car ${opener.car} → Pit wall`;
};
const spoken = (ex: Exchange) =>
  `Lap ${ex.lap}, ${route(ex).replace('→', 'to')}. ${ex.lines.map((l) => `${l.from}: ${l.text}`).join(' ')}`;
const payload = JSON.stringify(exchanges);
const speakerPayload = JSON.stringify(
  Object.fromEntries(cast.map((s) => [s.id, { name: s.name, code: s.code, car: s.car }])),
);
---

<section class="section radio" id="radio" aria-labelledby="radio-title">
  <div class="container">
    <SectionHeading
      index="04"
      kicker="Team Radio"
      id="radio-title"
