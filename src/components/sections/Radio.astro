      si={sinhala.hari.si}
    />

    <div class="rd-layout" data-rd-root data-exchanges={payload} data-speakers={speakerPayload}>
      <div class="rd-main">
        <div class="rd-screen" data-rd-screen data-reveal="up">
          <!-- ======== onboard camera ======== -->
          <div class="rd-cam" aria-hidden="true">
