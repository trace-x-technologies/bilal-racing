                <rect x="1200" y="600" width="330" height="360" rx="70" fill="#0a0a0d"></rect>
                <rect x="1486" y="600" width="18" height="300" rx="9" fill="#ffc52e" opacity="0.7"></rect>
              </g>
              <!-- front wing -->
              <path d="M180 900 L260 842 H1340 L1420 900 Z" fill="#0d0d12"></path>
              <path d="M260 842 H1340 L1350 852 H250 Z" fill="#ffc52e" opacity="0.8"></path>
              <!-- nose with livery stripe + number -->
              <path d="M700 900 L770 600 Q800 580 830 600 L900 900 Z" fill="url(#rd-carbon)"></path>
              <path d="M786 604 L814 604 L846 900 H754 Z" fill="url(#rd-livery)" opacity="0.9"></path>
              <text x="800" y="840" text-anchor="middle" font-family="Saira Variable, sans-serif" font-weight="900" font-size="58" fill="#07070b" data-rd-carnum>{firstCar.car}</text>
              <!-- cockpit sides -->
              <path d="M0 900 V700 Q150 690 300 760 Q420 820 520 900 Z" fill="url(#rd-carbon)"></path>
              <path d="M1600 900 V700 Q1450 690 1300 760 Q1180 820 1080 900 Z" fill="url(#rd-carbon)"></path>
              <path d="M0 712 Q150 702 300 772 Q420 830 505 900 H480 Q400 840 290 786 Q150 722 0 728 Z" fill="#a0153e"></path>
              <path d="M1600 712 Q1450 702 1300 772 Q1180 830 1095 900 H1120 Q1200 840 1310 786 Q1450 722 1600 728 Z" fill="#a0153e"></path>
              <!-- mirrors (the car behind is 0.4 s back) -->
              <g>
                <path d="M360 700 L420 648" stroke="#0a0a0d" stroke-width="10"></path>
                <rect x="250" y="600" width="190" height="70" rx="22" fill="#08080b"></rect>
                <rect x="262" y="610" width="166" height="50" rx="16" fill="url(#rd-mirror)"></rect>
                <circle cx="330" cy="640" r="5" fill="#fff6d8"></circle>
                <circle cx="356" cy="640" r="5" fill="#fff6d8"></circle>
                <path d="M1240 700 L1180 648" stroke="#0a0a0d" stroke-width="10"></path>
                <rect x="1160" y="600" width="190" height="70" rx="22" fill="#08080b"></rect>
                <rect x="1172" y="610" width="166" height="50" rx="16" fill="url(#rd-mirror)"></rect>
              </g>
              <!-- halo: hoop + centre pillar (close to the lens) -->
              <g>
                <path d="M-80 170 Q800 -70 1680 170" stroke="#08080b" stroke-width="84" fill="none"></path>
                <path d="M-80 130 Q800 -110 1680 130" stroke="#2c2c38" stroke-width="6" fill="none" opacity="0.8"></path>
                <path d="M778 60 L822 60 L846 720 Q800 736 754 720 Z" fill="url(#rd-halo)"></path>
                <path d="M796 70 L801 70 L804 700 L797 700 Z" fill="#4a4a5a" opacity="0.55"></path>
              </g>
            </svg>
            <div class="rd-scan"></div>
          </div>

          <!-- ======== broadcast HUD ======== -->
          <div class="rd-hud" aria-hidden="true">
            <div class="rd-lap">
              <span class="t-mono">Lap</span>
              <b data-rd-lap>{exchanges[0].lap}</b>
              <span class="rd-lap-total">/{totalLaps}</span>
            </div>
            <div class="rd-live t-mono">
              <i></i> Live · Onboard <span data-rd-onboard>#{firstCar.car} {firstCar.code}</span>
            </div>
          </div>

          <!-- ======== radio overlay ======== -->
          <div class="rd-overlay" data-rd-overlay data-who="" data-card={firstCar.id}>
            <p class="rd-tag t-mono" aria-hidden="true">
              <span class="rd-tag-dot"></span>
              <span data-rd-dir>Team radio</span>
            </p>
            <div class="rd-namebar" aria-hidden="true">
              <span class="rd-sweep" data-rd-sweep></span>
              <span class="rd-stripe"></span>
              <span class="rd-cards">
                {
                  cast.map((s) => (
                    <span class="rd-card" data-spk={s.id}>
                      <span class="rd-av" style={`--av-zoom: ${s.zoom}; --av-origin: ${s.origin}; --av-shift: ${s.shift}`}>
                        <PhotoSlot photo={s.photo} widths={[112, 200]} sizes={`${Math.round(48 * s.zoom)}px`} />
                      </span>
                      <span class:list={['rd-num t-condensed', { 'is-code': s.car == null }]}>{s.car ?? s.code}</span>
                      <span class="rd-id">
                        <b>{s.surname}</b>
                        <small>
                          <Emblem size="0.95em" title="" />
                          <span class="rd-role">{s.role}</span>
                        </small>
                      </span>
                    </span>
                  ))
                }
              </span>
              <canvas class="rd-wave" data-rd-wave width="160" height="40"></canvas>
            </div>
            <div class="rd-transcript" aria-hidden="true">
              {
                Array.from({ length: slots }, (_, i) => (
                  <p class="rd-line" data-rd-line={i} hidden>
                    <span class="rd-who t-mono" data-rd-who />
                    <span class="rd-text">
                      <span class="rd-typed" data-rd-typed />
                      <span class="rd-rest" data-rd-rest />
                    </span>
                  </p>
                ))
              }
              <p class="rd-idle t-mono" data-rd-idle>Channel open · the owner is choosing a box</p>
            </div>
          </div>
        </div>

        <!-- ======== controls ======== -->
        <div class="rd-controls" role="group" aria-label="Team radio controls">
          <button type="button" class="rd-ctl rd-ctl-play" data-rd-play aria-label="Play team radio">
            <svg class="rd-i-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 4.5v15l13-7.5z"></path></svg>
            <svg class="rd-i-pause" viewBox="0 0 24 24" aria-hidden="true"
              ><rect x="6" y="4.5" width="4.2" height="15" rx="1"></rect><rect x="13.8" y="4.5" width="4.2" height="15" rx="1"
              ></rect></svg
            >
          </button>
          <button type="button" class="rd-ctl" data-rd-next aria-label="Next call">
            <svg viewBox="0 0 24 24" aria-hidden="true"
              ><path d="M5 5v14l10-7z"></path><rect x="16.5" y="5" width="3" height="14" rx="1"></rect></svg
            >
          </button>
          <button type="button" class="rd-ctl" data-rd-shuffle aria-pressed="false" aria-label="Shuffle">
            <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
              ><path d="M16 4h4v4M4 20 20 4M20 16v4h-4M15 15l5 5M4 4l5 5"></path></svg
            >
          </button>
          <div class="rd-progress">
            <span class="rd-status t-mono" data-rd-status>Call 1 / {exchanges.length} · Lap {exchanges[0].lap}</span>
            <span class="rd-segs" aria-hidden="true">
              {exchanges.map((ex, i) => <i data-rd-seg={i} data-spk={ex.car} />)}
            </span>
          </div>
        </div>
      </div>

      <!-- ======== radio log ======== -->
      <aside class="rd-log" aria-labelledby="rd-log-title" data-reveal="up">
        <div class="rd-log-head">
          <h3 class="rd-log-title t-condensed" id="rd-log-title">Radio log</h3>
          <span class="t-mono t-mute">{exchanges.length} {exchanges.length === 1 ? 'call' : 'calls'}</span>
        </div>
        <ol class="rd-list">
          {
            exchanges.map((ex, i) => (
              <li>
                <button type="button" class="rd-item" data-rd-item={i} data-spk={ex.car}>
                  <span class="rd-item-lap t-mono" aria-hidden="true">L{ex.lap}</span>
                  <span class="rd-item-body">
                    <span class="rd-item-route t-mono" aria-hidden="true">
                      {route(ex)}
                    </span>
                    <span class="rd-item-q" aria-hidden="true">
                      <b class="rd-from" data-spk={ex.lines[0].from}>{ex.lines[0].from}</b> “{ex.lines[0].text}”
                    </span>
                    <span class="rd-item-a" aria-hidden="true">
                      <span class="rd-redact">Reply redacted by the stewards</span>
                      <span class="rd-reply">
                        {ex.lines.slice(1).map((l) => (
                          <span class="rd-reply-line">
                            <b class="rd-from" data-spk={l.from}>{l.from}</b> “{l.text}”
                          </span>
                        ))}
                      </span>
                    </span>
                    <span class="visually-hidden">{spoken(ex)}</span>
                  </span>
                  <span class="rd-item-eq" aria-hidden="true">
                    <i />
                    <i />
                    <i />
                  </span>
                </button>
              </li>
            ))
          }
        </ol>
      </aside>
    </div>
    <p class="visually-hidden" aria-live="polite" data-rd-live></p>
  </div>
</section>

<script>
  import { sound, type ClipHandle } from '@/scripts/audio';
  import { prefersReducedMotion, isLowPowerDevice } from '@/scripts/motion';
  import type { RadioSpeaker } from '@/data/lore';

  interface Line {
    from: RadioSpeaker;
    text: string;
    /** URL of the spoken clip, when one was generated. */
    clip?: string;
  }
  interface Exchange {
    lap: number;
    car: RadioSpeaker;
    lines: Line[];
  }
  interface SpeakerInfo {
    name: string;
    code: string;
    /** null = pit wall (the owner). */
    car: number | null;
  }
  type Who = RadioSpeaker | '';

  /**
   * How each speaker's recorded line is played. The owner is sped up: higher,
   * smaller, cattier (his clips are recorded slow to land at a normal pace).
   * #17 keeps losing signal.
   */
  interface Voice {
    /** Playback speed of the clip; above 1 also raises the pitch. */
    rate: number;
    volume: number;
    /** ms per typed character when there's no voice to keep time with. */
    pace: number;
    /** How often the signal cuts out (0–1). */
    dropout: number;
  }
  const VOICES: Record<RadioSpeaker, Voice> = {
    Poosa: { rate: 1.14, volume: 1, pace: 42, dropout: 0 },
    Isuru: { rate: 1, volume: 0.95, pace: 31, dropout: 0 },
    Yasas: { rate: 1, volume: 0.95, pace: 35, dropout: 0.22 },
  };
  /** Longest a line waits for its clip to download before going ahead silent. */
  const CLIP_WAIT = 1500;
  const OWNER: RadioSpeaker = 'Poosa';

  const root = document.querySelector<HTMLElement>('[data-rd-root]');
  const screen = root?.querySelector<HTMLElement>('[data-rd-screen]');

  function parse(raw: string | undefined): unknown {
    try {
      return JSON.parse(raw ?? 'null');
    } catch {
      return null;
    }
  }
  const rawExchanges = parse(root?.dataset.exchanges);
  const exchanges = (Array.isArray(rawExchanges) ? (rawExchanges as Exchange[]) : []).filter(
    (ex) => ex && Array.isArray(ex.lines) && ex.lines.length > 0,
  );
  const rawSpeakers = parse(root?.dataset.speakers);
  const speakers: Partial<Record<RadioSpeaker, SpeakerInfo>> =
    rawSpeakers && typeof rawSpeakers === 'object' ? (rawSpeakers as Partial<Record<RadioSpeaker, SpeakerInfo>>) : {};

  if (root && screen && exchanges.length) {
    function $<T extends Element = HTMLElement>(sel: string): T | null {
      return root!.querySelector<T>(sel);
    }
    const overlay = $('[data-rd-overlay]');
    const dirEl = $('[data-rd-dir]');
    const lapEl = $('[data-rd-lap]');
    const onboardEl = $('[data-rd-onboard]');
    const carNumEl = $<SVGTextElement>('[data-rd-carnum]');
    const idleEl = $('[data-rd-idle]');
    const statusEl = $('[data-rd-status]');
    const liveEl = document.querySelector<HTMLElement>('[data-rd-live]');
    const playBtn = $<HTMLButtonElement>('[data-rd-play]');
    const nextBtn = $<HTMLButtonElement>('[data-rd-next]');
    const shuffleBtn = $<HTMLButtonElement>('[data-rd-shuffle]');
    const canvas = $<HTMLCanvasElement>('[data-rd-wave]');
    const sweep = $('[data-rd-sweep]');
    const lineEls = Array.from(root.querySelectorAll<HTMLElement>('[data-rd-line]'));
    const items = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-rd-item]'));
    const segs = Array.from(root.querySelectorAll<HTMLElement>('[data-rd-seg]'));

    const reduced = prefersReducedMotion();

    // Playback state
    let current = 0;
    let playing = false;
    let continuous = false;
    let completed = false;
    let runId = 0;
    let shuffle = false;
    let userEngaged = false;
    let who: Who = '';
    let voice: ClipHandle | null = null;
    const heard = new Set<number>();

    // Waveform state
    const ctx2d = canvas?.getContext('2d') ?? null;
    const BARS = 22;
    const heights = new Float32Array(BARS);
    let speaking = false;
    let pulse = 0;
    let level = 0;
    let raf = 0;
    let visible = false;
    let freq: Uint8Array<ArrayBuffer> | null = null;
    let cw = 0;
    let chh = 0;
    let waveColour = '';

    const wait = (ms: number) => new Promise<void>((r) => window.setTimeout(r, ms));
    const isOwner = (from: RadioSpeaker) => from === OWNER;
    const info = (id: RadioSpeaker): SpeakerInfo => speakers[id] ?? { name: id, code: '', car: null };
    const carOf = (ex: Exchange) => info(ex.car).car;

    /* ---------------- UI state ---------------- */
    function setPlaying(value: boolean): void {
      playing = value;
      root!.dataset.playing = String(value);
      playBtn?.setAttribute('aria-label', value ? 'Pause team radio' : 'Play team radio');
    }

    function setCurrent(idx: number): void {
      current = idx;
      const ex = exchanges[idx];
      const car = info(ex.car);
      if (lapEl) lapEl.textContent = String(ex.lap);
      if (statusEl) statusEl.textContent = `Call ${idx + 1} / ${exchanges.length} · Lap ${ex.lap}`;
      if (onboardEl) onboardEl.textContent = `#${car.car ?? ''} ${car.code}`.trim();
      if (carNumEl) carNumEl.textContent = String(car.car ?? '');
      items.forEach((b, i) => {
        if (i === idx) b.setAttribute('aria-current', 'true');
        else b.removeAttribute('aria-current');
      });
      segs.forEach((s, i) => {
        s.dataset.state = i === idx ? 'on' : heard.has(i) ? 'done' : '';
      });
      setWho('');
    }

    /** Who's keyed up: drives the name bar card, team colour and the direction tag. */
    function setWho(from: RadioSpeaker | ''): void {
      who = from;
      const ex = exchanges[current];
      if (overlay) {
        overlay.dataset.who = who;
        overlay.dataset.card = who || ex.car;
      }
      waveColour = '';
      if (dirEl) {
        const car = carOf(ex);
        dirEl.textContent = !who
          ? 'Team radio'
          : isOwner(who)
            ? `Pit wall → Car ${car ?? ''}`.trim()
            : `Car ${info(who).car ?? car ?? ''} → Pit wall`;
      }
    }

    function setSpeaking(value: boolean): void {
      speaking = value;
      kick();
    }

    function clearLines(): void {
      lineEls.forEach((el) => {
        el.hidden = true;
        el.removeAttribute('data-typing');
        const typed = el.querySelector<HTMLElement>('[data-rd-typed]');
        const rest = el.querySelector<HTMLElement>('[data-rd-rest]');
        if (typed) typed.textContent = '';
        if (rest) rest.textContent = '';
      });
      if (idleEl) idleEl.hidden = false;
    }

    function markHeard(idx: number): void {
      heard.add(idx);
      items[idx]?.setAttribute('data-heard', '');
      segs[idx]?.setAttribute('data-state', idx === current ? 'on' : 'done');
    }

    /* ---------------- voice ---------------- */
    /** One waveform pulse per syllable (this also runs the bars with sound off). */
    function syllable(from: RadioSpeaker): void {
      const v = VOICES[from] ?? VOICES.Isuru;
      // "No signal": some syllables never make it out of the jungle.
      pulse = v.dropout && Math.random() < v.dropout ? 0.25 : 1;
    }

    /** Sound on: fetch a line's clip. Null when muted, missing or too slow to arrive. */
    function fetchClip(line: Line): Promise<AudioBuffer | null> {
      if (!line.clip || !sound.running) return Promise.resolve(null);
      return Promise.race([sound.load(line.clip), wait(CLIP_WAIT).then(() => null)]);
    }

    /** Transcript label: "Poosa · RAT · Pit wall" / "Isuru · #13 DHA". */
    function label(from: RadioSpeaker): string {
      const s = info(from);
      return s.car == null ? `${s.name} · ${s.code} · Pit wall` : `${s.name} · #${s.car} ${s.code}`;
    }

    /* ---------------- playback ---------------- */
    async function speak(el: HTMLElement, line: Line, id: number): Promise<boolean> {
      const typed = el.querySelector<HTMLElement>('[data-rd-typed]');
      const rest = el.querySelector<HTMLElement>('[data-rd-rest]');
      const whoEl = el.querySelector<HTMLElement>('[data-rd-who]');
      const cfg = VOICES[line.from] ?? VOICES.Isuru;
      if (whoEl) whoEl.textContent = label(line.from);
      el.dataset.spk = line.from;
      // Captions roll like the broadcast: only the last two lines stay up.
      const idx = lineEls.indexOf(el);
      if (idx >= 2) lineEls[idx - 2].hidden = true;
      if (typed) typed.textContent = reduced ? line.text : '';
      if (rest) rest.textContent = reduced ? '' : line.text;
      if (!reduced) el.setAttribute('data-typing', '');
      el.hidden = false;
      if (idleEl) idleEl.hidden = true;
      setWho(line.from);
      if (!reduced && sweep) {
        sweep.animate(
          [
            { transform: 'translateX(-110%)', opacity: 0 },
            { opacity: 1, offset: 0.2 },
            { transform: 'translateX(110%)', opacity: 0 },
          ],
          { duration: 650, easing: 'cubic-bezier(0.65, 0, 0.35, 1)' },
        );
      }

      sound.play('radio', { volume: 0.55 });
      const [buf] = await Promise.all([fetchClip(line), wait(260)]);
      if (id !== runId) return false;

      setSpeaking(true);
      const text = line.text;
      voice =
        buf && line.clip
          ? sound.clip(line.clip, { pitch: cfg.rate, volume: cfg.volume, dropout: cfg.dropout, radio: true })
          : null;
      // With a voice the typing keeps time with it; without one it sets its own pace.
      const per = voice ? (voice.duration * 1000) / text.length : 0;
      const began = performance.now();
      let prevVowel = false;
      let lastPulse = 0;
      for (let i = 0; i < text.length; i++) {
        const ch = text[i];
        if (!reduced) {
          if (typed) typed.textContent = text.slice(0, i + 1);
          if (rest) rest.textContent = text.slice(i + 1);
        }
        const vowel = /[aeiouy]/i.test(ch);
        const now = performance.now();
        if (vowel && !prevVowel && now - lastPulse > 62) {
          syllable(line.from);
          lastPulse = now;
        }
        prevVowel = vowel;
        const pause = /[.?!…]/.test(ch) ? 190 : ch === ',' ? 130 : ch === ' ' ? 14 : 0;
        await wait(voice ? Math.max(0, began + per * (i + 1) - performance.now()) : cfg.pace + pause);
        if (id !== runId) {
          setSpeaking(false);
          return false;
        }
      }
      setSpeaking(false);
      voice = null;
      el.removeAttribute('data-typing');
      sound.play('radio', { pitch: 0.8, volume: 0.45 });
      await wait(reduced ? 1400 : 1000);
      return id === runId;
    }

    async function playExchange(idx: number, announce: boolean): Promise<void> {
      const id = ++runId;
      completed = false;
      setCurrent(idx);
      clearLines();
      setPlaying(true);
      const ex = exchanges[idx];
      if (announce && liveEl) {
        liveEl.textContent = `Lap ${ex.lap}. ${ex.lines.map((l) => `${l.from}: ${l.text}`).join(' ')}`;
      }
      // Get the whole call downloading now so the replies start on cue.
      for (const line of ex.lines) void fetchClip(line);
      await wait(220);
      if (id !== runId) return;
      for (let i = 0; i < ex.lines.length && i < lineEls.length; i++) {
        const ok = await speak(lineEls[i], ex.lines[i], id);
        if (!ok) return;
      }
      setWho('');
      completed = true;
      markHeard(idx);

      if (continuous) {
        const next = nextIndex();
        if (next == null) {
          setPlaying(false);
          if (statusEl) statusEl.textContent = 'End of transmission · champions, all of them';
          return;
        }
        await wait(1100);
        if (id !== runId) return;
        void playExchange(next, announce);
      } else {
        setPlaying(false);
        const left = exchanges.length - heard.size;
        if (statusEl) {
          statusEl.textContent = left > 0
            ? `Press play for more · ${left} ${left === 1 ? 'call' : 'calls'} left`
            : 'End of transmission · champions, all of them';
        }
      }
    }

    function nextIndex(): number | null {
      if (shuffle) {
        const all = exchanges.map((_, i) => i).filter((i) => i !== current);
        const fresh = all.filter((i) => !heard.has(i));
        const pool = fresh.length ? fresh : all;
        return pool.length ? pool[Math.floor(Math.random() * pool.length)] : current;
      }
      return current + 1 < exchanges.length ? current + 1 : null;
    }

    function stop(): void {
      runId++;
      voice?.stop();
      voice = null;
      setSpeaking(false);
      setPlaying(false);
      lineEls.forEach((el) => el.removeAttribute('data-typing'));
    }

    /* ---------------- controls ---------------- */
    playBtn?.addEventListener('click', () => {
      userEngaged = true;
      if (playing) {
        stop();
        return;
      }
      continuous = true;
      const idx = completed ? (nextIndex() ?? 0) : current;
      void playExchange(idx, true);
    });

    nextBtn?.addEventListener('click', () => {
      userEngaged = true;
      continuous = true;
      const idx = nextIndex() ?? 0;
      stop();
      void playExchange(idx, true);
    });

    shuffleBtn?.addEventListener('click', () => {
      shuffle = !shuffle;
      shuffleBtn.setAttribute('aria-pressed', String(shuffle));
      sound.play('click');
    });

    items.forEach((btn, i) => {
      btn.addEventListener('click', () => {
        userEngaged = true;
        continuous = true;
        stop();
        void playExchange(i, true);
      });
    });

    /* ---------------- waveform (canvas) ---------------- */
    function resize(): void {
      if (!canvas || !ctx2d) return;
      const dpr = Math.min(window.devicePixelRatio || 1, isLowPowerDevice() ? 1.5 : 2);
      const r = canvas.getBoundingClientRect();
      cw = Math.max(1, Math.round(r.width * dpr));
      chh = Math.max(1, Math.round(r.height * dpr));
      canvas.width = cw;
      canvas.height = chh;
      draw(performance.now());
    }

    /** The speaker's team colour, read once per key-up from the overlay's --who token. */
    function colour(): string {
      if (!waveColour) {
        const v = overlay ? getComputedStyle(overlay).getPropertyValue('--who').trim() : '';
        waveColour = v || '#6c6a78';
      }
      return waveColour;
    }
    const centreWeight = (i: number) => 1 - Math.abs(i - (BARS - 1) / 2) / (BARS / 2);
    const wobble = (i: number, t: number) =>
      0.45 + 0.55 * Math.abs(Math.sin(i * 1.7 + t * 0.017) * Math.cos(i * 0.6 - t * 0.011));

    function draw(t: number): void {
      if (!ctx2d || !cw) return;
      ctx2d.clearRect(0, 0, cw, chh);
      const analyser = speaking && sound.running ? sound.getAnalyser() : null;
      if (analyser) {
        if (!freq || freq.length !== analyser.frequencyBinCount) freq = new Uint8Array(analyser.frequencyBinCount);
        analyser.getByteFrequencyData(freq);
      }
      const binHz = analyser ? analyser.context.sampleRate / analyser.fftSize : 1;
      const gap = cw / BARS;
      const bw = Math.max(1, gap * 0.52);
      ctx2d.fillStyle = colour();
      for (let i = 0; i < BARS; i++) {
        let target = level * (0.25 + 0.75 * centreWeight(i)) * wobble(i, t);
        if (analyser && freq) {
          const hz = 250 + (i / BARS) * 3800;
          const v = (freq[Math.min(freq.length - 1, Math.round(hz / binHz))] ?? 0) / 255;
          target = Math.max(target * 0.6, v * 1.1);
        }
        heights[i] += (target - heights[i]) * (target > heights[i] ? 0.55 : 0.2);
        const h = Math.max(chh * 0.1, Math.min(1, heights[i]) * chh * 0.94);
        const x = i * gap + (gap - bw) / 2;
        const y = (chh - h) / 2;
        ctx2d.globalAlpha = 0.5 + 0.5 * Math.min(1, heights[i] * 1.4);
        if (typeof ctx2d.roundRect === 'function') {
          ctx2d.beginPath();
          ctx2d.roundRect(x, y, bw, h, bw / 2);
          ctx2d.fill();
        } else ctx2d.fillRect(x, y, bw, h);
      }
      ctx2d.globalAlpha = 1;
    }

    function frame(t: number): void {
      raf = 0;
      const target = speaking ? 0.35 + pulse * 0.65 : 0;
      level += (target - level) * 0.25;
      pulse *= 0.86;
      draw(t);
      const settled = !speaking && level < 0.01 && heights.every((h) => h < 0.01);
      if (visible && !document.hidden && !settled) raf = requestAnimationFrame(frame);
    }

    function kick(): void {
      if (reduced) {
        // Static but designed: a frozen mid-word waveform while talking, flat when idle.
        level = speaking ? 0.85 : 0;
        for (let i = 0; i < BARS; i++) heights[i] = level * (0.25 + 0.75 * centreWeight(i)) * wobble(i, 420);
        draw(420);
        return;
      }
      if (!raf && visible && !document.hidden) raf = requestAnimationFrame(frame);
    }

    if (canvas && ctx2d) {
      if ('ResizeObserver' in window) new ResizeObserver(resize).observe(canvas);
      else resize();
    }

    /* ---------------- visibility: pause loops, autoplay once ---------------- */
    let autoplayed = false;
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            visible = e.isIntersecting;
            screen.classList.toggle('is-live', visible);
            if (visible) kick();
            if (visible && e.intersectionRatio >= 0.5 && !autoplayed && !userEngaged) {
              autoplayed = true;
              continuous = false;
              window.setTimeout(() => {
                if (!userEngaged && !playing) void playExchange(0, false);
              }, 450);
            }
          }
        },
        { threshold: [0, 0.5] },
      );
      io.observe(screen);
    } else {
      visible = true;
    }
    document.addEventListener('visibilitychange', () => {
      if (!document.hidden) kick();
    });

    setCurrent(0);
  }
</script>

