              <path
                transform="translate(0 -90)"
                fill="url(#rd-windows)"
                d="M0 610V520h60v-40h50v60h40v-110h70v130h30v-70h90v90h40v-150h55v150h60v-60h80v80h50v-30h60v40h110v-40h70v30h60v-80h50v-40h60v120h70v-60h40v40h50v-130h60v90h80v-50h70v80h40v-100h90v130h60v-40h60v40h55v100z"
              ></path>
              <!-- floodlight towers -->
              <g class="rd-floods" transform="translate(0 -90)">
