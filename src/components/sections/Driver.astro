---
/**
 * 01 — THE DRIVER.
 * Official-F1-style profile of Nirod "පූසා" Rathnaweera: giant outlined #9,
 * clip-path portrait reveal with parallax, RAT timing chip, dictionary-style
 * nickname, count-up stats, a holographic collectible card and the dossier.
 * Every fact comes from src/data/lore.ts.
 */
import SectionHeading from '@/components/ui/SectionHeading.astro';
import PhotoSlot from '@/components/ui/PhotoSlot.astro';
import Emblem from '@/components/ui/Emblem.astro';
import { driver, stats, sinhala, team } from '@/data/lore';
import { driverPortrait, resolvePhoto } from '@/data/photos';

const surname = driver.lastName.toUpperCase();
const codeLen = driver.code.length;
const ratChars = surname.slice(0, codeLen).split('');
const tailChars = surname.slice(codeLen).split('');

type Fx = 'helmet' | 'licence' | 'track' | 'zoomies' | 'laser' | 'radio';
const facts: { k: string; v: string; fx: Fx }[] = [
  { k: 'Helmet', v: driver.helmet, fx: 'helmet' },
  { k: 'Super licence', v: driver.superLicence, fx: 'licence' },
  { k: 'Favourite track', v: driver.favouriteTrack, fx: 'track' },
  { k: 'Signature move', v: driver.signatureMove, fx: 'zoomies' },
  { k: 'Weakness', v: driver.weakness, fx: 'laser' },
  { k: 'Radio catchphrase', v: driver.radioCatchphrase, fx: 'radio' },
];

const statRows = stats.map((s, i) => {
  const decimals = 'decimals' in s ? s.decimals : 0;
  const mode = s.value === 0 ? 'deleted' : decimals > 0 ? 'down' : 'up';
  return {
    ...s,
    idx: String(i + 1).padStart(2, '0'),
    decimals,
    mode,
    display: s.value.toFixed(decimals),
    lives: s.suffix === '/9',
  };
});

// Until a real portrait lands, the placeholder shows the emblem — copy must not point at a photo.
const hasPortrait = Boolean(resolvePhoto(driverPortrait).src);

const pick = (label: string) => stats.find((s) => s.label === label)?.value ?? 0;
const cardStats = [
  { k: 'Lives', v: pick('Lives remaining') },
  { k: 'Naps', v: pick('Naps per race weekend') },
  { k: 'Fast laps', v: pick('Fastest laps') },
];
---

<section class="section driver" id="driver" aria-labelledby="driver-title" data-driver>
  <div class="driver-bg" aria-hidden="true">
    <span class="bg-glow"></span>
    <span class="bg-stripes"></span>
    <span class="bg-rail t-mono">Driver profile · #{driver.number} · {driver.code} · {team.name} · {team.car}</span>
  </div>

  <div class="container">
    <SectionHeading
      index="01"
      kicker="The Driver"
      title="Nine lives. <em>One seat.</em>"
      id="driver-title"
    />

    <!-- ============ Profile ============ -->
    <div class="profile">
      <div class="portrait-col">
        <figure class="portrait">
          <div class="portrait-stack">
            <div class="nine" aria-hidden="true">
              <span class="nine-fill" data-nine-fill>{driver.number}</span>
              <span class="nine-line" data-nine-line>{driver.number}</span>
            </div>
            <div class="portrait-frame" data-portrait-frame>
              <div class="portrait-media" data-portrait-media>
                <PhotoSlot
                  photo={driverPortrait}
                  sizes="(min-width: 960px) 38vw, 92vw"
                  widths={[480, 720, 1080]}
                />
              </div>
              <span class="portrait-shade" aria-hidden="true"></span>
              <span class="portrait-scan" aria-hidden="true"></span>
              <span class="portrait-sweep" aria-hidden="true"></span>
              <span class="portrait-tag t-mono" aria-hidden="true">
                <b>#{driver.number}</b>
                {driver.code}
              </span>
              <span class="portrait-corner tl" aria-hidden="true"></span>
              <span class="portrait-corner br" aria-hidden="true"></span>
            </div>
          </div>
          {hasPortrait && <figcaption class="portrait-cap t-mono">{driverPortrait.caption}</figcaption>}
        </figure>
      </div>

      <div class="identity" data-reveal-stagger="90">
        <p class="id-meta t-mono" data-reveal="fade">
          <span class="id-num">#{driver.number}</span>
          <span class="id-flag" role="img" aria-label={`Flag of ${driver.nationality}`}>{driver.flag}</span>
          <span>{driver.nationality}</span>
          <span class="id-sep" aria-hidden="true">/</span>
          <span>{team.name}</span>
        </p>

        <h3 class="name" data-reveal="fade">
          <span class="visually-hidden">{driver.fullName}</span>
          <span class="name-first" aria-hidden="true">
            <span>{driver.firstName}</span>
            <span class="name-middle">{driver.middleName}</span>
          </span>
          <span class="name-last t-condensed" aria-hidden="true">
            <span class="name-rat">
              {ratChars.map((c, i) => <span class="ch" style={`--ci:${i}`}>{c}</span>)}
            </span>{
              tailChars.map((c, i) => (
                <span class="ch" style={`--ci:${i + codeLen}`}>
                  {c}
                </span>
              ))
            }
          </span>
        </h3>

        <div class="code" data-reveal="up">
          <button class="code-chip" type="button" data-rat aria-describedby="driver-rat-joke">
            <span class="code-bar" aria-hidden="true"></span>
            <span class="code-pos t-mono" aria-hidden="true">P9</span>
            <span class="code-txt">{driver.code}</span>
            <span class="visually-hidden">— timing code. Press to ask the stewards.</span>
          </button>
          <p class="code-joke" id="driver-rat-joke">
            <strong>Timing code: {driver.code}.</strong> First three letters of the surname, FIA rules. A cat
            whose code is RAT. The stewards called it “deeply ironic, but legal”.
          </p>
        </div>

        <div class="nick" data-reveal="up">
          <p class="nick-word t-si" lang="si">{driver.nickname}</p>
          <div class="nick-def">
            <p class="nick-meta t-mono">
              <i>{driver.nicknameLatin}</i> · noun · Sinhala
            </p>
            <ol class="nick-senses">
              <li>{driver.nicknameMeaning}.</li>
              <li>this guy. <span class="t-mute">({hasPortrait ? 'see photo' : 'see emblem'})</span></li>
            </ol>
            <p class="nick-etym">
              The formal word is <span class="t-si" lang="si">{sinhala.balala.si}</span>{' '}
              (<i>{sinhala.balala.latin}</i>). Say it fast enough and you get <b>Bilal</b>. That’s the whole
              team name. We’re not sorry.
            </p>
          </div>
        </div>

        <p class="role t-mono" data-reveal="up"><span aria-hidden="true">▸</span> {driver.role}</p>

        <p class="bio" data-reveal="up">
          Born to race. Raised to nap. {driver.fullName} — <span class="t-si" lang="si">{driver.nickname}</span> to
          anyone who has met him — carries <b>#{driver.number}</b> because a cat gets nine lives and he is
          speed-running them. Quick in a straight line, quicker near a tuna can, undefeated in the Horizontal
          Standings. He once drove Malabe → Balangoda mid-lockdown on a police-approved pass, which is more
          paperwork than most of the grid will ever see.
        </p>
      </div>
    </div>

    <!-- ============ Stats ============ -->
    <div class="stats-block">
      <header class="block-head" data-reveal="fade">
        <p class="t-mono"><span class="t-gold">Season stats</span> · official-ish</p>
        <p class="t-mono t-mute">Source: team telemetry (a notebook)</p>
      </header>
      <ul class="stats" role="list" data-stats data-reveal-stagger="80">
        {
          statRows.map((s) => (
            <li class:list={['stat', `stat--${s.mode}`]} data-reveal="up" data-stat>
              <p class="stat-label t-mono">
                <span class="stat-idx">{s.idx}</span>
                {s.label}
              </p>
              <p class="stat-value t-condensed">
                <span class="visually-hidden">
                  {s.display}
                  {s.suffix}
                </span>
                <span class="stat-figure" aria-hidden="true">
                  <span
                    class="stat-num"
                    data-count={s.value}
                    data-decimals={s.decimals}
                    data-mode={s.mode}
                  >
                    {s.display}
                  </span>
                  <span class="stat-suffix">{s.suffix}</span>
                </span>
              </p>
              {s.mode === 'deleted' && (
                <span class="stat-flag t-mono" aria-hidden="true">
                  Lap deleted
                </span>
              )}
              {s.lives && (
                <span class="lives" aria-hidden="true">
                  {Array.from({ length: 9 }, (_, k) => (
                    <span class="pip" style={`--k:${k}`}>
                      <svg viewBox="0 0 20 20">
                        <ellipse cx="10" cy="13.2" rx="4.6" ry="3.8" />
                        <circle cx="4.4" cy="8.4" r="1.9" />
                        <circle cx="8" cy="5.2" r="1.9" />
                        <circle cx="12" cy="5.2" r="1.9" />
                        <circle cx="15.6" cy="8.4" r="1.9" />
                      </svg>
                    </span>
                  ))}
                </span>
              )}
              <p class="stat-note">{s.note}</p>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- ============ Collectible + dossier ============ -->
    <div class="collect">
      <div class="card-zone" data-reveal="scale">
        <div class="tcard-float">
          <div
            class="tcard"
            id="driver-tcard"
            data-tcard
            role="group"
            aria-roledescription="trading card"
            aria-label={`Collectible driver card: ${driver.firstName} “${driver.nicknameLatin}” ${driver.lastName}, #${driver.number}, ${team.name}. Nine Lives Edition, 1 of 1.`}
          >
            <div class="tcard-inner">
              <!-- front -->
              <div class="tcard-face tcard-front" data-tcard-front>
                <span class="tcard-foil" aria-hidden="true"></span>
                <div class="tcard-body">
                  <header class="tcard-top">
                    <Emblem size="1.9rem" title="" />
                    <span class="t-mono">{team.name} · {team.founded}</span>
                    <span class="tcard-no t-condensed">{driver.number}</span>
                  </header>
                  <div class="tcard-photo">
                    <PhotoSlot photo={driverPortrait} sizes="320px" widths={[360, 640]} />
                    <span class="tcard-code t-condensed">{driver.code}</span>
                  </div>
                  <p class="tcard-name t-condensed">
                    <span>{driver.firstName}</span>
                    {driver.lastName}
                  </p>
                  <dl class="tcard-stats">
                    {
                      cardStats.map((c) => (
                        <div>
                          <dt class="t-mono">{c.k}</dt>
                          <dd class="t-condensed">{c.v}</dd>
                        </div>
                      ))
                    }
                  </dl>
                  <footer class="tcard-foot t-mono">
                    <span>Nine Lives Edition</span>
                    <span class="tcard-seal">1/1</span>
                  </footer>
                </div>
                <span class="tcard-glare" aria-hidden="true"></span>
              </div>
              <!-- back: hidden from assistive tech until the card is flipped -->
              <div class="tcard-face tcard-back" data-tcard-back aria-hidden="true">
                <span class="tcard-foil" aria-hidden="true"></span>
                <div class="tcard-body tcard-body--back">
                  <p class="t-mono tcard-serial">Card #009 · 1 of 1</p>
                  <Emblem size="6.5rem" title="" />
                  <blockquote class="tcard-quote">“If I fits, I sits. If I sits, I wins.”</blockquote>
                  <p class="t-mono tcard-small">
                    Collect all 1. Trade value: one (1) tuna can. Do not bend. Do not leave on a warm bonnet.
                  </p>
                  <span class="tcard-barcode" aria-hidden="true"></span>
                </div>
                <span class="tcard-glare" aria-hidden="true"></span>
              </div>
            </div>
          </div>
        </div>
        <span class="tcard-shadow" aria-hidden="true"></span>
        <button class="flip-btn t-mono" type="button" data-flip aria-pressed="false" aria-controls="driver-tcard">
          <span class="flip-ico" aria-hidden="true">↻</span>
          <span data-flip-label>Flip the card</span>
        </button>
        <p class="card-hint t-mono t-mute" aria-hidden="true">
          <span class="hint-hover">Hover to tilt · </span><span class="hint-touch">Tilt your head, it’s a cat thing · </span>rarer
          than a pole position
        </p>
      </div>

      <div class="dossier">
        <header class="block-head" data-reveal="fade">
          <p class="t-mono"><span class="t-gold">Paddock dossier</span> · file #009</p>
          <p class="t-mono t-mute">Classified-ish</p>
        </header>
        <dl class="facts" data-reveal-stagger="70">
          {
            facts.map((f, i) => (
              <div class:list={['fact', `fx-${f.fx}`]} data-reveal="left">
                <dt class="t-mono">
                  <span class="fact-idx">{String(i + 1).padStart(2, '0')}</span>
                  {f.k}
                </dt>
                <dd>
                  <span class="fact-v">{f.v}</span>
                  {f.fx === 'laser' && <span class="laser" aria-hidden="true" />}
                  {f.fx === 'radio' && (
                    <span class="radio-wave" aria-hidden="true">
                      <i />
                      <i />
                      <i />
                      <i />
                      <i />
                    </span>
                  )}
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </div>
</section>

<style>
  /* ================= Section shell ================= */
  .driver {
    --d-line: color-mix(in oklab, var(--c-gold) 38%, transparent);
    overflow-x: clip;
  }

  .driver-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    overflow: hidden;
  }

  .bg-glow {
    position: absolute;
    width: min(70rem, 140vw);
    aspect-ratio: 1;
    left: -20%;
    top: 8%;
    background: radial-gradient(closest-side, rgb(160 21 62 / 0.28), transparent 70%);
    filter: blur(10px);
  }

  .bg-stripes {
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      115deg,
      transparent 0 44px,
      rgb(255 255 255 / 0.018) 44px 46px
    );
    mask-image: linear-gradient(to bottom, transparent, #000 20%, #000 70%, transparent);
  }

  .bg-rail {
    display: none;
  }

  @media (min-width: 75em) {
    .bg-rail {
      display: block;
      position: absolute;
      top: 50%;
      left: 0.9rem;
      translate: 0 -50%;
      writing-mode: vertical-rl;
      rotate: 180deg;
      color: var(--c-faint);
      font-size: 0.62rem;
      white-space: nowrap;
    }
  }

  .block-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-2) var(--space-5);
    padding-bottom: var(--space-4);
    margin-bottom: var(--space-5);
    border-bottom: 1px solid var(--c-line-strong);
  }

  /* ================= Profile ================= */
  .profile {
    display: grid;
    gap: var(--space-8);
    align-items: center;
  }

  @media (min-width: 60em) {
    .profile {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: clamp(3rem, 6vw, 7rem);
    }
  }

  /* ---- Portrait + giant 9 ---- */
  .portrait-col {
    position: relative;
    container-type: inline-size;
    padding-block: 10cqi 0;
  }

  /* Giant #9: a livery-filled numeral behind, an outline in front (layered depth). */
  .nine {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .portrait-stack {
    position: relative;
  }

  .nine > span {
    position: absolute;
    top: 50%;
    left: -21cqi;
    font-family: var(--f-display);
    font-weight: 900;
    font-stretch: 62%;
    font-variation-settings: 'wdth' 62;
    font-size: 158cqi;
    line-height: 0.74;
    letter-spacing: -0.04em;
    will-change: transform;
  }

  .nine-fill {
    z-index: -1;
    translate: 7cqi -47%;
    background: var(--g-livery);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    opacity: 0.3;
  }

  .nine-line {
    z-index: 2;
    translate: 0 -52%;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--d-line);
    mix-blend-mode: screen;
  }

  .portrait {
    position: relative;
    isolation: isolate;
    width: min(84%, 28rem);
    margin-left: auto;
  }

  .portrait .portrait-media :global(.ph-emblem),
  .tcard .tcard-photo :global(.ph-emblem) {
    width: clamp(4.5rem, 30cqi, 8.5rem);
    height: auto;
    max-width: none;
  }

  .portrait-frame {
    --wipe: 1;
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--radius-m);
    background: var(--c-graphite);
    box-shadow:
      0 2.5rem 5rem -2rem rgb(0 0 0 / 0.8),
      0 0 0 1px var(--c-line-strong);
    clip-path: polygon(
      0 0,
      calc(var(--wipe) * 135%) 0,
      calc(var(--wipe) * 135% - 35%) 100%,
      0 100%
    );
  }

  .portrait-media {
    position: absolute;
    inset: -8% 0;
    will-change: transform;
  }

  .portrait-media :global(.photo-slot) {
    height: 100%;
    border: 0;
    border-radius: 0;
  }

  .portrait-shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to top, rgb(7 7 11 / 0.85), transparent 38%),
      linear-gradient(115deg, rgb(160 21 62 / 0.25), transparent 45%);
    pointer-events: none;
  }

  .portrait-scan {
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(to bottom, rgb(255 255 255 / 0.035) 0 1px, transparent 1px 4px);
    mix-blend-mode: overlay;
    pointer-events: none;
  }

  /* Gold slash riding the leading edge of the wipe reveal. */
  .portrait-sweep {
    position: absolute;
    top: -5%;
    bottom: -5%;
    left: calc(var(--wipe) * 135% - 17.5% - 3%);
    width: 6%;
    background: linear-gradient(90deg, transparent, var(--c-gold) 45%, #fff 55%, transparent);
    transform: skewX(-15.6deg);
    box-shadow: 0 0 2rem 0.5rem rgb(255 197 46 / 0.45);
    pointer-events: none;
  }

  .portrait-tag {
    position: absolute;
    left: var(--space-4);
    bottom: var(--space-4);
    display: inline-flex;
    gap: var(--space-2);
    align-items: center;
    padding: 0.3rem 0.6rem;
    background: var(--c-gold);
    color: var(--c-on-gold);
    font-weight: 700;
    transform: skewX(var(--skew));
  }

  .portrait-tag b {
    font-weight: 800;
  }

  .portrait-corner {
    position: absolute;
    width: 1.6rem;
    height: 1.6rem;
    border: 2px solid var(--c-gold);
    pointer-events: none;
  }

  .portrait-corner.tl {
    top: var(--space-3);
    left: var(--space-3);
    border-right: 0;
    border-bottom: 0;
  }

  .portrait-corner.br {
    right: var(--space-3);
    bottom: var(--space-3);
    border-left: 0;
    border-top: 0;
  }

  .portrait-cap {
    position: relative;
    z-index: 3;
    margin-top: calc(var(--space-6) + 4cqi);
    color: var(--c-mute);
    font-size: 0.66rem;
    line-height: 1.6;
    text-transform: none;
    letter-spacing: 0.04em;
    max-width: 36ch;
  }

  /* ---- Identity ---- */
  .identity {
    container-type: inline-size;
    display: grid;
    gap: var(--space-5);
    min-width: 0;
  }

  .id-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    color: var(--c-mute);
  }

  .id-num {
    color: var(--c-on-gold);
    background: var(--c-gold);
    padding: 0.15rem 0.5rem;
    font-weight: 800;
    transform: skewX(var(--skew));
  }

  .id-flag {
    font-family: 'Noto Color Emoji', 'Apple Color Emoji', 'Segoe UI Emoji', sans-serif;
    font-size: 1.1rem;
    letter-spacing: 0;
    line-height: 1;
  }

  .id-sep {
    color: var(--c-faint);
  }

  .name {
    display: grid;
    gap: 0.2em;
    text-transform: uppercase;
    line-height: 0.86;
  }

  .name-first {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.35em;
    font-size: clamp(1.4rem, 6.5cqi, 2.6rem);
    font-weight: 500;
    font-stretch: 100%;
    letter-spacing: 0.02em;
    color: var(--c-chalk);
  }

  .name-middle {
    color: var(--c-mute);
    font-weight: 300;
  }

  .name-last {
    display: block;
    font-size: min(9.5rem, 21.5cqi);
    font-weight: 900;
    letter-spacing: -0.015em;
    white-space: nowrap;
    clip-path: inset(-40% -5% -0.06em -5%);
    padding-bottom: 0.04em;
  }

  .name-rat {
    position: relative;
    color: var(--c-gold);
    text-shadow: 0 0 0.35em rgb(255 197 46 / 0.35);
  }

  .ch {
    display: inline-block;
    transition:
      transform 1s var(--ease-out-expo) calc(var(--ci) * 40ms + 120ms),
      opacity 1s var(--ease-out-expo) calc(var(--ci) * 40ms + 120ms);
  }

  :global(.js-motion) .name:not(.is-in) .ch {
    transform: translate3d(0, 105%, 0) rotate(8deg);
    opacity: 0;
  }

  /* ---- RAT chip ---- */
  .code {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4) var(--space-5);
  }

  .code-chip {
    position: relative;
    display: inline-flex;
    align-items: stretch;
    background: var(--c-chalk);
    color: var(--c-carbon);
    border-radius: 0.25rem;
    overflow: hidden;
    box-shadow: 0 0.75rem 2rem -0.75rem rgb(255 197 46 / 0.55);
    transition:
      transform var(--dur-med) var(--ease-out-back),
      box-shadow var(--dur-med) var(--ease-out-expo);
  }

  @media (hover: hover) {
    .code-chip:hover {
      transform: translateY(-3px) rotate(-2deg);
      box-shadow: 0 1rem 2.4rem -0.75rem rgb(255 197 46 / 0.8);
    }
  }

  .code-chip:active {
    transform: scale(0.96);
  }

  .code-chip.is-squeak {
    animation: squeak 520ms var(--ease-out-back);
  }

  @keyframes squeak {
    0% { transform: scale(1); }
    30% { transform: scale(1.12, 0.86) rotate(-4deg); }
    60% { transform: scale(0.94, 1.08) rotate(3deg); }
    100% { transform: scale(1); }
  }

  .code-bar {
