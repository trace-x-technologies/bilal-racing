</style>

<script>
  import { gsap, ScrollTrigger, prefersReducedMotion, isLowPowerDevice } from '@/scripts/motion';
  import { emit } from '@/scripts/bus';
  import { sound } from '@/scripts/audio';

  const root = document.querySelector<HTMLElement>('[data-driver]');
  if (root) initLineup(root);

  function initLineup(section: HTMLElement): void {
    const reduced = prefersReducedMotion();

    // ---- Pause CSS loops (foil, flickering life, card sway) while offscreen ----
    const live = Array.from(section.querySelectorAll<HTMLElement>('[data-live]'));
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            (entry.target as HTMLElement).classList.toggle('is-live', entry.isIntersecting);
          }
        },
        { rootMargin: '10% 0px' },
      );
      live.forEach((el) => io.observe(el));
    } else {
      live.forEach((el) => el.classList.add('is-live'));
    }

    initRatChip(section);
    section.querySelectorAll<HTMLElement>('[data-tcard]').forEach((card) => initCard(section, card, reduced));

    if (reduced) return;
    initPortrait(section);
    initNumbers(section);
    section.querySelectorAll<HTMLElement>('[data-stats]').forEach(initStats);
  }

  /* ---------- Owner portrait: clip-path wipe + layered parallax ---------- */
  function initPortrait(section: HTMLElement): void {
    const col = section.querySelector<HTMLElement>('.portrait-col');
    const frame = section.querySelector<HTMLElement>('[data-portrait-frame]');
    const media = section.querySelector<HTMLElement>('[data-portrait-media]');
    const fill = section.querySelector<HTMLElement>('[data-nine-fill]');
    const line = section.querySelector<HTMLElement>('[data-nine-line]');
    if (!col || !frame || !media) return;

    gsap.set(frame, { '--wipe': 0 });
    gsap.set(media, { scale: 1.3 });
    ScrollTrigger.create({
      trigger: frame,
      start: 'top 82%',
      once: true,
      onEnter: () => {
        gsap.to(frame, { '--wipe': 1, duration: 1.5, ease: 'expo.out' });
        gsap.to(media, { scale: 1.08, duration: 2, ease: 'expo.out' });
      },
    });

    const scrub = { trigger: col, start: 'top bottom', end: 'bottom top', scrub: true };
    gsap.fromTo(media, { yPercent: -5 }, { yPercent: 5, ease: 'none', scrollTrigger: scrub });
    if (line) gsap.fromTo(line, { yPercent: 16 }, { yPercent: -16, ease: 'none', scrollTrigger: scrub });
    if (fill) gsap.fromTo(fill, { yPercent: -8 }, { yPercent: 8, ease: 'none', scrollTrigger: scrub });
  }

  /* ---------- Drivers' giant numbers: counter-drifting layers ---------- */
  function initNumbers(section: HTMLElement): void {
    section.querySelectorAll<HTMLElement>('[data-racer-num]').forEach((wrap) => {
      const zone = wrap.parentElement;
      const fill = wrap.querySelector<HTMLElement>('[data-racer-num-fill]');
      const line = wrap.querySelector<HTMLElement>('[data-racer-num-line]');
      if (!zone) return;
      const scrub = { trigger: zone, start: 'top bottom', end: 'bottom top', scrub: true };
      if (line) gsap.fromTo(line, { yPercent: 14 }, { yPercent: -14, ease: 'none', scrollTrigger: scrub });
      if (fill) gsap.fromTo(fill, { yPercent: -6 }, { yPercent: 6, ease: 'none', scrollTrigger: scrub });
    });
  }

  /* ---------- Stats: count-up with a couple of gags ---------- */
  function initStats(list: HTMLElement): void {
    const cards = Array.from(list.querySelectorAll<HTMLElement>('[data-stat]'));

    const prepared = cards.map((card) => {
      const num = card.querySelector<HTMLElement>('.stat-num');
      const target = Number(num?.dataset.count ?? 0);
      const decimals = Number(num?.dataset.decimals ?? 0);
      const mode = num?.dataset.mode ?? 'up';
      const lives = card.querySelector<HTMLElement>('.lives');
      const pips = lives ? Array.from(lives.querySelectorAll<HTMLElement>('.pip')) : [];
      const start = mode === 'down' ? 9 : 0;
      if (num) num.textContent = start.toFixed(decimals);
      return { card, num, target, decimals, mode, lives, pips, start };
    });

    // Pointer-follow glow (cheap: two custom props, rAF-batched).
    cards.forEach((card) => {
      let frame = 0;
      card.addEventListener('pointermove', (e) => {
        if (frame) return;
        frame = requestAnimationFrame(() => {
          frame = 0;
          const r = card.getBoundingClientRect();
          card.style.setProperty('--mx', `${e.clientX - r.left}px`);
          card.style.setProperty('--my', `${e.clientY - r.top}px`);
        });
      });
    });

    ScrollTrigger.create({
      trigger: list,
      start: 'top 78%',
      once: true,
      onEnter: () => {
        prepared.forEach((s, i) => {
          const { num, decimals, mode, target, card, lives, pips } = s;
          if (!num) return;
          const state = { v: s.start };
          const render = () => {
            num.textContent = state.v.toFixed(decimals);
            if (pips.length) {
              const lit = Math.round(state.v);
              pips.forEach((p, k) => p.classList.toggle('on', k < lit));
            }
          };
          const delay = 0.15 + i * 0.09;
          if (mode === 'deleted') {
            // Counts up to something respectable... then the stewards delete it.
            gsap
              .timeline({ delay })
              .to(state, { v: 3, duration: 0.9, ease: 'power2.out', onUpdate: render })
              .add(() => card.classList.add('is-deleted'), '+=0.15')
              .to(state, { v: 0, duration: 0.35, ease: 'power3.in', onUpdate: render }, '+=0.35')
              .fromTo(num, { x: -10 }, { x: 0, duration: 0.6, ease: 'elastic.out(1, 0.3)' })
              .add(() => card.classList.add('is-settled'), '+=0.2');
            return;
          }
          gsap.to(state, {
            v: target,
            delay,
            duration: mode === 'down' ? 1.8 : 1.6,
            ease: mode === 'down' ? 'expo.out' : 'power3.out',
            onUpdate: render,
            onComplete: () => {
              render();
              lives?.classList.add('is-counted');
            },
          });
        });
      },
    });
  }

  /* ---------- RAT callsign chip: ask the stewards ---------- */
  function initRatChip(section: HTMLElement): void {
    const chip = section.querySelector<HTMLButtonElement>('[data-rat]');
    if (!chip) return;
    const lines = [
      'Stewards’ note: the RAT is, in fact, a cat. And a champion.',
      'Callsign RAT confirmed. The cat wears it with pride.',
      'FIA: “It’s just the first three letters.” The cat: 😼',
      'Team Principal (RAT) chased his own callsign once. Caught it. Naturally.',
    ];
    let n = 0;
    chip.addEventListener('click', () => {
      emit('bilal:toast', { message: lines[n % lines.length] ?? lines[0]!, tone: 'gold' });
      n += 1;
      sound.play('meow');
      chip.classList.remove('is-squeak');
      void chip.offsetWidth; // restart the CSS animation
      chip.classList.add('is-squeak');
    });
  }

  /* ---------- Collectible cards: 3D tilt, holo glare, flip ---------- */
  function initCard(section: HTMLElement, card: HTMLElement, reduced: boolean): void {
    const btn = card.id ? section.querySelector<HTMLButtonElement>(`[data-flip][aria-controls="${card.id}"]`) : null;
    const label = btn?.querySelector<HTMLElement>('[data-flip-label]');
    const front = card.querySelector<HTMLElement>('[data-tcard-front]');
    const back = card.querySelector<HTMLElement>('[data-tcard-back]');

    btn?.addEventListener('click', () => {
      const flipped = card.classList.toggle('is-flipped');
      btn.setAttribute('aria-pressed', String(flipped));
      if (label) label.textContent = flipped ? 'Show the front' : 'Flip the card';
      // Only the face that is showing is exposed to assistive tech.
      const [shown, hidden] = flipped ? [back, front] : [front, back];
      shown?.removeAttribute('aria-hidden');
      hidden?.setAttribute('aria-hidden', 'true');
      sound.play('whoosh', { volume: 0.5 });
    });

    if (reduced) return;

    const max = isLowPowerDevice() ? 10 : 20;
    let rect: DOMRect | null = null;
    let raf = 0;
    let px = 0.5;
    let py = 0.3;

    const apply = () => {
      raf = 0;
      card.style.setProperty('--rx', `${((0.5 - py) * max).toFixed(2)}deg`);
      card.style.setProperty('--ry', `${((px - 0.5) * max * 1.3).toFixed(2)}deg`);
      card.style.setProperty('--mx', `${(px * 100).toFixed(1)}%`);
      card.style.setProperty('--my', `${(py * 100).toFixed(1)}%`);
    };

    card.addEventListener('pointerenter', (e) => {
      if (e.pointerType === 'touch') return;
      rect = card.getBoundingClientRect();
      card.classList.add('is-tilting');
      card.style.setProperty('--glare', '1');
    });
    card.addEventListener('pointermove', (e) => {
      if (e.pointerType === 'touch') return;
      if (!rect) rect = card.getBoundingClientRect();
      px = Math.min(1, Math.max(0, (e.clientX - rect.left) / rect.width));
      py = Math.min(1, Math.max(0, (e.clientY - rect.top) / rect.height));
      if (!raf) raf = requestAnimationFrame(apply);
    });
    card.addEventListener('pointerleave', () => {
      rect = null;
      if (raf) cancelAnimationFrame(raf);
      raf = 0;
      card.classList.remove('is-tilting');
      card.style.setProperty('--rx', '0deg');
      card.style.setProperty('--ry', '0deg');
      card.style.setProperty('--glare', '0');
    });
    window.addEventListener('scroll', () => (rect = null), { passive: true });
  }
</script>
