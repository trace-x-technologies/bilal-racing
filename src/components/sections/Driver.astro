    }
  }

  /* ================= Landscape phones: fit the viewport height =================
     Width-driven sizing makes the 4:5 portrait and 5:7 cards taller than a sideways
     phone; cap them by svh so face, tag and caption share one screen. Must stay after
     the base .portrait / .tcard-float rules. */
  @media (orientation: landscape) and (max-height: 30em) {
    .portrait {
      width: min(84%, 28rem, calc(82svh * 0.8));
    }

    /* The base 2rem + 4cqi gap is ~60px on a wide landscape column: tighten it so the
       caption lands inside the same screen as the frame. */
