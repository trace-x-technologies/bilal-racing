---
/**
 * 07 · LIGHTS OUT — F1 start-light reaction test.
 * Five pods light one per second, hold for a random 0.2–3 s, then go out.
 * Input: pointerdown (tap/click) or Space/Enter on the stage button.
 * PB + last five attempts persist via `store`; the classification tower
 * mixes your PB with the (entirely fictional) team.
 */
import SectionHeading from '@/components/ui/SectionHeading.astro';
import Emblem from '@/components/ui/Emblem.astro';
import { driver, sinhala, team } from '@/data/lore';

const pods = [1, 2, 3, 4, 5];

interface Entry {
  code: string;
  name: string;
  /** Reaction in ms; null = did not start. */
  ms: number | null;
  note: string;
  tone: 'gold' | 'maroon' | 'teal' | 'saffron' | 'purple' | 'faint' | 'you';
}

const field: Entry[] = [
  { code: driver.code, name: `${driver.nicknameLatin} #${driver.number}`, ms: 90, note: 'food was involved', tone: 'gold' },
  { code: 'TPR', name: 'Team Principal', ms: 231, note: 'practised instead of building a car', tone: 'maroon' },
  { code: 'ENG', name: 'Race Engineer (seat open)', ms: 300, note: 'still checking', tone: 'teal' },
  { code: 'CAT', name: 'Head of Catering (seat open)', ms: 342, note: 'distracted by tuna', tone: 'saffron' },
  { code: 'STR', name: 'Head of Strategy (seat open)', ms: 417, note: 'was executing Plan\u00a0B', tone: 'purple' },
  { code: 'ZZZ', name: `${driver.nicknameLatin}, no food`, ms: 9000, note: 'woke up for the podium photo', tone: 'faint' },
  { code: 'YOU', name: 'You', ms: null, note: 'no time set — yet', tone: 'you' },
  { code: 'VAC', name: 'The vacuum cleaner', ms: null, note: 'DNS · Poosa fled the building', tone: 'faint' },
];

const fmt = (ms: number | null) => (ms == null ? '—' : (ms / 1000).toFixed(3));
---

<section class="section lights" id="lights-out" aria-labelledby="lights-out-title">
  <div class="lo-bgword t-condensed" aria-hidden="true"><span>Lights out</span></div>

  <div class="container">
    <SectionHeading
      index="07"
      kicker="Lights Out"
      id="lights-out-title"
      title="Lights out,<br/><em>ears up.</em>"
      lead="Five red lights. Wait for them to go out, then pounce. Jump the start and the start marshal (a cat) will know."
      si={sinhala.ikmanata.si}
    />

    <div class="lo-layout">
      <!-- ================= The stage ================= -->
      <div class="lo-rig" data-lo-rig data-state="idle" style="--lit: 0" data-reveal="up">
        <div class="lo-scene" aria-hidden="true">
          <div class="lo-sky"></div>
          <div class="lo-ambient"></div>
          <div class="lo-floor">
            <div class="lo-floor-grid" data-lo-floor></div>
            <div class="lo-slot lo-slot-a"><span>P9</span></div>
            <div class="lo-slot lo-slot-b"><span>P10</span></div>
          </div>
          <div class="lo-vignette"></div>
        </div>

        <div class="lo-gantry" data-lo-gantry aria-hidden="true">
          <span class="lo-cable lo-cable-l"></span>
          <span class="lo-cable lo-cable-r"></span>
          <div class="lo-beam">
            <span class="lo-beam-text t-mono">Purrelli · {team.name} · {team.motto} · Purrelli · {team.name} · {team.motto}</span>
          </div>
          <div class="lo-pods">
            {
              pods.map((n) => (
                <div class="lo-pod" data-pod={n} style={`--i: ${n - 1}`}>
                  <span class="lo-lamp lo-lamp-amber" />
                  <span class="lo-lamp lo-lamp-amber" />
                  <span class="lo-lamp lo-lamp-red" />
                  <span class="lo-lamp lo-lamp-red" />
                </div>
              ))
            }
          </div>
          <div class="lo-plate t-mono"><Emblem size="1.1em" title="" /> Start control · marshal: 1 cat</div>
        </div>

        <div class="lo-readout">
          <p class="lo-clock" aria-hidden="true">
            <span class="lo-clock-num" data-lo-time>0.000</span><span class="lo-clock-unit">s</span>
          </p>
          <p class="lo-badge t-mono" data-lo-badge hidden>New PB</p>
          <p class="lo-verdict t-condensed" data-lo-verdict>Beat the cat</p>
          <p class="lo-sub" data-lo-sub>Average human ≈ 0.250 s. {driver.nicknameLatin}, when food is involved: 0.090 s.</p>
        </div>

        <button class="lo-trigger" type="button" data-lo-trigger aria-describedby="lo-help">
          <span class="lo-cta">
            <span class="lo-cta-dot" aria-hidden="true"></span>
            <span data-lo-cta>Tap to start</span>
            <kbd class="lo-kbd" aria-hidden="true">Space</kbd>
          </span>
        </button>
        <p class="visually-hidden" id="lo-help">
          Press Space or Enter to start. Five lights come on one per second, then go out after a random delay. Press
          again the moment they go out. Screen readers hear “Go!” when the lights go out. Turn sound on (top right) for
          audio start cues.
        </p>
        <p class="visually-hidden" role="status" aria-live="polite" data-lo-live></p>
        <p class="visually-hidden" aria-live="assertive" data-lo-go></p>
      </div>

      <!-- ================= Your stats + classification ================= -->
      <aside class="lo-side" aria-label="Your reaction times and the grid classification" data-reveal-stagger="120">
        <div class="lo-card lo-stats" data-reveal="up">
          <div class="lo-stat">
            <span class="t-mono t-mute">Personal best</span>
            <strong class="lo-stat-num" data-lo-best data-empty>0.000</strong>
            <span class="lo-stat-note" data-lo-best-note>No time set. The cat is waiting.</span>
          </div>
          <div class="lo-stat lo-stat-avg">
            <span class="t-mono t-mute">Avg · last 5</span>
            <strong class="lo-stat-num" data-lo-avg data-empty>0.000</strong>
          </div>
          <ol class="lo-history" aria-label="Last five attempts, newest first" data-lo-history>
            {
              [0, 1, 2, 3, 4].map(() => (
                <li class="lo-chip" data-kind="empty">
                  <span class="lo-chip-t">—</span>
                </li>
              ))
            }
          </ol>
          <div class="lo-actions">
            <button type="button" class="lo-btn lo-btn-share" data-lo-share disabled>
              <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"
                ><path
                  d="M12 3v12M7 8l5-5 5 5M5 14v5a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-5"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path></svg
              >
              <span>Share result</span>
            </button>
            <button type="button" class="lo-btn lo-btn-ghost" data-lo-reset>Reset</button>
          </div>
        </div>

        <div class="lo-card lo-board" data-reveal="up">
          <div class="lo-board-head">
            <h3 class="lo-board-title t-condensed">Grid classification</h3>
            <span class="t-mono t-mute">Reaction · s</span>
          </div>
          <ol class="lo-tower" data-lo-tower>
            {
              field.map((e, i) => (
                <li class="lo-row" data-code={e.code} data-ms={e.ms ?? ''} data-tone={e.tone}>
                  <span class="lo-pos">{i + 1}</span>
                  <span class="lo-bar" aria-hidden="true" />
                  <span class="lo-code">{e.code}</span>
                  <span class="lo-name">
                    {e.name}
                    <small data-note>{e.note}</small>
                  </span>
                  <span class="lo-t" data-t>
                    {e.ms == null ? (e.code === 'VAC' ? 'DNS' : '—') : fmt(e.ms)}
                  </span>
                </li>
              ))
            }
          </ol>
        </div>
      </aside>
    </div>
  </div>
</section>

<script>
  import { sound } from '@/scripts/audio';
  import { emit, store } from '@/scripts/bus';
  import { gsap, prefersReducedMotion, isLowPowerDevice } from '@/scripts/motion';

  type State = 'idle' | 'arming' | 'hold' | 'go' | 'result' | 'jump' | 'dnf';
  type Tone = 'purple' | 'teal' | 'gold' | 'red';
  interface Attempt {
    ms: number | null;
    kind: 'ok' | 'jump' | 'dnf' | 'sus';
  }
  interface Tier {
    max: number;
    label: string;
    tone: Tone;
    subs: string[];
  }

  /** Under this, humans are guessing — shown, but not counted. */
  const ANTICIPATION = 100;
  const SUS_SUBS = [
    'Under a tenth is a guess. Stewards deleted the time.',
    'Either you are a cat or you guessed. Time not counted.',
  ];

  const TIERS: Tier[] = [
    {
      max: 200,
      label: 'Laser-pointer reflexes',
      tone: 'purple',
      subs: [
        'You pounced before the red dot even moved.',
        'Purple sector. The cat is filing a complaint.',
        'Faster than Poosa hearing a tuna can. Almost.',
      ],
    },
    {
      max: 300,
      label: 'Podium material',
      tone: 'teal',
      subs: [
        'Clean launch. Poosa would like to see your paperwork.',
        'Sharp. Like claws on a brand-new sofa.',
        'On the podium, behind a cat who was bribed with food. Respectable.',
      ],
    },
    {
      max: 450,
      label: 'Midfield napper',
      tone: 'gold',
      subs: [
        'Heard the fridge open — from another room.',
        'You reacted like a cat pretending not to care.',
        'Solid. Not purr-fect.',
      ],
    },
    {
      max: Infinity,
      label: 'Asleep on the grid, like Poosa',
      tone: 'red',
      subs: ['Box, box? More like nap, nap.', 'The lights went out. So did you.', 'Nine lives, and you spent one waiting.'],
    },
  ];

  const LIGHT_INTERVAL = 1000;
  const FIRST_LIGHT = 700;
  const DNF_AFTER = 6000;
  const COOLDOWN = 550;

  const rig = document.querySelector<HTMLElement>('[data-lo-rig]');
  const trigger = rig?.querySelector<HTMLButtonElement>('[data-lo-trigger]');

  if (rig && trigger) {
    function q<T extends HTMLElement = HTMLElement>(sel: string): T | null {
      return document.querySelector<T>(sel);
    }
    const pods = Array.from(rig.querySelectorAll<HTMLElement>('[data-pod]'));
    const timeEl = q('[data-lo-time]');
    const verdictEl = q('[data-lo-verdict]');
    const subEl = q('[data-lo-sub]');
    const badgeEl = q('[data-lo-badge]');
    const ctaEl = q('[data-lo-cta]');
    const liveEl = q('[data-lo-live]');
    const goEl = q('[data-lo-go]');
    const bestEl = q('[data-lo-best]');
    const bestNoteEl = q('[data-lo-best-note]');
    const avgEl = q('[data-lo-avg]');
    const historyEl = q('[data-lo-history]');
    const shareBtn = q<HTMLButtonElement>('[data-lo-share]');
    const resetBtn = q<HTMLButtonElement>('[data-lo-reset]');
    const tower = q<HTMLOListElement>('[data-lo-tower]');

    let state: State = 'idle';
    let timers: number[] = [];
    let goAt = 0;
    let tick = 0;
    let lockedUntil = 0;
    let pointerHandled = false;
    let lastResult: number | null = null;

    /* ---------------- persistence ---------------- */
    const loadBest = (): number | null => {
      const v = store.get<unknown>('lo-best', null);
      return typeof v === 'number' && Number.isFinite(v) && v > 0 ? v : null;
    };
    const loadHistory = (): Attempt[] => {
      const v = store.get<unknown>('lo-history', []);
      if (!Array.isArray(v)) return [];
      return v
        .filter(
          (a): a is Attempt =>
            !!a &&
            typeof a === 'object' &&
            ['ok', 'jump', 'dnf', 'sus'].includes((a as Attempt).kind) &&
            ((a as Attempt).ms === null || typeof (a as Attempt).ms === 'number'),
        )
        .slice(0, 5);
    };
    let best = loadBest();
    let history = loadHistory();

    /* ---------------- helpers ---------------- */
    const fmt = (ms: number) => (ms / 1000).toFixed(3);
    function pick<T>(arr: readonly T[]): T {
      return arr[Math.floor(Math.random() * arr.length)];
    }
    const tierFor = (ms: number) => TIERS.find((t) => ms < t.max) ?? TIERS[TIERS.length - 1];
    const announce = (msg: string) => {
      if (!liveEl) return;
      liveEl.textContent = '';
      window.setTimeout(() => (liveEl.textContent = msg), 30);
    };
    const clearTimers = () => {
      timers.forEach((id) => window.clearTimeout(id));
      timers = [];
    };
    const later = (fn: () => void, ms: number) => timers.push(window.setTimeout(fn, ms));

    function setLit(n: number): void {
      rig!.style.setProperty('--lit', String(n));
      pods.forEach((pod, i) => pod.toggleAttribute('data-on', i < n));
    }

    function setState(next: State): void {
      state = next;
      rig!.dataset.state = next;
      const cta: Record<State, string> = {
        idle: 'Tap to start',
        arming: 'Wait for it…',
        hold: 'Wait for it…',
        go: 'GO GO GO',
        result: 'Go again',
        jump: 'Try again',
        dnf: 'Wake up & retry',
      };
      if (ctaEl) ctaEl.textContent = cta[next];
    }

    function setReadout(time: string, verdict: string, sub: string, tone: Tone | '' = ''): void {
      if (timeEl) timeEl.textContent = time;
      if (verdictEl) verdictEl.textContent = verdict;
      if (subEl) subEl.textContent = sub;
      if (tone) rig!.dataset.tone = tone;
      else delete rig!.dataset.tone;
    }

    /* ---------------- stats / tower rendering ---------------- */
    function renderStats(): void {
      if (bestEl) {
        bestEl.textContent = best == null ? '0.000' : `${fmt(best)} s`;
        bestEl.toggleAttribute('data-empty', best == null);
      }
      if (bestNoteEl) {
        bestNoteEl.textContent = best == null ? 'No time set. The cat is waiting.' : tierFor(best).label;
      }
      const valid = history.filter((a) => a.kind === 'ok' && a.ms != null).map((a) => a.ms as number);
      if (avgEl) {
        avgEl.textContent = valid.length ? `${fmt(valid.reduce((s, v) => s + v, 0) / valid.length)} s` : '0.000';
        avgEl.toggleAttribute('data-empty', !valid.length);
      }

      if (historyEl) {
        const chips = Array.from(historyEl.children) as HTMLElement[];
        chips.forEach((chip, i) => {
          const a = history[i];
          const label = chip.querySelector<HTMLElement>('.lo-chip-t');
          if (!a) {
            chip.dataset.kind = 'empty';
            chip.removeAttribute('data-tone');
            if (label) label.textContent = '—';
            chip.setAttribute('aria-label', 'No attempt');
            return;
          }
          chip.dataset.kind = a.kind;
          if (a.kind === 'ok' && a.ms != null) {
            const isBest = best != null && Math.abs(a.ms - best) < 0.5;
            chip.dataset.tone = isBest ? 'best' : tierFor(a.ms).tone;
            if (label) label.textContent = fmt(a.ms);
            chip.setAttribute('aria-label', `${fmt(a.ms)} seconds${isBest ? ', personal best' : ''}`);
          } else {
            chip.dataset.tone = 'red';
            const labels = { jump: ['JUMP', 'Jump start'], dnf: ['DNF', 'Did not finish'], sus: ['SUS', 'Anticipated, not counted'] };
            const [text, aria] = labels[a.kind as 'jump' | 'dnf' | 'sus'] ?? labels.dnf;
            if (label) label.textContent = text;
            chip.setAttribute('aria-label', aria);
          }
        });
      }

      if (shareBtn) shareBtn.disabled = lastResult == null && best == null;
      renderTower();
    }

    function renderTower(): void {
      if (!tower) return;
      const rows = Array.from(tower.children) as HTMLElement[];
      const you = rows.find((r) => r.dataset.code === 'YOU');
      if (you) {
        you.dataset.ms = best == null ? '' : String(best);
        const t = you.querySelector<HTMLElement>('[data-t]');
        const note = you.querySelector<HTMLElement>('[data-note]');
        if (t) t.textContent = best == null ? '—' : fmt(best);
        if (note) note.textContent = best == null ? 'no time set — yet' : tierFor(best).label.toLowerCase();
      }
      const key = (r: HTMLElement) => {
        const ms = r.dataset.ms ? Number(r.dataset.ms) : NaN;
        if (Number.isFinite(ms)) return ms;
        return r.dataset.code === 'YOU' ? 1e7 : 1e8; // no time sits above DNS
      };
      // FLIP the reorder so the "YOU" row visibly climbs the tower.
      const before = new Map(rows.map((r) => [r, r.getBoundingClientRect().top]));
      const sorted = [...rows].sort((a, b) => key(a) - key(b));
      sorted.forEach((r, i) => {
        tower.appendChild(r);
        const pos = r.querySelector<HTMLElement>('.lo-pos');
        if (pos) pos.textContent = String(i + 1);
      });
      if (!prefersReducedMotion()) {
        sorted.forEach((r) => {
          const dy = (before.get(r) ?? 0) - r.getBoundingClientRect().top;
          if (Math.abs(dy) > 1) {
            r.animate([{ transform: `translateY(${dy}px)` }, { transform: 'none' }], {
              duration: 700,
              easing: 'cubic-bezier(0.16, 1, 0.3, 1)',
            });
          }
        });
      }
    }

    function record(a: Attempt): void {
      history = [a, ...history].slice(0, 5);
      store.set('lo-history', history);
    }

    /* ---------------- game flow ---------------- */
    function start(): void {
      clearTimers();
      rig!.classList.remove('is-check');
      setState('arming');
      setLit(0);
      if (badgeEl) badgeEl.hidden = true;
      setReadout('0.000', 'Hands ready', 'Five lights. Wait for all of them to go out.');
      if (goEl) goEl.textContent = '';
      announce('Lights coming on. Wait for them to go out.');
      trigger!.focus({ preventScroll: true });
      for (let i = 1; i <= 5; i++) {
        later(() => {
          setLit(i);
          sound.play('beep', { pitch: i === 5 ? 1.06 : 1, volume: 0.8 });
          if (i === 5) {
            setState('hold');
            later(lightsOut, 200 + Math.random() * 2800);
          }
        }, FIRST_LIGHT + (i - 1) * LIGHT_INTERVAL);
      }
    }

    function lightsOut(): void {
      requestAnimationFrame(() => {
        if (state !== 'hold') return;
        setLit(0);
        setState('go');
        if (goEl) goEl.textContent = 'Go!';
        goAt = performance.now();
        sound.play('go');
        if (verdictEl) verdictEl.textContent = 'Lights out!';
        if (subEl) subEl.textContent = 'And away we go —';
        const run = () => {
          if (state !== 'go') return;
          const elapsed = performance.now() - goAt;
          if (timeEl) timeEl.textContent = fmt(elapsed);
          if (elapsed > DNF_AFTER) {
            dnf();
            return;
          }
          tick = requestAnimationFrame(run);
        };
        tick = requestAnimationFrame(run);
      });
    }

    function finish(at: number): void {
      cancelAnimationFrame(tick);
      const ms = Math.max(1, Math.round(at - goAt));
      if (ms < ANTICIPATION) {
        setState('result');
        lockedUntil = performance.now() + COOLDOWN;
        record({ ms, kind: 'sus' });
        setReadout(fmt(ms), 'Suspiciously quick', pick(SUS_SUBS), 'purple');
        if (badgeEl) badgeEl.hidden = true;
        renderStats();
        announce(`${fmt(ms)} seconds. Suspiciously quick — anticipation, not counted.`);
        sound.play('hiss', { pitch: 1.3, volume: 0.6 });
        return;
      }
      const tier = tierFor(ms);
      const isPb = best == null || ms < best;
      setState('result');
      lockedUntil = performance.now() + COOLDOWN;
      lastResult = ms;
      if (isPb) {
        best = ms;
        store.set('lo-best', ms);
      }
      record({ ms, kind: 'ok' });
      setReadout(fmt(ms), tier.label, pick(tier.subs), tier.tone);
      if (badgeEl) badgeEl.hidden = !isPb;
      renderStats();
      announce(`${fmt(ms)} seconds. ${tier.label}.${isPb ? ' New personal best!' : ''}`);
      if (isPb && ms < 300) {
        sound.play('revMeow', { volume: 0.8 });
        pawBurst(tier.tone);
      } else sound.play('click');
    }

    function jumpStart(): void {
      clearTimers();
      cancelAnimationFrame(tick);
      setLit(0);
      setState('jump');
      lockedUntil = performance.now() + COOLDOWN;
      record({ ms: null, kind: 'jump' });
      setReadout('+5.000', 'JUMP START — 5 s penalty.', 'Even the cat waited.', 'red');
      if (badgeEl) badgeEl.hidden = true;
      renderStats();
      announce('Jump start. Five second penalty. Even the cat waited.');
      sound.play('hiss');
      if (!prefersReducedMotion()) {
        rig!.animate(
          [
            { transform: 'translateX(0)' },
            { transform: 'translateX(-8px)' },
            { transform: 'translateX(7px)' },
            { transform: 'translateX(-4px)' },
            { transform: 'translateX(2px)' },
            { transform: 'translateX(0)' },
          ],
          { duration: 420, easing: 'ease-out' },
        );
      }
    }

    function dnf(): void {
      cancelAnimationFrame(tick);
      setState('dnf');
      lockedUntil = performance.now() + COOLDOWN;
      record({ ms: null, kind: 'dnf' });
      setReadout('DNF', 'Asleep on the grid, like Poosa', 'Reaction: none. Snoring: detected.', 'red');
      renderStats();
      announce('Did not finish. You fell asleep on the grid, like Poosa.');
      sound.play('purr');
    }

    function abort(reason: string): void {
      if (state !== 'arming' && state !== 'hold' && state !== 'go') return;
      clearTimers();
      cancelAnimationFrame(tick);
      setLit(0);
      setState('idle');
      setReadout('0.000', 'Start aborted', reason);
    }

    function input(at: number): void {
      if (performance.now() < lockedUntil) return;
      switch (state) {
        case 'idle':
        case 'result':
        case 'jump':
        case 'dnf':
          start();
          break;
        case 'arming':
        case 'hold':
          jumpStart();
          break;
        case 'go':
          finish(at);
          break;
      }
    }

    /** Event timestamps share performance.now()'s clock; fall back if they don't. */
    const stamp = (e: Event) => {
      const now = performance.now();
      return e.timeStamp > 0 && Math.abs(now - e.timeStamp) < 1000 ? e.timeStamp : now;
    };

    /* ---------------- input wiring ---------------- */
    trigger.addEventListener('pointerdown', (e) => {
      if (e.button !== 0) return;
      // Touch/pen: a swipe that merely scrolls past must not start a round, so
      // starting waits for the click (a real tap). In-round taps react instantly.
      const inRound = state === 'arming' || state === 'hold' || state === 'go';
      if (e.pointerType !== 'mouse' && !inRound) return;
      pointerHandled = true;
      input(stamp(e));
    });
    trigger.addEventListener('click', (e) => {
      // Pointer clicks were handled on pointerdown; this catches assistive-tech activation.
      if (pointerHandled) {
        pointerHandled = false;
        return;
      }
      input(stamp(e));
    });
    trigger.addEventListener('contextmenu', (e) => e.preventDefault());

    const isGameKey = (e: KeyboardEvent) => e.key === ' ' || e.key === 'Enter' || e.code === 'Space';
    trigger.addEventListener('keydown', (e) => {
      if (!isGameKey(e)) return;
      e.preventDefault();
      e.stopPropagation();
      if (e.repeat) return;
      input(stamp(e));
    });
    // Mid-round, Space/Enter work even if focus drifted to the page itself.
    document.addEventListener('keydown', (e) => {
      if (!isGameKey(e) || e.repeat) return;
      if (state !== 'arming' && state !== 'hold' && state !== 'go') return;
      const active = document.activeElement;
      if (active && active !== document.body && !rig.contains(active)) return;
      e.preventDefault();
      input(stamp(e));
    });

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) abort('You looked away. Very cat of you. Tap to try again.');
    });

    /* ---------------- share / reset ---------------- */
    shareBtn?.addEventListener('click', async () => {
      const ms = lastResult ?? best;
      if (ms == null) return;
      sound.play('click');
      const url = `${location.origin}${location.pathname}#lights-out`;
      const text = `I reacted in ${fmt(ms)} s on Bilal Racing's Lights Out test. Beat that, machan 🐾`;
      try {
        if (typeof navigator.share === 'function') {
          await navigator.share({ title: 'Bilal Racing — Lights Out', text, url });
          emit('bilal:toast', { message: 'Result sent. The group chat has been warned.', tone: 'gold' });
          return;
        }
      } catch (err) {
        if (err instanceof DOMException && err.name === 'AbortError') return;
      }
      try {
        await navigator.clipboard.writeText(`${text} ${url}`);
        emit('bilal:toast', { message: 'Copied! Paste it in the group chat, machan.', tone: 'gold' });
      } catch {
        emit('bilal:toast', { message: `Couldn’t copy — ${fmt(ms)} s. Screenshot it like it’s 2015.`, tone: 'red' });
      }
    });

    resetBtn?.addEventListener('click', () => {
      best = null;
      lastResult = null;
      history = [];
      store.set('lo-best', null);
      store.set('lo-history', []);
      renderStats();
      if (state === 'result' || state === 'jump' || state === 'dnf') {
        setState('idle');
        setReadout('0.000', 'Beat the cat', 'Times wiped. The cat saw nothing.');
        if (badgeEl) badgeEl.hidden = true;
      }
      sound.play('click');
      emit('bilal:toast', { message: 'Times wiped. The cat saw nothing.', tone: 'info' });
    });

    /* ---------------- celebration ---------------- */
    const PAW =
      '<svg viewBox="0 0 32 32" aria-hidden="true"><ellipse cx="16" cy="21" rx="7.5" ry="6.5"/><ellipse cx="7" cy="13" rx="3" ry="3.8"/><ellipse cx="12.5" cy="7.5" rx="3" ry="3.8"/><ellipse cx="19.5" cy="7.5" rx="3" ry="3.8"/><ellipse cx="25" cy="13" rx="3" ry="3.8"/></svg>';

    function pawBurst(tone: Tone): void {
      if (prefersReducedMotion()) return;
      const count = isLowPowerDevice() ? 8 : 14;
      const box = rig!.getBoundingClientRect();
      for (let i = 0; i < count; i++) {
        const paw = document.createElement('span');
        paw.className = 'lo-paw';
        paw.dataset.tone = tone;
        paw.innerHTML = PAW;
        rig!.appendChild(paw);
        const angle = (Math.PI * 2 * i) / count + Math.random() * 0.4;
        const dist = Math.min(box.width, box.height) * (0.28 + Math.random() * 0.22);
        const rot = Math.random() * 120 - 60;
        paw
          .animate(
            [
              { transform: 'translate(-50%, -50%) scale(0.2) rotate(0deg)', opacity: 0 },
              { opacity: 1, offset: 0.2 },
              {
                transform: `translate(calc(-50% + ${Math.cos(angle) * dist}px), calc(-50% + ${Math.sin(angle) * dist}px)) scale(1) rotate(${rot}deg)`,
                opacity: 0,
              },
            ],
            { duration: 1100 + Math.random() * 500, easing: 'cubic-bezier(0.16, 1, 0.3, 1)' },
          )
          .finished.then(() => paw.remove())
          .catch(() => paw.remove());
      }
    }

    /* ---------------- scroll choreography ---------------- */
    const gantry = rig.querySelector<HTMLElement>('[data-lo-gantry]');
    const floor = rig.querySelector<HTMLElement>('[data-lo-floor]');
    const bgWord = document.querySelector<HTMLElement>('.lo-bgword span');

    if (!prefersReducedMotion()) {
      if (gantry) {
        gsap.fromTo(
          gantry,
          { yPercent: -38, rotate: -1.6 },
          {
            yPercent: 0,
            rotate: 0,
            ease: 'none',
            scrollTrigger: { trigger: rig, start: 'top 95%', end: 'top 30%', scrub: 0.7 },
          },
        );
      }
      if (floor) {
        gsap.fromTo(
          floor,
          { y: 0 },
          {
            y: 240,
            ease: 'none',
            scrollTrigger: { trigger: rig, start: 'top bottom', end: 'bottom top', scrub: true },
          },
        );
      }
      if (bgWord) {
        gsap.fromTo(
          bgWord,
          { xPercent: 8 },
          {
            xPercent: -22,
            ease: 'none',
            scrollTrigger: { trigger: '#lights-out', start: 'top bottom', end: 'bottom top', scrub: true },
          },
        );
      }

      // One-time "system check": the gantry sweeps its lights when first seen.
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            if (!entries.some((e) => e.isIntersecting)) return;
            io.disconnect();
            window.setTimeout(() => {
              if (state !== 'idle') return;
              rig.classList.add('is-check');
              window.setTimeout(() => rig.classList.remove('is-check'), 1600);
            }, 650);
          },
          { threshold: 0.6 },
        );
        io.observe(rig);
      }
    }

    renderStats();
  }
</script>

