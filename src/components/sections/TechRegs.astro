</style>

<script>
  import { gsap, ScrollTrigger, prefersReducedMotion, lockScroll } from '@/scripts/motion';
  import { sound } from '@/scripts/audio';

  type State = 'yes' | 'no' | 'info';
  interface Result {
    state: State;
    text: string;
  }

  // Keep result texts short (≲ 32 characters) so badges stay on one line on phones.
  const yes = (text = 'Supported in your browser'): Result => ({ state: 'yes', text });
  const no = (text = 'Not supported — fallback fitted'): Result => ({ state: 'no', text });
  const info = (text: string): Result => ({ state: 'info', text });
  const test = (ok: boolean, y?: string, n?: string): Result => (ok ? yes(y) : no(n));

  const AVIF =
    'data:image/avif;base64,';
  const WEBP = 'data:image/webp;base64,UklGRiIAAABXRUJQVlA4IBYAAAAwAQCdASoBAAEADsD+JaQAA3AAAAAA';

  function decodes(src: string, timeout = 2500): Promise<boolean> {
    return new Promise((resolve) => {
      const img = new Image();
      const t = window.setTimeout(() => resolve(false), timeout);
      img.onload = () => {
        window.clearTimeout(t);
        resolve(img.width > 0);
      };
      img.onerror = () => {
        window.clearTimeout(t);
        resolve(false);
      };
      img.src = src;
    });
  }

  let edgeColo: string | null = null;

  const checks: Record<string, () => Result | Promise<Result>> = {
    edge: async () => {
      if (!/(^|\.)tracex\.tech$/.test(location.hostname)) return info('Pre-built · local pit garage');
      try {
        const ctrl = new AbortController();
        const t = window.setTimeout(() => ctrl.abort(), 3000);
        const res = await fetch('/cdn-cgi/trace', { signal: ctrl.signal, cache: 'no-store' });
        window.clearTimeout(t);
        if (res.ok) {
          edgeColo = /colo=([A-Z]{3})/.exec(await res.text())?.[1] ?? null;
        }
      } catch {
        /* offline or blocked — still on the edge */
      }
      return yes(edgeColo ? `Pre-built · served from ${edgeColo}` : 'Pre-built · served from the edge');
    },
    bodywork: () => {
      const scroll = CSS.supports('animation-timeline: view()');
      const morph = 'startViewTransition' in document;
      if (scroll && morph) return yes('Scroll timelines + morphs fitted');
      if (!scroll && !morph) return no('Neither — static fallback fitted');
      return no(scroll ? 'No morphs — instant swap fitted' : 'No scroll timeline — fallback');
    },
    webgl: () => {
      try {
        const canvas = document.createElement('canvas');
        const gl = (canvas.getContext('webgl2') ?? canvas.getContext('webgl')) as WebGLRenderingContext | null;
        if (!gl) return no('No WebGL — the car rolls in 2D');
        const v2 = typeof WebGL2RenderingContext !== 'undefined' && gl instanceof WebGL2RenderingContext;
        gl.getExtension('WEBGL_lose_context')?.loseContext();
        return yes(v2 ? 'WebGL 2 — both ears present' : 'WebGL 1 — ears present');
      } catch {
        return no('No WebGL — the car rolls in 2D');
      }
    },
    gsap: () => {
      const lenis = document.documentElement.classList.contains('lenis');
      const v = gsap.version.split('.').slice(0, 2).join('.');
      if (lenis) return yes(`GSAP ${v} + Lenis engaged`);
      if (prefersReducedMotion()) return info(`GSAP ${v} · Lenis parked`);
      return yes(`GSAP ${v} engaged`);
    },
    webAudio: () => test('AudioContext' in window || 'webkitAudioContext' in window),
    popover: () => test(Object.prototype.hasOwnProperty.call(HTMLElement.prototype, 'popover')),
    aero: () => {
      // tokens.css registers --livery-angle with @property (initial-value: 0deg).
      // Only a browser that understood the registration reports that initial value.
      const typed = getComputedStyle(document.documentElement).getPropertyValue('--livery-angle').trim() === '0deg';
      const missing = [
        !CSS.supports('container-type: inline-size') && 'container queries',
        !CSS.supports('selector(:has(*))') && ':has()',
        !typed && '@property',
      ].filter(Boolean);
      return missing.length ? no(`No ${missing.join(', ')} — fallback`) : yes('All three fitted — livery spins');
    },
    avif: async () => {
      if (await decodes(AVIF)) return yes('AVIF compound fitted');
      if (await decodes(WEBP)) return yes('WebP compound fitted');
      return no('Neither — JPEG spare fitted');
    },
    motion: () =>
      prefersReducedMotion() ? yes('Honoured — motion parked for you') : yes('Honoured — you chose full speed'),
    classified: () => info('Classified — find them yourself'),
  };

  const wait = (ms: number) => new Promise((r) => window.setTimeout(r, ms));
  const fmt = new Intl.NumberFormat();

  function initTechRegs(): void {
    const root = document.querySelector<HTMLElement>('#tech');
    if (!root) return;
    const reduce = prefersReducedMotion();

    /* ---------------- Scrutineering ---------------- */
    const arts = Array.from(root.querySelectorAll<HTMLElement>('[data-check]'));
    const stamp = root.querySelector<HTMLElement>('[data-stamp]');
    const stampL1 = root.querySelector<HTMLElement>('[data-stamp-l1]');
    const stampL2 = root.querySelector<HTMLElement>('[data-stamp-l2]');
    const scoreEl = root.querySelector<HTMLElement>('[data-tele-score]');
    const coloEl = root.querySelector<HTMLElement>('[data-tele-colo]');

    /* The live results below are written into space reserved in the markup, but a
       narrow screen can still wrap a long one onto a second line. If that changed
       the section's height, re-measure the scroll triggers below it (footer). */
    function keepTriggersInSync(heightBefore: number): void {
      if (root && root.offsetHeight !== heightBefore) ScrollTrigger.refresh();
    }

    let scrutiny: Promise<void> | null = null;
    const scrutinise = (): Promise<void> => (scrutiny ??= runScrutiny());
    async function runScrutiny(): Promise<void> {
      const heightBefore = root?.offsetHeight ?? 0;
      const results = await Promise.all(
        arts.map(async (art) => {
          const fn = checks[art.dataset.check ?? ''];
          try {
            return fn ? await fn() : info('Not checked');
          } catch {
            return no();
          }
        }),
      );
      let passed = 0;
      for (let i = 0; i < arts.length; i++) {
        const badge = arts[i].querySelector<HTMLElement>('[data-badge]');
        const text = arts[i].querySelector<HTMLElement>('[data-badge-text]');
        const r = results[i];
        if (r.state !== 'no') passed++;
        if (badge) {
          badge.dataset.state = r.state;
          if (!reduce) badge.classList.add('is-fresh');
        }
        if (text) text.textContent = r.text;
        if (!reduce) await wait(70);
      }
      const total = arts.length;
      const clean = passed === total;
      stamp?.classList.toggle('is-penalised', !clean);
      if (stampL1) stampL1.textContent = `${passed}/${total} checks`;
      if (stampL2) stampL2.textContent = clean ? 'Your browser passed' : '*5-second penalty';
      if (scoreEl) scoreEl.textContent = `${passed} / ${total} passed`;
      if (coloEl) coloEl.textContent = edgeColo ?? (/(^|\.)tracex\.tech$/.test(location.hostname) ? 'The edge' : 'Localhost');
      keepTriggersInSync(heightBefore);
    }

    const docIO = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          void scrutinise();
          docIO.disconnect();
        }
      },
      { rootMargin: '300px 0px' },
    );
    const doc = root.querySelector('[data-doc]');
    if (doc) docIO.observe(doc);

    // The stamp slams down once the footer is in view (and scrutineering is done).
    // Observe the footer, not the stamp: the pre-slam stamp is scaled 2.3x and clipped.
    const foot = root.querySelector<HTMLElement>('.doc__foot');
    if (stamp && foot) {
      const stampIO = new IntersectionObserver(
        ([entry]) => {
          if (!entry.isIntersecting) return;
          stampIO.disconnect();
          void scrutinise().then(() => {
            stamp.classList.add('is-stamped');
            sound.play('click', { pitch: 0.6 });
          });
        },
        { threshold: 0.6 },
      );
      stampIO.observe(foot);
    }

    /* ---------------- Telemetry (Navigation Timing) ---------------- */
    const tele = root.querySelector<HTMLElement>('[data-tele]');
    const loadEl = root.querySelector<HTMLElement>('[data-tele-load]');
    const verdictEl = root.querySelector<HTMLElement>('[data-tele-verdict]');
    const bytesEl = root.querySelector<HTMLElement>('[data-tele-bytes]');
    const reqsEl = root.querySelector<HTMLElement>('[data-tele-reqs]');
    const foodMs = Number(verdictEl?.dataset.foodMs) || 90;
    // lore.ownerStats: "To team emails: 9 business days." Counted as whole days — he naps through weekends too.
    const emailDays = Number(verdictEl?.dataset.emailDays) || 9;
    const emailMs = emailDays * 24 * 60 * 60 * 1000;

    interface Timing {
      ttfb: number;
      fcp: number;
      load: number;
      bytes: number;
      requests: number;
    }

    function readTiming(): Timing | null {
      const nav = performance.getEntriesByType?.('navigation')[0] as PerformanceNavigationTiming | undefined;
      if (!nav) return null;
      const resources = performance.getEntriesByType('resource') as PerformanceResourceTiming[];
      const fcpEntry = performance.getEntriesByName('first-contentful-paint')[0];
      const load = nav.loadEventEnd > 0 ? nav.loadEventEnd : nav.domContentLoadedEventEnd;
      const bytes = resources.reduce((sum, r) => sum + (r.transferSize || 0), nav.transferSize || 0);
      return {
        ttfb: Math.max(0, nav.responseStart - nav.startTime),
        fcp: fcpEntry ? fcpEntry.startTime : nav.domContentLoadedEventEnd,
        load,
        bytes,
        requests: resources.length + 1,
      };
    }

    const grade = (ms: number, purple: number, green: number) =>
      ms <= purple ? 'purple' : ms <= green ? 'green' : 'yellow';

    function verdict(t: Timing): string {
      const food = `${(foodMs / 1000).toFixed(2)} s`;
      if (t.load <= foodMs) return `Faster than Poosa reacts to food (${food}). Stewards suspect tuna.`;
      if (t.ttfb > 0 && t.ttfb <= foodMs)
        return `First byte in ${Math.round(t.ttfb)} ms — faster than Poosa reacts to food (${food}). The rest stopped for a nap.`;
      const x = Math.round(emailMs / Math.max(1, t.load));
      return `Slower than Poosa reacts to food (${food}), but ${fmt.format(x)}× faster than his email replies (${emailDays} business days).`;
    }

    let timing: Timing | null = null;
    let shown = false;

    function show(): void {
      if (shown || !timing || !tele) return;
      shown = true;
      const heightBefore = root?.offsetHeight ?? 0;
      const t = timing;
      tele.dataset.grade = grade(t.load, 800, 2500);
      if (verdictEl) verdictEl.textContent = verdict(t);
      if (bytesEl) bytesEl.textContent = t.bytes > 0 ? `${fmt.format(Math.round(t.bytes / 1024))} KB` : 'From cache';
      if (reqsEl) reqsEl.textContent = fmt.format(t.requests);

      const max = Math.max(t.load, t.fcp, t.ttfb, 1);
      const sectors: Array<[string, number, number, number]> = [
        ['ttfb', t.ttfb, 100, 400],
        ['fcp', t.fcp, 600, 1800],
        ['load', t.load, 800, 2500],
      ];
      sectors.forEach(([key, v, p, g], i) => {
        const li = tele.querySelector<HTMLElement>(`[data-sector="${key}"]`);
        if (!li) return;
        li.dataset.grade = grade(v, p, g);
        const bar = li.querySelector<HTMLElement>('i');
        bar?.style.setProperty('--d', `${i * 140}ms`);
        bar?.style.setProperty('--p', String(Math.max(0.02, v / max)));
        const val = li.querySelector<HTMLElement>('[data-v]');
        if (val) val.textContent = `${fmt.format(Math.round(v))} ms`;
      });
      keepTriggersInSync(heightBefore);

      if (!loadEl) return;
      const target = Math.round(t.load);
      if (reduce) {
        loadEl.textContent = fmt.format(target);
        return;
      }
      const counter = { v: 0 };
      gsap.to(counter, {
        v: target,
        duration: 1.4,
        ease: 'power3.out',
        onUpdate: () => {
          loadEl.textContent = fmt.format(Math.round(counter.v));
        },
      });
    }

    function measure(): void {
      timing = readTiming();
      if (!timing && verdictEl) {
        const heightBefore = root?.offsetHeight ?? 0;
        verdictEl.textContent = 'Your browser keeps its lap times secret. Very cat of it.';
        keepTriggersInSync(heightBefore);
      }
      if (teleVisible) show();
    }

    let teleVisible = false;
    if (tele) {
      const teleIO = new IntersectionObserver(
        ([entry]) => {
          if (!entry.isIntersecting) return;
          teleVisible = true;
          teleIO.disconnect();
          show();
        },
        { threshold: 0.35 },
      );
      teleIO.observe(tele);
    }

    if (document.readyState === 'complete') window.setTimeout(measure, 0);
    else window.addEventListener('load', () => window.setTimeout(measure, 0), { once: true });

    /* ---------------- Popover: modal-style scroll lock + sound ----------------
       The scroll lock follows the synchronous 'beforetoggle', which fires for every
       open and close path (invoker, Close button, Esc, light dismiss). 'toggle' is
       queued as a task, so it runs after the click that light-dismissed the popover:
       that click's anchor scroll would hit a stopped Lenis, and a late unlock would
       undo the lock set by a menu or dialog the same click opened. The popover has
       data-lenis-prevent, so its own content still scrolls. */
    const pop = root.querySelector<HTMLElement>('#stewards-decision');
    if (pop) {
      pop.addEventListener('beforetoggle', (e) => {
        lockScroll((e as ToggleEvent).newState === 'open');
      });
      pop.addEventListener('toggle', (e) => {
        if ((e as ToggleEvent).newState !== 'open') return;
        pop.scrollTop = 0;
        sound.play('radio');
      });
      /* Keyboard users can Tab out of a native popover (or Shift+Tab back past its
         invoker) and it stays open, leaving the page locked with focus on a control
         under the backdrop. Close it when focus leaves the popover + invoker pair.
         Focus may move between the two: Tab from the invoker enters the popover, and
         a click on the invoker must stay a plain toggle, not close-then-reopen.
         `to` is null when a click lands on non-focusable text inside the popover or
         the window loses focus, so those keep it open; the :popover-open guard makes
         the focus-restore focusout after Close or Esc a no-op. */
      const invokers = Array.from(
        root.querySelectorAll<HTMLElement>('[popovertarget="stewards-decision"]'),
      ).filter((el) => !pop.contains(el));
      const closeIfFocusLeft = (e: FocusEvent) => {
        const to = e.relatedTarget as Node | null;
        if (!to || pop.contains(to) || invokers.some((el) => el.contains(to))) return;
        if (pop.matches(':popover-open')) pop.hidePopover();
      };
      pop.addEventListener('focusout', closeIfFocusLeft);
      for (const el of invokers) el.addEventListener('focusout', closeIfFocusLeft);
    }
  }

  initTechRegs();
</script>
