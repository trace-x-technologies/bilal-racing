  /* No JavaScript: nothing can be scrutineered or timed, so hide the live bits. */
  :global(html:not(.js)) .art__badge,
  :global(html:not(.js)) .tele__big,
  :global(html:not(.js)) .tele__sectors,
  :global(html:not(.js)) .tele__misc,
