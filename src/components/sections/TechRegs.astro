---
/**
 * 10 · Technical Regulations — an FIA-style (FIA-ish) document listing the real
 * web tech that powers this site. Each article is scrutineered live against the
 * visitor's browser (CSS.supports + feature checks), and a telemetry panel reads
 * the Navigation Timing API to report how fast the page loaded.
 */
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { owner, ownerStats, drivers } from '@/data/lore';

interface Article {
  no: string;
  title: string;
  tech: string;
  /** Trusted, hand-written HTML. */
  rule: string;
  check: string;
  /** Classified variant: redaction bars and a rubber-stamped badge. */
  redacted?: boolean;
}

/** A black redaction bar about `ch` characters wide; screen readers hear "redacted". */
const redact = (ch: number) =>
  `<span class="redact" style="--w:${ch}ch"><span class="visually-hidden">[redacted]</span></span>`;

const articles: Article[] = [
  {
    no: '1.1',
    title: 'Chassis & circuit',
    tech: 'Astro 7 static build · Cloudflare edge',
    rule: 'The car shall be assembled at the factory: every page is pre-rendered to static HTML, with JavaScript fitted only to parts that actually move, then served from Cloudflare’s edge, as close to the spectator as possible. The team owner prefers to be served at home, with snacks.',
    check: 'edge',
  },
  {
    no: '2.1',
    title: 'Bodywork',
    tech: 'Scroll-driven animations · View Transitions',
    rule: 'Bodywork shall move against scroll position, not the clock, via <code>animation-timeline: view()</code>, and changes of state shall morph rather than teleport (see the calendar’s grid view). Teleporting is reserved for the team owner when a food bowl is filled.',
    check: 'bodywork',
  },
  {
    no: '3.1',
    title: 'Power unit',
    tech: 'WebGL · Three.js · lazy import()',
    rule: 'The car shall be rendered in WebGL (Three.js) and must possess <mark class="pen">no fewer than two ears<svg class="pen__ring" viewBox="0 0 200 40" preserveAspectRatio="none" aria-hidden="true"><path pathLength="1" d="M18 30 C4 22 10 8 54 5 C110 1 186 4 194 18 C200 30 150 37 92 37 C46 37 14 32 12 22 C11 15 24 9 40 8"/></svg></mark>. The engine is only fetched when the car comes into view, and shall idle whenever nobody is watching. Much like the owner on the pit wall.',
    check: 'webgl',
  },
  {
    no: '4.1',
    title: 'Transmission',
    tech: 'GSAP ScrollTrigger · Lenis',
    rule: 'Gearshifts shall be buttery. Scrolling is smoothed by Lenis and choreographed by GSAP ScrollTrigger. Scroll-jacking for longer than a cat’s attention span is prohibited.',
    check: 'gsap',
  },
  {
    no: '5.1',
    title: 'Engine note',
    tech: 'Web Audio API synthesis',
    rule: 'No audio samples permitted. Every engine note is synthesised live from oscillators and filters, and shall end in a meow. Sound ships muted, out of respect for open-plan offices.',
    check: 'webAudio',
  },
  {
    no: '6.1',
    title: 'Team radio',
    tech: 'Popover API',
    rule: 'Pop-ups shall be native, dismissable with Esc, and shall never try to sell you anything. A compliant example: <button type="button" class="doc__pop" popovertarget="stewards-decision">read the stewards’ decision</button>.',
    check: 'popover',
  },
  {
    no: '7.1',
    title: 'Aerodynamics',
    tech: 'Container queries · :has() · @property',
    rule: 'Components shall size themselves to the box they sit in, not to the screen — a regulation the team owner has followed for years. Parents may react to their children via <code>:has()</code>, and custom properties shall be typed with <code>@property</code>. Untyped properties are reserved for the owner’s messages in the group chat.',
    check: 'aero',
  },
  {
    no: '8.1',
    title: 'Tyres',
    tech: 'AVIF · WebP images',
    rule: 'Photos shall run on AVIF or WebP compounds, resized for every screen, with EXIF and GPS data stripped. Nobody needs the coordinates of the nap spot.',
    check: 'avif',
  },
  {
    no: '9.1',
    title: 'Safety car',
    tech: 'prefers-reduced-motion',
    rule: 'If the spectator prefers reduced motion, every animation shall park politely and the page shall still look fabulous.',
    check: 'motion',
  },
  {
    no: '9.9',
    title: 'Undisclosed components',
    tech: 'Easter eggs · keyboard listeners',
    rule: `Undisclosed components are fitted to this car. Typing ${redact(4)} is not a technical infringement, and neither is the ${redact(6)} code. Pressing ${redact(1)} in a braking zone is ${redact(13)}.`,
    check: 'classified',
    redacted: true,
  },
];

/** A red-pen margin note that breaks up the run of articles. */
const note = {
  after: '4.1',
  text: 'For the avoidance of doubt: “box, box” is an instruction to pit. It is not an invitation.',
  by: 'Technical delegate · margin note',
};

// The owner's reaction times (lore.ownerStats): 0.09 s to food, 9 business days to team emails.
const food = ownerStats.find((s) => s.label === 'Reaction time to food');
const foodSeconds = food?.value ?? 0.09;
const foodMs = Math.round(foodSeconds * 1000);
const emailDays = Number(/(\d+) business days/.exec(food?.note ?? '')?.[1] ?? 9);

const cars = drivers.map((d) => `#${d.number} ${d.code}`).join(' & ');
// lore: car #13's driver built this website instead of doing a single practice lap.
const buildDriver = drivers.find((d) => d.id === 'dha');
---

<section class="section regs" id="tech" aria-labelledby="tech-title">
  <div class="container">
    <SectionHeading
      index="10"
      kicker="Technical Regulations"
      title="The <em>Rulebook</em>"
      id="tech-title"
      lead="The real, modern web tech under the bodywork — scrutineered live against the browser you are reading this in."
    />

    <div class="regs__layout">
      <!-- ============ Telemetry ============ -->
      <aside class="tele" data-tele aria-labelledby="tele-title" data-reveal="up">
        <p class="tele__kicker t-mono">
          <span class="tele__dot" aria-hidden="true"></span>
          <span id="tele-title">Live telemetry · this page load</span>
        </p>
        <p class="tele__label t-mono">Page loaded in</p>
        <p class="tele__big t-condensed">
          <span data-tele-load>—</span><small>ms</small>
        </p>
        <p class="tele__verdict" data-tele-verdict data-food-ms={foodMs} data-email-days={emailDays}>
          Measuring. Unlike the owner’s email replies, this won’t take {emailDays} business days.
        </p>

        <ul class="tele__sectors" role="list">
          <li data-sector="ttfb">
            <span class="t-mono">S1 · First byte</span>
            <span class="tele__bar" aria-hidden="true"><i></i></span>
            <b data-v>—</b>
          </li>
          <li data-sector="fcp">
            <span class="t-mono">S2 · First paint</span>
            <span class="tele__bar" aria-hidden="true"><i></i></span>
            <b data-v>—</b>
          </li>
          <li data-sector="load">
            <span class="t-mono">S3 · Loaded</span>
            <span class="tele__bar" aria-hidden="true"><i></i></span>
            <b data-v>—</b>
          </li>
        </ul>

        <dl class="tele__misc">
          <div>
            <dt class="t-mono">Transferred</dt>
            <dd data-tele-bytes>—</dd>
          </div>
          <div>
            <dt class="t-mono">Requests</dt>
            <dd data-tele-reqs>—</dd>
          </div>
          <div>
            <dt class="t-mono">Served from</dt>
            <dd data-tele-colo>—</dd>
          </div>
          <div>
            <dt class="t-mono">Scrutineering</dt>
            <dd data-tele-score>—</dd>
          </div>
        </dl>

        <p class="tele__legend t-mono" aria-hidden="true">
          <span><i class="is-purple"></i>Fastest</span>
          <span><i class="is-green"></i>Quick</span>
          <span><i class="is-yellow"></i>Napping</span>
        </p>
      </aside>

      <!-- ============ The document ============ -->
      <div class="doc-wrap">
        <article class="doc" data-doc aria-labelledby="doc-title">
          <svg class="doc__clip" viewBox="0 0 40 110" aria-hidden="true">
            <path
              d="M14 104 V20 a10 10 0 0 1 20 0 V88 a14 14 0 0 1 -28 0 V30 a6 6 0 0 1 12 0 V84"
              fill="none"
              stroke-width="3.2"
              stroke-linecap="round"></path>
          </svg>

          <header class="doc__head">
            <div class="doc__seal" aria-hidden="true">
              <svg viewBox="0 0 80 80">
                <circle cx="40" cy="40" r="37" fill="none" stroke-width="2"></circle>
                <circle cx="40" cy="40" r="30" fill="none" stroke-width="1" stroke-dasharray="2 3"></circle>
                <path
                  d="M24 46 L26 24 L35 33 H45 L54 24 L56 46 C56 55 49 60 40 60 C31 60 24 55 24 46 Z"
                  stroke-width="2.2"
                  stroke-linejoin="round"></path>
                <path d="M29 42 H51" stroke-width="3" stroke-linecap="round"></path>
              </svg>
            </div>
            <div>
              <p class="doc__org t-mono">Fédération Internationale de l’Automeowbile <span>(not that one)</span></p>
              <h3 class="doc__title t-condensed" id="doc-title">2026/27 Formula Bilal Technical Regulations</h3>
            </div>
            <dl class="doc__meta t-mono">
              <div><dt>Document</dt><dd>BR-TECH-09</dd></div>
              <div><dt>Issue</dt><dd>9 (one per life)</dd></div>
              <div><dt>Date</dt><dd>23.09.2026</dd></div>
              <div><dt>Status</dt><dd>Published while the owner slept</dd></div>
            </dl>
          </header>

          <ol class="doc__arts" role="list">
            {
              articles.map((a) => (
                <>
                  <li class:list={['art', { 'art--redacted': a.redacted }]} data-reveal="up" data-check={a.check}>
                    <span class="art__no t-condensed" aria-hidden="true">
                      <small class="t-mono">Art.</small>
                      {a.no}
                    </span>
                    <div class="art__body">
                      <h4 class="art__title">
                        <span class="visually-hidden">Article {a.no}: </span>
                        {a.title}
                      </h4>
                      <p class="art__tech t-mono">{a.tech}</p>
                      <p class="art__rule" set:html={a.rule} />
                    </div>
                    <p class="art__badge t-mono" data-badge data-state="pending">
                      <span class="art__icon" aria-hidden="true" />
                      <span data-badge-text>Scrutineering…</span>
                    </p>
                  </li>
                  {a.no === note.after && (
                    <li class="note" data-reveal="up">
                      <figure>
                        <blockquote class="note__text t-condensed">
                          <p>{note.text}</p>
                        </blockquote>
                        <figcaption class="note__by t-mono">— {note.by}</figcaption>
                      </figure>
                    </li>
                  )}
                </>
              ))
            }
          </ol>

          <footer class="doc__foot">
            <div class="doc__stamp" data-stamp>
              <span class="doc__stamp-main t-condensed"
                >Homologated<span class="doc__stamp-star" aria-hidden="true">*</span></span
              >
              <!-- Two short fixed lines, rewritten after scrutineering without resizing the stamp. -->
              <span class="doc__stamp-sub t-mono">
                <span data-stamp-l1>Awaiting</span>
                <span data-stamp-l2>scrutineering</span>
              </span>
            </div>
            <div class="doc__sign" aria-label="Signed by the three stewards, all asleep">
              {
                ['Steward I (asleep)', 'Steward II (asleep)', 'Steward III (a dog, somehow)'].map((s, i) => (
                  <figure class="doc__sig" aria-hidden="true">
                    <svg viewBox="0 0 40 40" style={`rotate:${[-14, 8, -4][i]}deg`}>
                      <ellipse cx="20" cy="25" rx="8.5" ry="7" />
                      <circle cx="10" cy="14" r="3.4" />
                      <circle cx="16.5" cy="9" r="3.4" />
                      <circle cx="23.5" cy="9" r="3.4" />
                      <circle cx="30" cy="14" r="3.4" />
                    </svg>
                    <figcaption class="t-mono">{s}</figcaption>
                  </figure>
                ))
              }
            </div>
            <p class="doc__page t-mono">Page 1 of 1 · Naps are not a technical infringement.</p>
          </footer>
        </article>
      </div>
    </div>
  </div>

  <!-- Popover API: the stewards' decision (Art. 7.1) -->
  <div id="stewards-decision" class="decision" popover data-lenis-prevent>
    <p class="decision__org t-mono">Fédération Internationale de l’Automeowbile</p>
    <h3 class="decision__title t-condensed">Stewards’ Decision · Document 9</h3>
    <dl class="decision__grid">
      <div><dt class="t-mono">Summoned</dt><dd>{owner.role} — {owner.fullName} (“{owner.nicknameLatin}”), callsign {owner.callsign}</dd></div>
      <div><dt class="t-mono">Competitor</dt><dd>Bilal Racing · Cars {cars}</dd></div>
      <div><dt class="t-mono">Time</dt><dd>03:00 (zoomies o’clock)</dd></div>
      <div><dt class="t-mono">Session</dt><dd>Scrutineering</dd></div>
      <div>
        <dt class="t-mono">Fact</dt>
        <dd>
          Both cars found to possess two ears and one tail.{
            buildDriver && ` Car #${buildDriver.number} also possesses this website, built instead of a single practice lap.`
          }
        </dd>
      </div>
      <div><dt class="t-mono">Infringement</dt><dd>Excessive cuteness — Art. 3.1.</dd></div>
      <div><dt class="t-mono">Decision</dt><dd><strong>No further action.</strong></dd></div>
      <div><dt class="t-mono">Reason</dt><dd>The team principal slept through the hearing. So did the stewards.</dd></div>
    </dl>
    <button type="button" class="decision__close" popovertarget="stewards-decision" popovertargetaction="hide">
      Close · Esc
    </button>
  </div>
</section>

<style>
  .regs {
    --paper: var(--c-chalk);
    --ink: var(--c-carbon);
    --ink-2: color-mix(in oklab, var(--c-carbon) 68%, var(--c-chalk));
    --rule: color-mix(in oklab, var(--c-carbon) 14%, transparent);
    --ok: color-mix(in oklab, var(--c-teal) 52%, black);
    --bad: color-mix(in oklab, var(--c-red) 78%, black);
    --info: color-mix(in oklab, var(--c-saffron) 62%, black);
    --stamp: color-mix(in oklab, var(--c-maroon) 88%, var(--c-red));
    overflow-x: clip;
  }

  .regs__layout {
    display: grid;
    gap: var(--space-6);
    align-items: start;
  }

  @media (min-width: 64rem) {
    .regs__layout {
      grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
      gap: var(--space-7);
    }

    .tele {
      position: sticky;
      top: calc(var(--nav-h) + var(--space-5));
    }
  }

  /* ---------- Telemetry ---------- */
  .tele {
    display: grid;
    gap: var(--space-3);
    padding: var(--space-5);
    border-radius: var(--radius-l);
    border: 1px solid var(--c-line-strong);
    background:
      radial-gradient(100% 70% at 0% 0%, rgb(179 107 255 / 0.12), transparent 60%),
      repeating-linear-gradient(0deg, rgb(255 255 255 / 0.018) 0 1px, transparent 1px 4px),
      linear-gradient(180deg, var(--c-graphite), var(--c-asphalt));
    box-shadow: 0 40px 80px -50px rgb(0 0 0 / 0.9);
  }

  .tele__kicker {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--c-mute);
  }

  .tele__dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--c-teal);
    box-shadow: 0 0 10px var(--c-teal);
  }

  .tele__label {
    margin-top: var(--space-3);
    color: var(--c-mute);
  }

  .tele__big {
    display: flex;
    align-items: baseline;
    gap: 0.25rem;
    font-family: var(--f-display);
    font-weight: 850;
    font-size: clamp(4rem, 3rem + 4vw, 6.5rem);
    line-height: 0.85;
    color: var(--c-purple);
    font-variant-numeric: tabular-nums;
  }

  .tele[data-grade='green'] .tele__big {
    color: var(--c-teal);
  }

  .tele[data-grade='yellow'] .tele__big {
    color: var(--c-gold);
  }

  .tele__big small {
    font-size: 0.28em;
    color: var(--c-mute);
    font-weight: 700;
  }

  .tele__verdict {
    font-size: var(--fs-small);
    line-height: 1.5;
    color: var(--c-chalk);
    /* three lines: room for the longest verdict, so filling it in never reflows the page */
    min-height: 4.5em;
  }

  .tele__sectors {
    --label-w: 8.5rem;
    display: grid;
    grid-template-columns: var(--label-w) minmax(0, 1fr) auto;
    gap: var(--space-3);
    margin-top: var(--space-3);
    padding: var(--space-4) 0;
    border-block: 1px solid var(--c-line-strong);
    list-style: none;
  }

  /* The value column sizes to the longest time; subgrid keeps all three bars the same length. */
  .tele__sectors li {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: var(--label-w) minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-3);
  }

  @supports (grid-template-columns: subgrid) {
    .tele__sectors li {
      grid-template-columns: subgrid;
    }
  }

  .tele__sectors .t-mono {
    color: var(--c-mute);
    font-size: 0.62rem;
    white-space: nowrap;
  }

  .tele__sectors b {
    text-align: right;
    font-family: var(--f-mono);
    font-size: 0.8rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .tele__bar {
    height: 6px;
    border-radius: 3px;
    background: rgb(255 255 255 / 0.06);
    overflow: hidden;
  }

  .tele__bar i {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: var(--sector, var(--c-steel));
    transform: scaleX(var(--p, 0));
    transform-origin: 0 50%;
    transition: transform 1.2s var(--ease-out-expo) var(--d, 0ms);
  }

  [data-grade='purple'] {
    --sector: var(--c-purple);
  }

  [data-grade='green'] {
    --sector: var(--c-teal);
  }

  [data-grade='yellow'] {
    --sector: var(--c-gold);
  }

  .tele__sectors [data-grade] b {
    color: var(--sector);
  }

  .tele__misc {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4) var(--space-3);
  }

  .tele__misc dt {
    color: var(--c-mute);
    font-size: 0.6rem;
  }

  .tele__misc dd {
    font-family: var(--f-display);
    font-weight: 750;
    font-size: 1.15rem;
    line-height: 1.2;
    overflow-wrap: anywhere;
  }

  .tele__legend {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    color: var(--c-mute);
    font-size: 0.58rem;
  }

  .tele__legend span {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .tele__legend i {
    width: 0.8rem;
    height: 4px;
    border-radius: 2px;
  }

  .is-purple {
    background: var(--c-purple);
  }

  .is-green {
    background: var(--c-teal);
  }

  .is-yellow {
    background: var(--c-gold);
  }

  /* ---------- Paper document ---------- */
  .doc-wrap {
    container: doc / inline-size;
    min-width: 0;
  }

  .doc {
    position: relative;
    color: var(--ink);
    background:
      radial-gradient(120% 60% at 50% 0%, rgb(255 255 255 / 0.55), transparent 70%),
      radial-gradient(140% 90% at 100% 100%, rgb(160 120 60 / 0.12), transparent 60%),
      linear-gradient(90deg, transparent calc(100% - 3px), rgb(0 0 0 / 0.04)),
      var(--paper);
    border-radius: 3px;
    padding: clamp(1.4rem, 0.8rem + 3.5cqi, 3.5rem);
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.5) inset,
      0 2px 0 rgb(0 0 0 / 0.15),
      0 30px 60px -20px rgb(0 0 0 / 0.75),
      0 80px 120px -60px rgb(0 0 0 / 0.9);
    transform-origin: 50% 0%;
  }

  /* A second sheet peeking out underneath — layered depth. */
  .doc::before {
    content: '';
    position: absolute;
    inset: 10px -6px -10px 8px;
    z-index: -1;
    border-radius: 3px;
    background: color-mix(in oklab, var(--paper) 88%, var(--c-carbon));
    rotate: 1.4deg;
    box-shadow: 0 20px 40px -20px rgb(0 0 0 / 0.8);
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .doc {
        animation: doc-settle linear both;
        animation-timeline: view();
        animation-range: entry 0% entry 70%;
      }
    }
  }

  @keyframes doc-settle {
    from {
      transform: translate3d(0, 90px, 0) rotate(-3.5deg);
    }
    to {
      transform: none;
    }
  }

  .doc__clip {
    position: absolute;
    top: -1.6rem;
    left: 2.2rem;
    width: 1.5rem;
    height: auto;
    stroke: #8f94a3;
    filter: drop-shadow(1px 2px 1px rgb(0 0 0 / 0.35));
  }

  .doc__head {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: var(--space-4) var(--space-5);
    padding-bottom: var(--space-5);
    border-bottom: 3px double var(--ink);
  }

  .doc__seal svg {
    width: clamp(3.2rem, 2.4rem + 3cqi, 5rem);
    height: auto;
    stroke: var(--ink);
    fill: none;
  }

  .doc__org {
    color: var(--ink-2);
    font-size: 0.64rem;
    letter-spacing: 0.12em;
  }

  .doc__org span {
    text-transform: none;
    letter-spacing: 0.02em;
  }

  .doc__title {
    margin-top: var(--space-2);
    font-size: clamp(1.7rem, 1rem + 4cqi, 3rem);
    line-height: 0.92;
    text-transform: uppercase;
    font-weight: 850;
    color: var(--ink);
  }

  .doc__meta {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3) var(--space-4);
    font-size: 0.6rem;
  }

  .doc__meta dt {
    color: var(--ink-2);
  }

  .doc__meta dd {
    color: var(--ink);
    font-weight: 700;
    letter-spacing: 0.06em;
  }

  @container doc (min-width: 40rem) {
    .doc__meta {
      grid-template-columns: repeat(4, auto);
      justify-content: space-between;
    }
  }

  /* ---------- Articles ---------- */
  .doc__arts {
    list-style: none;
    padding: 0;
  }

  .art {
    display: grid;
    grid-template-columns: 3.4rem minmax(0, 1fr);
    gap: var(--space-2) var(--space-4);
    padding-block: var(--space-5);
    border-bottom: 1px solid var(--rule);
  }

  .art__no {
    font-family: var(--f-display);
    font-weight: 850;
    font-size: 1.7rem;
    line-height: 1;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }

  .art__no small {
    display: block;
    margin-bottom: 0.2rem;
    color: var(--ink-2);
    font-size: 0.55rem;
    font-weight: 600;
  }

  .art__body {
