---
/**
 * Tuna Run — a three-lane, 45-second tuna collection (logic: scripts/games/tuna.ts).
 * Cans and puddles are a fixed pool of elements the script re-uses; each holds
 * both drawings and `data-kind` picks the one to show.
 */
import Cabinet from './Cabinet.astro';
import { team } from '@/data/lore';

const POOL = 20;
---

<Cabinet
  id="tuna"
  kicker="Game 05 · 45-second stint"
  scoreLabel="Tuna"
  auxLabel="Time left"
  pitch="Catering has dropped the tuna on the racing line. Collect every can before the stint ends."
  how={[
    'Tap a lane to drive there. Drive over the cans.',
    'A gold can counts three. Nine cans in a row is a bonus.',
    'Steer round the puddles: a splash ends your row of nine.',
  ]}
  keys="← →"
>
  <div class="tn" aria-hidden="true">
    <div class="tn-road" data-tn-road>
      <span class="tn-lines" data-tn-lines></span>
      {
        Array.from({ length: POOL }, () => (
          <span class="tn-item" data-tn-item data-kind="tuna" hidden>
            <svg class="tn-can" viewBox="0 0 40 40">
              <path class="tn-can-side" d="M6 15v11c0 3.3 6.3 6 14 6s14-2.7 14-6V15" />
              <ellipse class="tn-can-top" cx="20" cy="15" rx="14" ry="6" />
              <path class="tn-can-fish" d="M12 15c2.2-2.2 5.4-2.7 8.5-1l3.5-2v6l-3.5-2c-3.1 1.7-6.3 1.2-8.5-1z" />
            </svg>
            <svg class="tn-puddle" viewBox="0 0 40 40">
              <path d="M4 22c0-5 5-9 13-8 4-3 11-2 13 2 4 1 6 4 6 7 0 5-7 8-16 8S4 27 4 22z" />
              <path class="tn-puddle-shine" d="M11 20c2-2 5-3 8-3" />
            </svg>
          </span>
        ))
      }
      <span class="tn-car" data-tn-car>
        <svg viewBox="0 0 40 40">
          <path class="tn-tyre" d="M5 6h6v9H5zM29 6h6v9h-6zM4 25h7v10H4zM29 25h7v10h-7z"></path>
          <path class="tn-wing" d="M8 2h24v3H8zM9 35h22v4H9z"></path>
          <path class="tn-body" d="M18 3h4l2 10c3 1 5 4 5 8v8c0 3-2 5-4 6H15c-2-1-4-3-4-6v-8c0-4 2-7 5-8z"></path>
          <ellipse class="tn-cockpit" cx="20" cy="19" rx="2.6" ry="4.5"></ellipse>
          <text class="tn-num" x="20" y="31.5" text-anchor="middle">{team.luckyNumber}</text>
        </svg>
      </span>
      <span class="tn-pop t-mono" data-tn-pop hidden></span>
    </div>
  </div>
</Cabinet>

<style>
  .tn {
    --tn-water: color-mix(in oklab, var(--c-teal) 45%, var(--c-purple));
    position: absolute;
    inset: 0;
    display: grid;
    justify-items: center;
  }

  .tn-road {
    position: relative;
    width: min(100%, 22rem);
    height: 100%;
    overflow: hidden;
    border-inline: 3px solid var(--c-line-strong);
    background: color-mix(in oklab, var(--c-carbon) 55%, var(--c-asphalt));
  }

  /* Two dashed lane lines, one dash period (3rem) taller than the road so they can scroll. */
  .tn-lines {
    position: absolute;
    inset: -3rem 0 0;
    background:
      repeating-linear-gradient(to bottom, var(--c-line-strong) 0 1.25rem, transparent 1.25rem 3rem) 33.333% 0 / 3px 100% no-repeat,
      repeating-linear-gradient(to bottom, var(--c-line-strong) 0 1.25rem, transparent 1.25rem 3rem) 66.666% 0 / 3px 100% no-repeat;
  }

  .tn-item,
  .tn-car,
  .tn-pop {
    position: absolute;
    left: 0;
    top: 0;
    width: 33.333%;
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    pointer-events: none;
    will-change: transform;
  }

  .tn-item svg {
    grid-area: 1 / 1;
    width: 56%;
    height: auto;
    overflow: visible;
  }

  .tn-item[data-kind='puddle'] .tn-can,
  .tn-item:not([data-kind='puddle']) .tn-puddle {
    display: none;
  }

  .tn-can-side {
    fill: var(--c-steel);
    stroke: var(--c-mute);
    stroke-width: 1.2;
  }

  .tn-can-top {
    fill: var(--c-chalk);
    stroke: var(--c-mute);
    stroke-width: 1.2;
  }

  .tn-can-fish {
    fill: var(--c-saffron);
  }

  .tn-item[data-kind='gold'] .tn-can {
    filter: drop-shadow(0 0 0.5rem rgb(255 197 46 / 0.7));
  }

  .tn-item[data-kind='gold'] .tn-can-side,
  .tn-item[data-kind='gold'] .tn-can-top {
    fill: var(--c-gold);
    stroke: var(--c-on-gold);
  }

  .tn-item[data-kind='gold'] .tn-can-fish {
    fill: var(--c-on-gold);
  }

  .tn-puddle {
    fill: color-mix(in oklab, var(--tn-water) 55%, transparent);
    stroke: var(--tn-water);
    stroke-width: 1.2;
  }

  .tn-item .tn-puddle {
    width: 78%;
  }

  .tn-puddle-shine {
    fill: none;
    stroke: var(--c-chalk);
    stroke-linecap: round;
    opacity: 0.6;
  }

  /* ---------------- the car ---------------- */
  .tn-car {
    transition: transform 110ms var(--ease-out-expo);
  }

  .tn-car svg {
    width: 84%;
    height: auto;
    overflow: visible;
  }

  .tn-tyre {
    fill: var(--c-steel);
  }

  .tn-wing {
    fill: var(--c-maroon);
  }

  .tn-body {
    fill: var(--c-graphite);
    stroke: var(--c-gold);
    stroke-width: 1;
    stroke-linejoin: round;
  }

  .tn-cockpit {
    fill: var(--c-carbon);
  }

  .tn-num {
    fill: var(--c-gold);
    font-family: var(--f-display);
    font-weight: 850;
    font-size: 7px;
  }

  .tn-pop {
    aspect-ratio: auto;
    height: auto;
    color: var(--c-gold);
    font-weight: 700;
    text-align: center;
    white-space: nowrap;
  }
</style>
