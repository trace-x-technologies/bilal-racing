---
/**
 * Chequered-flag footer: brand block, section links, "Box, box ↑" back-to-top,
 * Sinhala sign-off, a giant BILAL wordmark whose letters rise in on scroll
 * (and stretch toward the pointer), credits and the legal-ish disclaimer.
 *
 * `base` prefixes the in-page anchors (use base="/" on other pages).
 */
import Emblem from '@/components/ui/Emblem.astro';
import { team, owner, drivers, sinhala } from '@/data/lore';

interface Props {
  base?: string;
}
const { base = '' } = Astro.props;

// The site came out of car #13's garage (the DHA bio and stat carry the "instead of practising" joke).
const builder = drivers.find((d) => d.id === 'dha');
/**
 * "© 2026 Bilal Racing · #13 DHA · #17 DEE · Team Principal: Poosa (RAT) · Built with Astro in the #13 garage · …"
 * Each credit renders as its own nowrap span with a trailing "·", so the line only breaks
 * between credits, never inside one, and no line starts with a separator.
 */
const credits = [
  team.name,
  ...drivers.map((d) => `#${d.number} ${d.code}`),
  `Team Principal: ${owner.nicknameLatin} (${owner.callsign})`,
  builder ? `Built with Astro in the #${builder.number} garage` : 'Built with Astro',
  'served from Cloudflare’s edge',
];

const links = [
  { id: 'driver', label: 'Line-up' },
  { id: 'career', label: 'History' },
  { id: 'car', label: 'Car' },
  { id: 'crew', label: 'Crew' },
  { id: 'paddock', label: 'Paddock' },
  { id: 'calendar', label: 'Calendar' },
  { id: 'lights-out', label: 'Lights Out' },
  { id: 'radio', label: 'Radio' },
  { id: 'sponsors', label: 'Partners' },
  { id: 'tech', label: 'Tech regs' },
];
const letters = ['B', 'I', 'L', 'A', 'L'];
// Stint notes by seconds spent in the footer. All four are stacked in one grid cell, so the
// note is always sized for the longest: a later, longer line can't grow the footer after
// ScrollTrigger has measured it.
const stintNotes: [number, string][] = [
  [0, '· still warming the tyres'],
  [60, '· longer than the owner’s last stint awake'],
  [180, '· purple sector. The owner is napping.'],
  [600, '· you are now officially crew'],
];
const year = new Date().getFullYear();
---

<footer class="footer" data-footer>
  <div class="flag-strip" aria-hidden="true"></div>

  <div class="container footer-grid" data-reveal-stagger="90">
    <div class="f-brand" data-reveal="up">
      <p class="f-kicker t-mono"><span class="f-kicker-dot" aria-hidden="true"></span> Chequered flag · end of page</p>
      <div class="f-id">
        <Emblem size="4rem" title="" />
        <div>
          <p class="f-name t-condensed">{team.name}</p>
          <p class="f-tag t-mute">{team.tagline}</p>
        </div>
      </div>
      <p class="f-lap t-mono" aria-live="off">
        Your stint: <span class="f-lap-time" data-stint>00:00</span>
        <span class="f-lap-note t-mute">
          <span data-stint-note>{stintNotes[0]?.[1]}</span>
          {
            stintNotes.map(([at, line]) => (
              <span class="f-lap-ghost" data-stint-line={at} aria-hidden="true">
                {line}
              </span>
            ))
          }
        </span>
      </p>
    </div>

    <nav class="f-nav" aria-label="Footer" data-reveal="up">
      <p class="f-col-title t-mono">Sectors</p>
      <ul class="f-links">
        {
          links.map((l, i) => (
            <li>
              <a href={`${base}#${l.id}`}>
                <span class="f-idx t-mono" aria-hidden="true">
                  {String(i + 1).padStart(2, '0')}
                </span>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="f-signoff" data-reveal="up">
      <p class="f-col-title t-mono">Team radio · sign-off</p>
      <p class="f-si">
        <span class="t-si" lang="si">{sinhala.ayubowan.si}</span>
        <span class="f-si-mean">{sinhala.ayubowan.en}. All nine times.</span>
      </p>
      <p class="f-si">
        <span class="t-si" lang="si">{sinhala.subaGaman.si}</span>
        <span class="f-si-mean">{sinhala.subaGaman.en}. Mind the laser pointers.</span>
      </p>
      <button type="button" class="box-box" data-box-box>
        <span class="box-box-ring" aria-hidden="true"></span>
        <span class="box-box-label t-condensed">Box, box <span aria-hidden="true">↑</span></span>
        <span class="box-box-sub t-mono">Back to the top</span>
      </button>
    </div>
  </div>

  <div class="wordmark" data-wordmark aria-hidden="true">
    {
      letters.map((ch) => (
        <span class="wm-mask">
          <span class="wm-letter" data-letter>
            <span class="wm-ghost">{ch}</span>
            <span class="wm-glyph">{ch}</span>
          </span>
        </span>
      ))
    }
  </div>

  <div class="container f-bottom">
    <p class="f-credits t-mono">
      {
        credits.map((c, i) => (
          <>
            {i > 0 && ' '}
            <span class="f-credit">
              {i === 0 && (
                <>
                  © <span data-year>{year}</span>{' '}
                </>
              )}
              {c}
              {i < credits.length - 1 && ' ·'}
            </span>
          </>
        ))
      }
    </p>
    <p class="f-disclaimer">
      Bilal Racing is a fictional team made by friends for fun. No cats were harmed. Several naps were.
    </p>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    isolation: isolate;
    overflow: clip;
    padding-top: var(--space-9);
    background:
      radial-gradient(70% 60% at 85% 100%, rgb(160 21 62 / 0.28), transparent 70%),
      radial-gradient(50% 40% at 10% 90%, rgb(255 197 46 / 0.08), transparent 70%),
      linear-gradient(to bottom, var(--c-carbon), #0b0b11);
    border-top: 1px solid var(--c-line);
  }

  /* ---------- Chequered flag strip ---------- */
  .flag-strip {
    position: absolute;
    inset: 0 0 auto;
    height: 1.25rem;
    overflow: hidden;
    opacity: 0.9;
    mask: linear-gradient(to bottom, #000 0 50%, transparent);
    -webkit-mask: linear-gradient(to bottom, #000 0 50%, transparent);
  }

  /* Wider than the strip so it can slide one tile-pair on the compositor. */
  .flag-strip::before {
    content: '';
    position: absolute;
    inset: 0 0 0 -2.5rem;
    background: repeating-conic-gradient(var(--c-chalk) 0 25%, var(--c-carbon) 0 50%) 0 0 / 1.25rem 1.25rem;
  }

  :global(.js-motion) .flag-strip::before {
    animation: flag-slide 5s linear infinite;
  }

  @keyframes flag-slide {
    to {
      transform: translateX(2.5rem);
    }
  }

  /* ---------- Grid ---------- */
  .footer-grid {
    display: grid;
    gap: var(--space-7);
    grid-template-columns: 1fr;
  }

  @media (min-width: 48em) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }

    .f-brand {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 64em) {
    .footer-grid {
      grid-template-columns: 1.3fr 1fr 1.1fr;
    }

    .f-brand {
      grid-column: auto;
    }
  }

  .f-kicker {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--c-mute);
    margin-bottom: var(--space-5);
  }

  .f-kicker-dot {
    width: 0.5rem;
    height: 0.5rem;
    background: var(--c-gold);
    transform: rotate(45deg);
  }

  .f-id {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .f-name {
    font-family: var(--f-display);
    font-size: var(--fs-h3);
    font-weight: 850;
    text-transform: uppercase;
    line-height: 0.9;
  }

  .f-tag {
    margin-top: var(--space-1);
    font-size: var(--fs-small);
  }

  .f-lap {
    margin-top: var(--space-5);
    color: var(--c-chalk);
    font-size: 0.66rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4em;
  }

  .f-lap-time {
    color: var(--c-purple);
    font-variant-numeric: tabular-nums;
  }

  /* One cell, sized by the longest note; only the live one is painted. */
  .f-lap-note {
    display: inline-grid;
  }

  .f-lap-note > * {
    grid-area: 1 / 1;
  }

  .f-lap-ghost {
    visibility: hidden;
  }

  .f-col-title {
    color: var(--c-mute);
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--c-line);
  }

  .f-links {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-2) var(--space-5);
  }

  .f-links a {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5em;
    padding-block: 0.3rem;
    text-decoration: none;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-variation-settings: 'wdth' 80;
    color: var(--c-chalk);
    transition:
      color var(--dur-fast) ease,
      transform var(--dur-med) var(--ease-out-expo);
  }

  .f-idx {
    font-size: 0.58rem;
    color: var(--c-faint);
  }

  .f-links a:hover,
  .f-links a:focus-visible {
    color: var(--c-gold);
    transform: translateX(0.3rem);
  }

  .f-links a:hover .f-idx {
    color: var(--c-gold);
  }

  /* ---------- Sign-off ---------- */
  .f-si {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25em 0.6em;
    margin-bottom: var(--space-3);
  }

  .f-si .t-si {
    font-size: clamp(1.3rem, 1.1rem + 0.8vw, 1.75rem);
    color: var(--c-gold);
    line-height: 1.3;
  }

  .f-si-mean {
    color: var(--c-mute);
    font-size: var(--fs-small);
  }

  .f-si-mean::first-letter {
    text-transform: uppercase;
  }

  /* ---------- Box, box ---------- */
  .box-box {
    position: relative;
    margin-top: var(--space-5);
    display: inline-grid;
    justify-items: start;
    gap: 0.1rem;
    padding: 0.85rem 1.6rem 0.8rem 1.3rem;
    color: var(--c-on-gold);
    isolation: isolate;
  }

  .box-box::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--c-gold);
    transform: skewX(var(--skew));
    border-radius: var(--radius-s);
    box-shadow: var(--glow-gold);
    transition:
      transform var(--dur-med) var(--ease-out-back),
      background-color var(--dur-fast) ease;
  }

  .box-box-ring {
    position: absolute;
    inset: -6px;
    z-index: -2;
    border: 1px dashed color-mix(in oklab, var(--c-gold) 60%, transparent);
    border-radius: var(--radius-m);
    transform: skewX(var(--skew));
    opacity: 0;
    transition: opacity var(--dur-fast) ease;
  }

  .box-box-label {
    font-family: var(--f-display);
    font-size: 1.6rem;
    font-weight: 900;
    text-transform: uppercase;
    line-height: 1;
  }

  .box-box-label span {
    display: inline-block;
    transition: transform var(--dur-med) var(--ease-out-back);
  }

  .box-box-sub {
    font-size: 0.58rem;
    opacity: 0.8;
  }

  .box-box:hover::before,
  .box-box:focus-visible::before {
    transform: skewX(var(--skew)) scale(1.04);
    background: #ffd35c;
  }

  .box-box:hover .box-box-ring,
  .box-box:focus-visible .box-box-ring {
    opacity: 1;
  }

  .box-box:hover .box-box-label span {
    transform: translateY(-0.2em);
  }

  .box-box:active::before {
    transform: skewX(var(--skew)) scale(0.97);
  }

  /* ---------- Giant wordmark ---------- */
  .wordmark {
    position: relative;
    container-type: inline-size;
    width: min(100% - 2 * var(--gutter), var(--maxw));
    margin: var(--space-8) auto 0;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    line-height: 0.8;
    user-select: none;
  }

  .wm-mask {
    display: block;
    overflow: clip;
    overflow-clip-margin: 0.02em;
    padding-top: 0.08em;
  }

  .wm-letter {
    position: relative;
    display: block;
    will-change: transform;
  }

  .wm-glyph,
  .wm-ghost {
    display: block;
    font-family: var(--f-display);
    /* Fills the container edge to edge: 5 heavy glyphs ≈ 2.7em wide. */
    font-size: 36.5cqi;
    font-weight: 900;
    font-variation-settings: 'wdth' 100;
    text-transform: uppercase;
    transform-origin: 50% 100%;
    scale: 1 var(--s, 1);
    transition: scale 500ms var(--ease-out-expo);
  }

  .wm-glyph {
    position: relative;
    background:
      linear-gradient(180deg, rgb(255 255 255 / 0.2), transparent 40%),
      var(--g-livery);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  /* Outline echo behind each letter: layered depth, trails on the way up. */
  .wm-ghost {
    position: absolute;
    inset: 0;
    color: transparent;
    -webkit-text-stroke: 1.5px color-mix(in oklab, var(--c-gold) 55%, transparent);
    translate: 0.035em 0.03em;
  }

  .wm-mask:nth-child(4) .wm-glyph {
    background: linear-gradient(180deg, #fff3c4, var(--c-gold) 45%, var(--c-saffron));
    -webkit-background-clip: text;
    background-clip: text;
  }

  /* ---------- Bottom bar ---------- */
  .f-bottom {
    display: grid;
    gap: var(--space-3);
    padding-block: var(--space-5) max(var(--space-6), env(safe-area-inset-bottom));
    border-top: 1px solid var(--c-line);
    margin-top: var(--space-3);
  }

  .f-credits {
    color: var(--c-mute);
    line-height: 1.8;
    font-size: 0.62rem;
  }

  .f-credit {
    white-space: nowrap;
  }

  .f-disclaimer {
    color: var(--c-mute);
    font-size: var(--fs-small);
  }

  @media (min-width: 64em) {
    .f-bottom {
      grid-template-columns: 1fr auto;
      align-items: center;
    }
  }
</style>

<script>
  import { gsap, prefersReducedMotion, scrollToTarget } from '@/scripts/motion';

  const footer = document.querySelector<HTMLElement>('[data-footer]');

  if (footer) {
    /* ---------- Box, box: back to the top ---------- */
    footer.querySelector<HTMLButtonElement>('[data-box-box]')?.addEventListener('click', () => {
      scrollToTarget(0);
      // Move keyboard focus back to the top too (brand link, else skip link).
      const top = document.querySelector<HTMLElement>('[data-egg="emblem"]') ?? document.querySelector<HTMLElement>('a[href="#main"]');
      top?.focus({ preventScroll: true });
    });

    /* ---------- Year stays current even on an old build ---------- */
    const yearEl = footer.querySelector<HTMLElement>('[data-year]');
    if (yearEl) yearEl.textContent = String(new Date().getFullYear());

    /* ---------- Stint timer (only ticks while the footer is on screen) ---------- */
    const stint = footer.querySelector<HTMLElement>('[data-stint]');
    const note = footer.querySelector<HTMLElement>('[data-stint-note]');
    const t0 = performance.now();
    const notes: [number, string][] = Array.from(
      footer.querySelectorAll<HTMLElement>('[data-stint-line]'),
      (el): [number, string] => [Number(el.dataset.stintLine), el.textContent?.trim() ?? ''],
    );
    let timer = 0;
    const render = () => {
      const s = Math.floor((performance.now() - t0) / 1000);
      if (stint) stint.textContent = `${String(Math.floor(s / 60)).padStart(2, '0')}:${String(s % 60).padStart(2, '0')}`;
      if (note) {
        let text = notes[0]?.[1] ?? '';
        for (const [at, line] of notes) if (s >= at) text = line;
        if (note.textContent !== text) note.textContent = text;
      }
    };
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(([entry]) => {
        window.clearInterval(timer);
        if (entry?.isIntersecting) {
          render();
          timer = window.setInterval(render, 1000);
        }
      }).observe(footer);
    }

    /* ---------- Wordmark: letters rise in, then stretch toward the pointer ---------- */
    const wordmark = footer.querySelector<HTMLElement>('[data-wordmark]');
    const letters = Array.from(footer.querySelectorAll<HTMLElement>('[data-letter]'));

    if (wordmark && letters.length && !prefersReducedMotion()) {
      const ghosts = letters
        .map((l) => l.querySelector<HTMLElement>('.wm-ghost'))
        .filter((g): g is HTMLElement => g !== null);
      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: wordmark,
          start: 'top bottom',
          end: 'bottom bottom',
          scrub: 0.8,
        },
      });
      tl.fromTo(
        letters,
        { yPercent: 105, rotate: (i: number) => (i % 2 ? 6 : -6) },
        { yPercent: 0, rotate: 0, ease: 'power3.out', stagger: 0.12, duration: 1 },
        0,
      ).fromTo(
        ghosts,
        { yPercent: 30, opacity: 0 },
        { yPercent: 0, opacity: 1, ease: 'power2.out', stagger: 0.12, duration: 1 },
        0.2,
      );

      if (window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
        let centers: number[] = [];
        let raf = 0;
        let px = 0;
        const apply = () => {
          raf = 0;
          const span = wordmark.clientWidth / 3;
          letters.forEach((l, i) => {
            const d = Math.abs(px - (centers[i] ?? 0));
            const k = Math.max(0, 1 - d / span);
            l.style.setProperty('--s', (1 + k * k * 0.14).toFixed(3));
          });
        };
        wordmark.addEventListener('pointerenter', () => {
          centers = letters.map((l) => {
            const r = l.getBoundingClientRect();
            return r.left + r.width / 2;
          });
        });
        wordmark.addEventListener('pointermove', (e) => {
          px = e.clientX;
          if (!raf) raf = requestAnimationFrame(apply);
        });
        wordmark.addEventListener('pointerleave', () => {
          cancelAnimationFrame(raf);
          raf = 0;
          letters.forEach((l) => l.style.setProperty('--s', '1'));
        });
      }
    }
  }
</script>
