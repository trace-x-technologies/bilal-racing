---
/**
 * Slim header at the top of every page except Home (whose Hero has its own
 * <h1>): "Sector 02 / 06", the page's <h1>, one line about it, and jump chips
 * to the page's sections so nobody has to scroll to find them.
 */
import { pages, pageById, type PageId } from '@/data/site';

interface Props {
  page: PageId;
}
const { page } = Astro.props;
const current = pageById(page);
const index = pages.findIndex((p) => p.id === page) + 1;
const pad = (n: number) => String(n).padStart(2, '0');
---

<header class="page-head" aria-labelledby="page-title">
  <div class="container ph-inner">
    <div class="ph-id">
      <p class="ph-kicker t-mono">
        <span class="ph-dot" aria-hidden="true"></span>
        Sector <span class="ph-no">{pad(index)}</span> / {pad(pages.length)}
      </p>
      <h1 class="ph-title t-condensed" id="page-title">{current.title}</h1>
      <p class="ph-sub">{current.sub}</p>
    </div>
    {
      current.sections.length > 1 && (
        <nav class="ph-nav" aria-label="Jump to a section">
          <p class="ph-nav-label t-mono" aria-hidden="true">
            On this page
          </p>
          <ol class="ph-chips">
            {current.sections.map((s, i) => (
              <li>
                <a class="ph-chip" href={`#${s.id}`}>
                  <span class="ph-chip-i t-mono" aria-hidden="true">
                    {pad(i + 1)}
                  </span>
                  <span class="ph-chip-label t-condensed">{s.label}</span>
                  <span class="ph-chip-sub">{s.sub}</span>
                </a>
              </li>
            ))}
          </ol>
        </nav>
      )
    }
  </div>
  <div class="ph-rule" aria-hidden="true"></div>
</header>

<style>
  .page-head {
    position: relative;
    padding-top: calc(var(--nav-h) + clamp(1.5rem, 5vh, 3.5rem));
    background:
      radial-gradient(70% 120% at 100% 0%, rgb(160 21 62 / 0.28), transparent 65%),
      radial-gradient(50% 90% at 0% 0%, rgb(255 197 46 / 0.08), transparent 70%);
  }

  .ph-inner {
    display: grid;
    gap: var(--space-5);
    padding-bottom: var(--space-6);
  }

  @media (min-width: 64rem) {
    .ph-inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr);
      align-items: end;
      gap: var(--space-7);
    }
  }

  .ph-kicker {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--c-mute);
  }

  .ph-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--c-gold);
    box-shadow: var(--glow-gold);
  }

  .ph-no {
    color: var(--c-gold);
  }

  .ph-title {
    margin-top: var(--space-2);
    font-size: var(--fs-h1);
    font-weight: 850;
    line-height: 0.86;
    text-transform: uppercase;
    background: linear-gradient(to bottom, var(--c-chalk) 55%, color-mix(in oklab, var(--c-chalk) 45%, transparent));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .ph-sub {
    margin-top: var(--space-3);
    max-width: 38ch;
    color: var(--c-mute);
    font-size: var(--fs-lead);
    line-height: 1.3;
  }

  .ph-nav-label {
    margin-bottom: var(--space-2);
    color: var(--c-mute);
    font-size: 0.62rem;
  }

  .ph-chips {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-2);
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  @media (min-width: 40rem) {
    .ph-chips {
      grid-template-columns: repeat(auto-fit, minmax(9.5rem, 1fr));
    }
  }

  .ph-chip {
    height: 100%;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: var(--space-2);
    align-items: baseline;
    padding: 0.7rem 0.8rem;
    border: 1px solid var(--c-line-strong);
    border-radius: var(--radius-m);
    background: color-mix(in oklab, var(--c-asphalt) 80%, transparent);
    color: var(--c-chalk);
    text-decoration: none;
    transition:
      border-color var(--dur-fast) ease,
      transform var(--dur-med) var(--ease-out-expo),
      background-color var(--dur-fast) ease;
  }

  .ph-chip-i {
    color: var(--c-gold);
    font-size: 0.6rem;
  }

  .ph-chip-label {
    font-size: 1.35rem;
    font-weight: 800;
    line-height: 1;
    text-transform: uppercase;
  }

  .ph-chip-sub {
    grid-column: 2;
    margin-top: 0.2rem;
    color: var(--c-mute);
    font-size: 0.78rem;
    line-height: 1.25;
  }

  .ph-chip:hover,
  .ph-chip:focus-visible {
    border-color: var(--c-gold);
    background: color-mix(in oklab, var(--c-gold) 9%, var(--c-asphalt));
    transform: translateY(-2px);
  }

  .ph-rule {
    height: 3px;
    background: var(--g-livery);
    opacity: 0.85;
  }

  /* The first section sits right under the header: it doesn't need its full run-up. */
  .page-head + :global(.section) {
    padding-top: clamp(3rem, 2rem + 5vh, 5.5rem);
  }
</style>
