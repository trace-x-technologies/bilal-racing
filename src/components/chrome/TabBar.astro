---
/**
 * Bottom tab bar for phones and tablets (the desktop top bar has room for the
 * same links). Two rows, both in thumb reach:
 *   - the sections of the current page, as a sideways-scrolling strip of chips
 *     (scroll-spied by the Nav script through `data-nav-link`), and
 *   - the five pages, as tabs with a pictogram.
 * Rendered by Nav, so every page that has a Nav has it.
 */
import { pages, type PageId, type PageIcon } from '@/data/site';

interface Props {
  page?: PageId;
}
const { page } = Astro.props;
const current = pages.find((p) => p.id === page);
// Home is a map already (the hub), and its hero needs the room: no section strip there.
const sections = current && current.id !== 'home' && current.sections.length > 1 ? current.sections : [];

/** 24×24 line pictograms, one per page. */
const ICONS: Record<PageIcon, string> = {
  // chequered flag
  flag: '<path d="M5 21V4"/><path d="M5 4c4-2 6 2 10 0s4 0 4 0v9s0-2-4 0-6-2-10 0"/><path d="M10 3.6v9M15 4.4v9M5 8.5c4-2 6 2 10 0s4 0 4 0" opacity=".55"/>',
  // helmet with visor
  helmet: '<path d="M3 14a9 9 0 0 1 18-1v2a3 3 0 0 1-3 3H8a5 5 0 0 1-5-4Z"/><path d="M21 13h-7a2 2 0 0 0-2 2v0a3 3 0 0 0 3 3"/>',
  // car, top down
  car: '<rect x="8.5" y="3" width="7" height="18" rx="3.2"/><path d="M4 6.5h4.5M15.5 6.5H20M4 17.5h4.5M15.5 17.5H20M4 5v3M20 5v3M4 16v3M20 16v3"/>',
  camera: '<path d="M4 8h3l1.6-2.5h6.8L17 8h3a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V9a1 1 0 0 1 1-1Z"/><circle cx="12" cy="13.2" r="3.4"/>',
  // start lights
  lights: '<rect x="2.5" y="8" width="19" height="8" rx="2"/><circle cx="7" cy="12" r="1.6"/><circle cx="12" cy="12" r="1.6"/><circle cx="17" cy="12" r="1.6"/><path d="M12 3v5"/>',
};
---

<div class="tabbar" data-tabbar>
  {
    sections.length > 0 && (
      <nav class="tb-strip" aria-label="On this page" data-nav-strip data-lenis-prevent>
        <ul class="tb-secs">
          {sections.map((s) => (
            <li>
              <a class="tb-sec t-mono" href={`#${s.id}`} data-nav-link={s.id}>
                {s.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )
  }
  <nav class="tb-tabs" aria-label="Pages">
    <ul class="tb-list">
      {
        pages.map((p) => (
          <li>
            <a class="tb-tab" href={p.href} aria-current={p.id === page ? 'page' : undefined}>
              <svg
                class="tb-icon"
                viewBox="0 0 24 24"
                aria-hidden="true"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                stroke-linejoin="round"
                set:html={ICONS[p.icon]}
              />
              <span class="tb-label t-mono">{p.label}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</div>

<style>
  .tabbar {
    --tb-tabs-h: 3.5rem;
    --tb-strip-h: 2.75rem;
    position: fixed;
    inset: auto 0 0;
    z-index: var(--z-nav);
    padding-bottom: env(safe-area-inset-bottom);
    background: linear-gradient(to bottom, rgb(7 7 11 / 0.86), rgb(7 7 11 / 0.96));
    -webkit-backdrop-filter: blur(16px) saturate(170%);
    backdrop-filter: blur(16px) saturate(170%);
    border-top: 1px solid var(--c-line-strong);
    box-shadow: 0 -10px 30px -18px rgb(0 0 0 / 0.9);
    /* Stays put while the page underneath cross-fades to the next one. */
    view-transition-name: tabbar;
  }

  /*
   * --tabbar-h: how much of the bottom edge the bar covers (0 on desktop). The page keeps
   * that much room after the footer, and bottom-anchored overlays (toasts, EasterEggs) lift
   * themselves above it.
   */
  @media (max-width: 74.99em) {
    :global(:root:has([data-tabbar])) {
      --tabbar-h: 3.5rem;
    }

    :global(:root:has([data-tabbar] [data-nav-strip])) {
      --tabbar-h: 6.25rem;
    }

    :global(body:has([data-tabbar])) {
      padding-bottom: calc(var(--tabbar-h, 0rem) + env(safe-area-inset-bottom));
    }
  }

  @media (min-width: 75em) {
    .tabbar {
      display: none;
    }
  }

  /* ---- this page's sections ---- */
  .tb-strip {
    height: var(--tb-strip-h);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
    border-bottom: 1px solid var(--c-line);
    /* fade the chips out at both edges while they scroll */
    mask-image: linear-gradient(to right, transparent, #000 1rem, #000 calc(100% - 1rem), transparent);
  }

  .tb-strip::-webkit-scrollbar {
    display: none;
  }

  .tb-secs {
    list-style: none;
    height: 100%;
    width: max-content;
    min-width: 100%;
    margin: 0;
    padding: 0 var(--gutter);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
  }

  .tb-sec {
    display: inline-flex;
    align-items: center;
    min-height: 2rem;
    padding: 0 0.75rem;
    border: 1px solid var(--c-line-strong);
    border-radius: 999px;
    color: var(--c-chalk);
    font-size: 0.62rem;
    text-decoration: none;
    white-space: nowrap;
    -webkit-tap-highlight-color: transparent;
    transition:
      color var(--dur-fast) ease,
      border-color var(--dur-fast) ease,
      background-color var(--dur-fast) ease;
  }

  .tb-sec[aria-current] {
    background: var(--c-gold);
    border-color: var(--c-gold);
    color: var(--c-on-gold);
  }

  /* ---- the five pages ---- */
  .tb-list {
    list-style: none;
    height: var(--tb-tabs-h);
    margin: 0 auto;
    padding: 0 max(var(--space-2), env(safe-area-inset-left));
    max-width: 34rem;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
  }

  .tb-tab {
    position: relative;
    height: 100%;
    display: grid;
    justify-items: center;
    align-content: center;
    gap: 0.2rem;
    color: var(--c-mute);
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
    transition: color var(--dur-fast) ease;
  }

  .tb-tab::before {
    /* the livery stripe over the current tab */
    content: '';
    position: absolute;
    top: -1px;
    left: 22%;
    right: 22%;
    height: 3px;
    border-radius: 0 0 3px 3px;
    background: var(--g-livery);
    transform: scaleX(0);
    transition: transform var(--dur-med) var(--ease-out-expo);
  }

  .tb-icon {
    width: 1.45rem;
    height: 1.45rem;
    transition: transform var(--dur-med) var(--ease-out-back);
  }

  .tb-label {
    font-size: 0.56rem;
    letter-spacing: 0.08em;
  }

  .tb-tab:hover,
  .tb-tab:focus-visible {
    color: var(--c-chalk);
  }

  .tb-tab[aria-current] {
    color: var(--c-gold);
  }

  .tb-tab[aria-current]::before {
    transform: none;
  }

  .tb-tab:active .tb-icon {
    transform: scale(0.86);
  }

  .tb-tab:focus-visible {
    outline-offset: -4px;
  }
</style>
