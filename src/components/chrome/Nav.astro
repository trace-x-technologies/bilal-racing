---
/**
 * Fixed top bar: brand (egg hook), section links with a sliding active chip,
 * sound toggle, scroll-progress "lap meter", and a full-screen pit-lane menu
 * (<dialog>) on small screens.
 *
 * `base` prefixes the in-page anchors, so other pages (404) can link home: base="/".
 */
import Emblem from '@/components/ui/Emblem.astro';
import SoundToggle from './SoundToggle.astro';
import { drivers, owner } from '@/data/lore';

interface Props {
  base?: string;
}
const { base = '' } = Astro.props;

// Brand chip shows the two race numbers ("#13 · #17"). The cat on the pit wall doesn't race.
const carNumbers = drivers.map((d) => `#${d.number}`);

const links = [
  { id: 'driver', label: 'Line-up', sub: `${carNumbers.join(' & ')}. The boss is a cat.` },
  { id: 'career', label: 'Career', sub: 'Nine lives, abridged' },
  { id: 'car', label: 'Car', sub: 'The BR-09, in pieces' },
  { id: 'crew', label: 'Crew', sub: 'Pit wall, pit crew, tuna' },
  { id: 'paddock', label: 'Paddock', sub: 'Photos. Evidence.' },
  { id: 'calendar', label: 'Calendar', sub: 'Races & nap windows' },
  { id: 'lights-out', label: 'Lights Out', sub: 'Out-pounce the whole grid' },
  { id: 'radio', label: 'Radio', sub: `${owner.callsign} has the mic. Plan B: fish.` },
  // `extra`: the desktop bar only shows these once Saira has loaded (see `nav-fonts`):
  // in the wider fallback face ten links don't fit. The pit-lane menu always lists all ten.
  { id: 'sponsors', label: 'Partners', sub: 'Imaginary. Grateful.', extra: true },
  { id: 'tech', label: 'Tech regs', sub: 'The rulebook', extra: true },
];
const pad = (n: number) => String(n).padStart(2, '0');
---

<a class="skip-link t-mono" href="#main" data-skip-link>Skip to the race</a>

<div class="lap-meter" aria-hidden="true">
  <span class="lap-meter-bar" data-progress></span>
</div>

<header class="nav" data-nav data-scrolled="false" data-hidden="false">
  <div class="nav-glass" aria-hidden="true"></div>
  <div class="nav-inner">
    <a class="brand" href={`${base}#top`} data-egg="emblem" aria-label="Bilal Racing, back to the top">
      <span class="brand-mark" aria-hidden="true">
        <Emblem size="100%" title="" />
      </span>
      <span class="brand-word t-condensed" aria-hidden="true">
        <span class="brand-bilal">Bilal</span><span class="brand-racing">Racing</span>
      </span>
      <span class="brand-code t-mono" aria-hidden="true">{carNumbers.join(' · ')}</span>
    </a>

    <nav class="nav-main" aria-label="Sections">
      <ul class="nav-links" data-nav-list>
        {
          links.map((link, i) => (
            <li class:list={[{ 'nav-item--extra': link.extra }]}>
              <a class="nav-link" href={`${base}#${link.id}`} data-nav-link={link.id}>
                <span class="nav-idx t-mono" aria-hidden="true">{pad(i + 1)}</span>
                <span class="nav-roll">
                  <span class="nav-roll-in">
                    {link.label}<span class="nav-roll-dup" aria-hidden="true">{link.label}</span>
                  </span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
      <span class="nav-chip" data-nav-chip aria-hidden="true"></span>
    </nav>

    <div class="nav-tools">
      <SoundToggle />
      <button
        type="button"
        class="burger"
        data-burger
        aria-haspopup="dialog"
        aria-expanded="false"
        aria-controls="pit-menu"
      >
        <span class="burger-label t-mono">Menu</span>
        <span class="burger-lines" aria-hidden="true"><i></i><i></i><i></i></span>
      </button>
    </div>
  </div>
</header>

{
  /*
   * tabindex="-1": when the menu overflows, Chrome would otherwise make the dialog (a scroller)
   * a Tab stop of its own, with a ring clipped away by its clip-path. Every link scrolls into
   * view on focus, so the scroller doesn't need a stop.
   */
}
<dialog
  class="menu"
  id="pit-menu"
  aria-labelledby="pit-menu-title"
  tabindex="-1"
  data-menu
  data-lenis-prevent
>
  <div class="menu-bg" aria-hidden="true"></div>
  <div class="menu-inner">
    <div class="menu-top">
      <p class="menu-title t-mono" id="pit-menu-title">
        <span class="menu-dot" aria-hidden="true"></span> Pit lane<span class="menu-title-extra"> · 80 km/h</span>
      </p>
      <button type="button" class="menu-close t-mono" data-menu-close>
        Back on track <span aria-hidden="true">✕</span>
      </button>
    </div>
    <nav aria-label="Sections (menu)">
      <ol class="menu-links">
        {
          links.map((link, i) => (
            <li style={`--i:${i}`}>
              <a class="menu-link" href={`${base}#${link.id}`} data-menu-link={link.id}>
                <span class="menu-idx t-mono" aria-hidden="true">{pad(i + 1)}</span>
                <span class="menu-label t-condensed">{link.label}</span>
                <span class="menu-sub t-mono">{link.sub}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </nav>
    <p class="menu-foot">
      <span>Pick a section,</span>
      <span class="t-si" lang="si">ඉක්මනට</span>
      <span class="t-mute">(quickly!)</span>
    </p>
  </div>
</dialog>

<style>
  /* ============ Skip link ============ */
  .skip-link {
    position: fixed;
    top: var(--space-3);
    left: var(--space-3);
    z-index: calc(var(--z-loader) + 1);
    padding: var(--space-3) var(--space-4);
    background: var(--c-gold);
    color: var(--c-on-gold);
    text-decoration: none;
    border-radius: var(--radius-s);
    transform: translateY(-200%);
    transition: transform var(--dur-fast) var(--ease-out-expo);
  }

  .skip-link:focus-visible {
    transform: none;
  }

  /* ============ Lap meter (scroll progress) ============ */
  .lap-meter {
    position: fixed;
    inset: 0 0 auto;
    height: 3px;
    z-index: calc(var(--z-nav) + 1);
    pointer-events: none;
  }

  .lap-meter-bar {
    position: absolute;
    inset: 0;
    background: var(--g-livery);
    transform-origin: 0 50%;
    transform: scaleX(var(--p, 0));
    box-shadow: 0 0 12px rgb(255 106 19 / 0.6);
  }

  /*
   * The timeline lives in its own, more specific rule: the minifier otherwise folds
   * it into the `animation` shorthand, which browsers reject (dropping the rule).
   */
  @supports (animation-timeline: scroll()) {
    .lap-meter-bar {
      transform: scaleX(0);
      animation: lap-meter linear both;
    }

    .lap-meter > .lap-meter-bar {
      animation-timeline: scroll(root block);
    }
  }

  @keyframes lap-meter {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }

  /* ============ Bar ============ */
  .nav {
    --nav-ink: var(--c-chalk);
    position: fixed;
    inset: 0 0 auto;
    height: var(--nav-h);
    z-index: var(--z-nav);
    transition: transform var(--dur-med) var(--ease-out-expo);
  }

  .nav[data-hidden='true']:not(:focus-within) {
    transform: translateY(calc(-100% - 4px));
  }

  .nav.is-waiting {
    transform: translateY(calc(-100% - 4px));
    transition: none;
  }

  .nav-glass {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to bottom, rgb(7 7 11 / 0.9), rgb(7 7 11 / 0.82)),
      radial-gradient(60% 140% at 0% 0%, rgb(255 197 46 / 0.08), transparent 60%);
    -webkit-backdrop-filter: blur(16px) saturate(170%);
    backdrop-filter: blur(16px) saturate(170%);
    border-bottom: 1px solid var(--c-line);
    box-shadow: 0 10px 30px -18px rgb(0 0 0 / 0.8);
    opacity: 0;
    transition: opacity var(--dur-med) ease;
  }

  /* Over the hero: a soft top shade keeps links legible without a hard bar. */
  .nav::before {
    content: '';
    position: absolute;
    inset: 0 0 -60%;
    background: linear-gradient(to bottom, rgb(7 7 11 / 0.55), transparent);
    pointer-events: none;
    transition: opacity var(--dur-med) ease;
  }

  .nav[data-scrolled='true'] .nav-glass {
    opacity: 1;
  }

  .nav[data-scrolled='true']::before {
    opacity: 0;
  }

  .nav-inner {
    position: relative;
    height: 100%;
    width: min(100% - 2 * var(--gutter), var(--maxw));
    margin-inline: auto;
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  /* ============ Brand ============ */
  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    text-decoration: none;
    color: var(--nav-ink);
    flex: none;
    -webkit-tap-highlight-color: transparent;
  }

  .brand-mark {
    display: block;
    width: 2.25rem;
    height: 2.25rem;
    transition: transform var(--dur-med) var(--ease-out-back);
  }

  .brand:hover .brand-mark {
    transform: rotate(-10deg) scale(1.08);
  }

  .brand:active .brand-mark {
    transform: scale(0.9);
    transition-duration: 80ms;
  }

  .brand-word {
    display: flex;
    flex-direction: column;
    line-height: 0.82;
    text-transform: uppercase;
    font-weight: 850;
    letter-spacing: 0.02em;
  }

  .brand-bilal {
    font-size: 1.28rem;
  }

  .brand-racing {
    font-size: 0.8rem;
    letter-spacing: 0.32em;
    color: var(--c-gold);
    font-weight: 700;
  }

  .brand-code {
    display: none;
    padding: 0.2em 0.55em;
    border: 1px solid var(--c-line-strong);
    border-radius: var(--radius-s);
    color: var(--c-mute);
    font-size: 0.62rem;
    transform: skewX(var(--skew));
  }

  @media (min-width: 30em) {
    .brand-code {
      display: inline-block;
    }
  }

  /* Links + sound toggle get tight just above the burger breakpoint. */
  @media (min-width: 75em) and (max-width: 89.99em) {
    .brand-code {
      display: none;
    }
  }

  /* ============ Links (desktop) ============ */
  /*
   * Brand and tools never shrink; the links do (min-width: 0) and clip sideways, so a
   * wide fallback font can never push the sound toggle out of the viewport. The padding
   * keeps the chip's glow inside the clip and replaces .nav-inner's gap, so nothing moves.
   */
  .nav-main {
    display: none;
    position: relative;
    margin-inline: auto;
    padding-inline: var(--space-4);
    min-width: 0;
    overflow-x: clip;
  }

  .nav-links {
    list-style: none;
    padding: 0;
    display: flex;
    align-items: center;
    gap: 0.125rem;
  }

  /*
   * 09-10 join the bar once Saira is ready (Nav script adds html.nav-fonts). The fallback
   * face is ~17% wider: ten links would overflow, eight fit.
   */
  :global(html:not(.nav-fonts)) .nav-item--extra {
    display: none;
  }

  .nav-link {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: baseline;
    gap: 0.35em;
    padding: 0.5rem 0.7rem;
    color: var(--c-mute);
    text-decoration: none;
    font-weight: 700;
    font-size: 0.98rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-variation-settings: 'wdth' 78;
    white-space: nowrap;
    transition: color var(--dur-fast) ease;
  }

  /* 1200-1359px: all ten links still fit on one row with a little less air. */
  @media (min-width: 75em) and (max-width: 84.99em) {
    .nav-link {
      padding-inline: 0.4rem;
      font-size: 0.9rem;
    }
  }

  .nav-idx {
    font-size: 0.58rem;
    letter-spacing: 0.08em;
    color: var(--c-faint);
    transition: color var(--dur-fast) ease;
  }

  .nav-roll {
    position: relative;
    display: inline-block;
    overflow: hidden;
    line-height: 1.25;
    vertical-align: bottom;
  }

  .nav-roll-in {
    position: relative;
    display: block;
  }

  .nav-roll-dup {
    position: absolute;
    inset: 100% 0 auto;
    color: var(--c-gold);
  }

  :global(.js-motion) .nav-roll-in {
    transition: transform var(--dur-med) var(--ease-out-expo);
  }

  .nav-link:hover,
  .nav-link:focus-visible,
  .nav-link[aria-current] {
    color: var(--c-chalk);
  }

  .nav-link:hover .nav-idx,
  .nav-link[aria-current] .nav-idx {
    color: var(--c-gold);
  }

  @media (hover: hover) {
    :global(.js-motion) .nav-link:hover .nav-roll-in {
      transform: translateY(-100%);
    }
  }

  .nav-chip {
    position: absolute;
    left: 0;
    top: 50%;
    height: 2.1rem;
    width: var(--w, 0px);
    transform: translate3d(var(--x, 0px), -50%, 0) skewX(var(--skew));
    border-radius: var(--radius-s);
    background: color-mix(in oklab, var(--c-gold) 12%, transparent);
    border: 1px solid color-mix(in oklab, var(--c-gold) 45%, transparent);
    box-shadow: inset 0 -2px 0 var(--c-gold), 0 0 24px -8px rgb(255 197 46 / 0.6);
    opacity: 0;
    pointer-events: none;
    transition:
      transform var(--dur-med) var(--ease-out-expo),
      width var(--dur-med) var(--ease-out-expo),
      opacity var(--dur-fast) ease;
  }

  .nav-chip.is-on {
    opacity: 1;
  }

  .nav-chip.no-anim {
    transition: opacity var(--dur-fast) ease;
  }

  /* ============ Tools ============ */
  .nav-tools {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex: none;
  }

  .burger {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 2.75rem;
    padding: 0 var(--space-3);
    border-radius: 999px;
    border: 1px solid var(--c-line-strong);
    background: rgb(16 16 23 / 0.6);
    color: var(--c-chalk);
    transition:
      border-color var(--dur-fast) ease,
      background-color var(--dur-fast) ease;
  }

  .burger:hover {
    border-color: var(--c-gold);
  }

  .burger-label {
    font-size: 0.66rem;
  }

  .burger-lines {
    display: grid;
    gap: 4px;
    width: 1.2rem;
  }

  /* Whiskers, obviously. */
  .burger-lines i {
    display: block;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
    transform-origin: 100% 50%;
    transition: transform var(--dur-med) var(--ease-out-back);
  }

  .burger-lines i:nth-child(1) {
    transform: rotate(-9deg);
  }

  .burger-lines i:nth-child(3) {
    transform: rotate(9deg);
  }

  .burger:hover .burger-lines i:nth-child(1) {
    transform: rotate(-16deg) scaleX(1.1);
  }

  .burger:hover .burger-lines i:nth-child(3) {
    transform: rotate(16deg) scaleX(1.1);
  }

  @media (min-width: 75em) {
    /* .nav-main's inline padding stands in for the gap on either side of it. */
    .nav-inner {
      column-gap: 0;
    }

    .nav-main {
      display: block;
    }

    .burger {
      display: none;
    }

    .nav-tools {
      margin-left: 0;
    }
  }

  /* ============ Pit-lane menu (dialog) ============ */
  .menu {
    --ox: calc(100% - 3rem);
    --oy: 2rem;
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--c-carbon);
    color: var(--c-chalk);
    overflow: hidden auto;
    overscroll-behavior: contain;
    clip-path: circle(0% at var(--ox) var(--oy));
    transition:
      clip-path 700ms var(--ease-out-expo),
      display 700ms allow-discrete,
      overlay 700ms allow-discrete;
  }

  .menu[open] {
    clip-path: circle(150% at var(--ox) var(--oy));
  }

  @starting-style {
    .menu[open] {
      clip-path: circle(0% at var(--ox) var(--oy));
    }
  }

  .menu::backdrop {
    background: transparent;
  }

  .menu-bg {
    position: fixed;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(80% 50% at 100% 0%, rgb(160 21 62 / 0.45), transparent 70%),
      radial-gradient(70% 45% at 0% 100%, rgb(255 197 46 / 0.12), transparent 70%),
      repeating-linear-gradient(-64deg, rgb(255 255 255 / 0.025) 0 2px, transparent 2px 22px);
  }

  .menu-inner {
    position: relative;
    min-height: 100%;
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: var(--space-5);
    padding: var(--space-4) var(--gutter) max(var(--space-6), env(safe-area-inset-bottom));
  }

  .menu-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: calc(var(--nav-h) - var(--space-4));
  }

  .menu-title {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--c-mute);
    white-space: nowrap;
  }

  @media (max-width: 26em) {
    .menu-title-extra {
      display: none;
    }
  }

  .menu-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--c-red);
    box-shadow: var(--glow-red);
  }

  .menu-close {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 2.75rem;
    padding: 0 var(--space-4);
    border: 1px solid var(--c-line-strong);
    border-radius: 999px;
    color: var(--c-chalk);
    white-space: nowrap;
  }

  .menu-close:hover {
    border-color: var(--c-gold);
    color: var(--c-gold);
  }

  .menu-links {
    list-style: none;
    padding: 0;
    align-self: center;
    display: grid;
    gap: clamp(0.1rem, 0.6vh, 0.6rem);
    counter-reset: none;
  }

  .menu-link {
    display: grid;
    grid-template-columns: 2.2rem 1fr;
    grid-template-rows: auto auto;
    column-gap: var(--space-3);
    align-items: baseline;
    padding-block: 0.15rem;
    text-decoration: none;
    color: var(--c-chalk);
  }

  .menu-idx {
    grid-row: 1 / 3;
    color: var(--c-gold);
    align-self: start;
    padding-top: 0.6em;
  }

  .menu-label {
    font-size: clamp(2.3rem, 1.2rem + 6.2vw, 4.75rem);
    font-weight: 850;
    text-transform: uppercase;
    line-height: 0.88;
    transition:
      color var(--dur-fast) ease,
      transform var(--dur-med) var(--ease-out-expo);
  }

  .menu-sub {
    grid-column: 2;
    color: var(--c-mute);
    font-size: 0.62rem;
    margin-top: 0.15rem;
  }

  .menu-link[aria-current] .menu-label {
    color: var(--c-gold);
  }

  .menu-link[aria-current] .menu-sub::after {
    content: ' · you are here';
    color: var(--c-gold);
  }

  .menu-link:hover .menu-label,
  .menu-link:focus-visible .menu-label {
    color: var(--c-gold);
    transform: translateX(0.4rem) skewX(var(--skew));
  }

  .menu-links li {
    transition:
      opacity 500ms var(--ease-out-expo),
      transform 700ms var(--ease-out-expo);
    transition-delay: calc(120ms + var(--i) * 45ms);
  }

  .menu:not([open]) .menu-links li {
    opacity: 0;
    transform: translateY(1.5rem);
    transition-delay: 0ms;
  }

  @starting-style {
    .menu[open] .menu-links li {
      opacity: 0;
      transform: translate3d(-0.5rem, 2.5rem, 0) skewX(-6deg);
    }
  }

  .menu-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4em;
    color: var(--c-chalk);
    font-size: var(--fs-small);
  }

  .menu-foot .t-si {
    color: var(--c-gold);
    font-size: 1.1rem;
  }
</style>

<script>
  import { focusTarget, lockScroll } from '@/scripts/motion';
  import { whenReady } from '@/scripts/bus';

  const nav = document.querySelector<HTMLElement>('[data-nav]');
  const menu = document.querySelector<HTMLDialogElement>('[data-menu]');
  const burger = document.querySelector<HTMLButtonElement>('[data-burger]');

  /* ---------- Entrance: slide in when the lights go out (only if an intro is playing) ---------- */
  const introPending =
    document.querySelector('[data-loader]') !== null && document.documentElement.dataset.intro !== 'skip';
  if (nav && introPending && document.documentElement.dataset.ready !== 'true') {
    nav.classList.add('is-waiting');
    whenReady(() => {
      // Force a frame so the transition runs from the hidden state.
      requestAnimationFrame(() => {
        nav.classList.remove('is-waiting');
      });
    });
  }

  /* ---------- Glass on scroll, hide on scroll-down / show on scroll-up ---------- */
  const progress = document.querySelector<HTMLElement>('[data-progress]');
  const cssProgress = CSS.supports?.('animation-timeline: scroll()') ?? false;
  let lastY = window.scrollY;
  let ticking = false;
  let menuOpen = false;

  function updateBar(): void {
    ticking = false;
    const y = Math.max(0, window.scrollY);
    if (nav) {
      const threshold = Math.min(window.innerHeight * 0.35, 280);
      nav.dataset.scrolled = String(y > 24);
      const delta = y - lastY;
      if (menuOpen || y < threshold) {
        nav.dataset.hidden = 'false';
      } else if (delta > 6) {
        nav.dataset.hidden = 'true';
      } else if (delta < -6) {
        nav.dataset.hidden = 'false';
      }
    }
    if (!cssProgress && progress) {
      const max = document.documentElement.scrollHeight - window.innerHeight;
      progress.style.setProperty('--p', String(max > 0 ? Math.min(1, y / max) : 0));
    }
    lastY = y;
  }

  window.addEventListener(
    'scroll',
    () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(updateBar);
      }
    },
    { passive: true },
  );
  updateBar();

  /* ---------- Active section chip ---------- */
  const list = document.querySelector<HTMLElement>('[data-nav-list]');
  const chip = document.querySelector<HTMLElement>('[data-nav-chip]');
  const navLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]'));
  const sections = navLinks
    .map((a) => document.getElementById(a.dataset.navLink ?? ''))
    .filter((el): el is HTMLElement => Boolean(el));
  const visible = new Set<string>();
  let activeId = '';

  function placeChip(animate = true): void {
    if (!chip || !list) return;
    const link = navLinks.find((a) => a.dataset.navLink === activeId);
    if (!link || link.offsetParent === null) {
      chip.classList.remove('is-on');
      return;
    }
    chip.classList.toggle('no-anim', !animate || !chip.classList.contains('is-on'));
    chip.style.setProperty('--x', `${link.offsetLeft}px`);
    chip.style.setProperty('--w', `${link.offsetWidth}px`);
    chip.classList.add('is-on');
  }

  function setActive(id: string): void {
    if (id === activeId) return;
    activeId = id;
    for (const a of navLinks) {
      if (a.dataset.navLink === id) a.setAttribute('aria-current', 'location');
      else a.removeAttribute('aria-current');
    }
    document.querySelectorAll<HTMLAnchorElement>('[data-menu-link]').forEach((a) => {
      if (a.dataset.menuLink === id) a.setAttribute('aria-current', 'location');
      else a.removeAttribute('aria-current');
    });
    placeChip(true);
  }

  if (sections.length && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const id = (entry.target as HTMLElement).id;
          if (entry.isIntersecting) visible.add(id);
          else visible.delete(id);
        }
        // Last section (in document order) that crosses the reading line wins.
        let next = '';
        for (const s of sections) if (visible.has(s.id)) next = s.id;
        setActive(next);
      },
      { rootMargin: '-38% 0px -60% 0px', threshold: 0 },
    );
    sections.forEach((s) => io.observe(s));

    let resizeRaf = 0;
    window.addEventListener('resize', () => {
      cancelAnimationFrame(resizeRaf);
      resizeRaf = requestAnimationFrame(() => placeChip(false));
    });
    document.fonts?.ready.then(() => placeChip(false));
  }

  /* ---------- 09-10 join the desktop bar once the display face is in ---------- */
  const SAIRA = '600 1em "Saira Variable"';
  const fontsReady = () => {
    document.documentElement.classList.add('nav-fonts');
    requestAnimationFrame(() => placeChip(false));
  };
  const fonts = document.fonts;
  if (!fonts || fonts.check(SAIRA)) {
    fontsReady();
  } else {
    // A blocked or failed webfont leaves the bar at eight links (the menu and footer have all ten).
    fonts
      .load(SAIRA)
      .then((faces) => {
        if (faces.length && faces.every((f) => f.status === 'loaded')) fontsReady();
      })
      .catch(() => {});
  }

  /* ---------- Keyboard users: move focus with the scroll ---------- */
  // Shared helper: the temporary tabindex="-1" is dropped again on blur.
  function focusHash(hash: string | null): void {
    if (!hash || !hash.startsWith('#') || hash.length < 2) return;
    const target = document.querySelector<HTMLElement>(hash);
    if (target) focusTarget(target);
  }

  document.querySelector<HTMLAnchorElement>('[data-skip-link]')?.addEventListener('click', (e) => {
    focusHash((e.currentTarget as HTMLAnchorElement).getAttribute('href'));
  });

  navLinks.forEach((a) =>
    a.addEventListener('click', (e) => {
      // detail === 0 → activated from the keyboard, not a pointer.
      if (e.detail === 0) focusHash(a.getAttribute('href'));
    }),
  );

  /* ---------- Pit-lane menu ---------- */
  if (menu && burger) {
    let closingForLink = false;

    const open = () => {
      const r = burger.getBoundingClientRect();
      menu.style.setProperty('--ox', `${r.left + r.width / 2}px`);
      menu.style.setProperty('--oy', `${r.top + r.height / 2}px`);
      menuOpen = true;
      lockScroll(true);
      menu.showModal();
      burger.setAttribute('aria-expanded', 'true');
    };

    burger.addEventListener('click', open);
    menu.querySelector('[data-menu-close]')?.addEventListener('click', () => menu.close());

    menu.addEventListener('close', () => {
      menuOpen = false;
      burger.setAttribute('aria-expanded', 'false');
      lockScroll(false);
      if (!closingForLink) burger.focus({ preventScroll: true });
      closingForLink = false;
    });

    // Click on the dim area outside the list closes too.
    menu.addEventListener('click', (e) => {
      if (e.target === menu) menu.close();
    });

    menu.querySelectorAll<HTMLAnchorElement>('[data-menu-link]').forEach((a) => {
      a.addEventListener('click', () => {
        // Close + unlock first so the shared anchor handler can scroll.
        closingForLink = true;
        menu.close();
        lockScroll(false);
        const href = a.getAttribute('href') ?? '';
        if (href.startsWith('#')) requestAnimationFrame(() => focusHash(href));
      });
    });

    // Switching to desktop width with the menu open: close it.
    const wide = window.matchMedia('(min-width: 75em)');
    wide.addEventListener('change', (e) => {
      if (e.matches && menu.open) menu.close();
    });
  }
</script>
