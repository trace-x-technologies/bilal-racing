---
/**
 * Global overlays & easter eggs (rendered once, last thing in <body>).
 *
 *  - Race-control toasts: emit('bilal:toast', { message, tone }) from anywhere.
 *  - Egg tracker: emit('bilal:egg', { id, label }) → "Easter egg 3/6 found".
 *  - Lazy (after idle): paw-print cursor trail, Konami / nine-lives ZOOMIES MODE,
 *    typed "meow" / "box", "l" laser pointer, 60 s idle nap, console greeting.
 *
 * All art is inline SVG, hidden until used; every decorative layer is aria-hidden.
 */
import { driver, stats, team } from '@/data/lore';

const topSpeed = stats.find((s) => s.label === 'Top speed')?.value ?? 312;
const carCode = team.car.split(' ')[0];

// Deterministic speed-line field so SSR output is stable between builds.
const streaks = Array.from({ length: 22 }, (_, i) => {
  const r = (n: number) => {
    const x = Math.sin((i + 1) * 12.9898 + n * 78.233) * 43758.5453;
    return x - Math.floor(x);
  };
  return {
    y: (2 + r(1) * 96).toFixed(1),
    x: Math.round(r(8) * 90),
    w: (5 + r(2) * 16).toFixed(1),
    d: Math.round(380 + r(3) * 560),
    dl: -Math.round(r(4) * 900),
    o: (0.3 + r(5) * 0.65).toFixed(2),
    h: r(6) > 0.8 ? 3 : r(6) > 0.35 ? 2 : 1,
    hot: r(7) > 0.68,
  };
});
---

<div class="eggs" data-eggs>
  <!-- ============ ZOOMIES overlay ============ -->
  <div class="zl" data-zl aria-hidden="true">
    <div class="zl-vignette"></div>
    <div class="zl-leds">{Array.from({ length: 15 }, (_, i) => <i style={`--i:${i}`} />)}</div>
    <div class="zl-streaks">
      {
        streaks.map((s) => (
          <i
            class:list={[s.hot && 'hot']}
            style={`--y:${s.y}%;--x:${s.x};--w:${s.w}rem;--d:${s.d}ms;--dl:${s.dl}ms;--o:${s.o};--h:${s.h}px`}
          />
        ))
      }
    </div>
    <p class="zl-word" data-zl-word>
      <span>Zoomies</span>
      <small>Mode engaged · {topSpeed} km/h · lap record pending</small>
    </p>
    <div class="zl-cat" data-zl-cat>
      <div class="zl-bob">
