{
  // The Worker runs on workerd, not in a browser: its own lib + generated runtime types.
  // `npm run check` regenerates worker-configuration.d.ts (gitignored) before type-checking.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "types": [],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["./**/*.ts", "../src/data/crew.ts"]
}
