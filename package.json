{
  "name": "bilal-racing",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check && npm run check:worker",
    "check:worker": "wrangler types worker/worker-configuration.d.ts && tsc -p worker/tsconfig.json",
    "voices": "node --experimental-strip-types tools/radio-voices.mjs",
    "preview:cf": "astro build && wrangler dev",
    "cf:whoami": "wrangler whoami",
    "deploy:dry": "npm run check && astro build && wrangler deploy --dry-run",
    "deploy": "npm run check && astro build && wrangler deploy"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/noto-sans-sinhala": "^5.3.0",
    "@fontsource-variable/saira": "^5.3.0",
    "astro": "^7.3.4",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/three": "^0.186.0",
    "playwright-core": "1.56",
    "sharp": "^0.35.4",
    "typescript": "^5.9.3",
    "wrangler": "^4.144.0"
  }
}
